pkgname=activity-log-manager
pkgver=0.9.7
pkgrel=11
pkgdesc='A graphical user interface which lets you easily control what gets logged by Zeitgeist'
arch=(x86_64)
url='https://launchpad.net/activity-log-manager'
license=(LGPL-2.0-or-later)
depends=(
  cairo
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  hicolor-icon-theme
  libgee
  pango
  zeitgeist
)
makedepends=(
  intltool
  vala
)
source=(
  "https://launchpad.net/$pkgname/${pkgver%.*}/$pkgver/+download/$pkgname-$pkgver.tar.xz"{,.asc}
  fix-build.patch
  fix-build-2.patch
  gee-0.8.patch
  window-icon.patch
  activity-log-manager.appdata.xml
)
b2sums=(
