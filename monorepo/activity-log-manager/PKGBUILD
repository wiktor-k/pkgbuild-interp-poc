validpgpkeys=(EEE420E481E68B71594F192D361CC5EBA0BA909F) # Manish Sinha

prepare() {
  cd $pkgname-$pkgver

  # Fix build
  patch -Np1 -i ../fix-build.patch
  patch -Np1 -i ../fix-build-2.patch

  # Port to gee-0.8
  patch -Np1 -i ../gee-0.8.patch

  # Set window icon; raise existing window on activation; fix icon size on app list
  patch -Np1 -i ../window-icon.patch

  # Regenerate C files
  rm src/*.stamp

  autoreconf -fiv
}

build() {
  cd $pkgname-$pkgver
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd $pkgname-$pkgver
  make DESTDIR="$pkgdir" install
  install -Dm644 ../$pkgname.appdata.xml "$pkgdir/usr/share/metainfo/$pkgname.appdata.xml"
}
