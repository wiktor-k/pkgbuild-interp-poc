# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Arch Haskell Team <arch-haskell@haskell.org>

_hkgname=Agda
pkgname=agda
# Remember to also update agda-stdlib, which has a versioned dependency on agda.
pkgver=2.8.0.2
pkgrel=29
pkgdesc="A dependently typed functional programming language and proof assistant"
url="https://wiki.portal.chalmers.se/agda/"
license=("custom")
arch=('x86_64')
depends=('ghc-libs' 'haskell-aeson' 'haskell-ansi-terminal' 'haskell-async' 'haskell-blaze-html'
         'haskell-boxes' 'haskell-case-insensitive' 'haskell-data-hash' 'haskell-dlist'
         'haskell-edit-distance' 'haskell-enummapset' 'haskell-equivalence' 'haskell-filelock'
         'haskell-filemanip' 'haskell-generic-data' 'haskell-hashable' 'haskell-monad-control'
         'haskell-murmur-hash' 'haskell-nonempty-containers' 'haskell-parallel' 'haskell-peano'
         'haskell-pqueue' 'haskell-process-extras' 'haskell-regex-tdfa' 'haskell-split'
         'haskell-stmonadtrans' 'haskell-strict' 'haskell-unordered-containers' 'haskell-uri-encode'
         'haskell-vector' 'haskell-vector-hashtables' 'haskell-zlib' 'haskell-text-icu')
optdepends=('agda-stdlib: for standard library')
makedepends=('ghc' 'alex' 'happy' 'uusi')
source=("https://hackage.haskell.org/packages/archive/$_hkgname/$pkgver/$_hkgname-$pkgver.tar.gz")
sha512sums=('bc8c83472d84c1e66ee43b904a853673a7d0f772a445361f33abfc8143d918adb17351853b6c39b788e344f299a6edc10df5578932268aa4411f795c40114aaf')

prepare() {
    cd $_hkgname-$pkgver
    gen-setup
    uusi -u nonempty-containers -u parallel -u pqueue
    sed -i '/fno-warn-overlapping-patterns/a \        , "-dynamic"' src/full/Agda/Compiler/MAlonzo/Compiler.hs
}

build() {
    cd $_hkgname-$pkgver

    # -fllvm is disabled because ghc+llc hangs since LLVM 13
    # https://gitlab.haskell.org/ghc/ghc/-/issues/20559
    runhaskell Setup configure -O --enable-shared --enable-debug-info --enable-executable-dynamic --disable-library-vanilla \
        --prefix=/usr --docdir=/usr/share/doc/$pkgname --datasubdir=$pkgname --enable-tests \
        --dynlibdir=/usr/lib --libsubdir=\$compiler/site-local/\$pkgid --ghc-option=-fasm \
            -f-debug -fenable-cluster-counting -foptimise-heavily
    LC_CTYPE=en_US.UTF-8 runhaskell Setup build $MAKEFLAGS
    runhaskell Setup register --gen-script
    runhaskell Setup unregister --gen-script
    sed -i -r -e "s|ghc-pkg.*update[^ ]* |&'--force' |" register.sh
    sed -i -r -e "s|ghc-pkg.*unregister[^ ]* |&'--force' |" unregister.sh
}

check() {
    cd $_hkgname-$pkgver
    runhaskell Setup test --show-details=direct
}

package() {
    cd $_hkgname-$pkgver

    install -Dm744 register.sh   "${pkgdir}/usr/share/haskell/register/${pkgname}.sh"
    install -Dm744 unregister.sh "${pkgdir}/usr/share/haskell/unregister/${pkgname}.sh"
    LD_LIBRARY_PATH="$PWD/dist/build" runhaskell Setup copy --destdir="${pkgdir}"

    # Pre-build the interface files of the bundled builtin library. Note that prim/ ships its own
    # agda-builtins.agda-lib, so Agda stores its interfaces in prim/_build/$pkgver/agda and would
    # otherwise try to create them in /usr on first use, which fails for unprivileged users. See
    # https://github.com/agda/agda/issues/8731 for details.
    (
        local _prim="$pkgdir/usr/share/agda/lib/prim"
        cd "$_prim"

        export Agda_datadir="$pkgdir/usr/share/agda"
        export AGDA_DIR="$srcdir/agda-dir"
        export LD_LIBRARY_PATH="$srcdir/$_hkgname-$pkgver/dist/build:$pkgdir/usr/lib"

        mkdir -p "$AGDA_DIR"
        find Agda -name '*.agda' -print0 | xargs -0 -n1 "$pkgdir/usr/bin/agda"

        [[ "$(find "$_prim" -name '*.agda' | wc -l)" -eq "$(find "$_prim/_build" -name '*.agdai' | wc -l)" ]]
    )

    install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
    rm -f "$pkgdir"/usr/share/doc/$pkgname/LICENSE
}
