pkgbase=algol68g
pkgname=(algol68g algol68g-doc)
pkgver=3.13.4
pkgrel=1
pkgdesc='Algol 68 compiler and interpreter'
arch=(x86_64)
_host='https://algol68genie.nl'
url="$_host/en/algol-68-genie/"
license=(GPL-3.0-or-later)
depends=(curl gsl mpfr plotutils)
optdepends=('postgresql-libs: for PostgreSQL support')
source=("$_host/$pkgbase-$pkgver.tar.gz"
        "$_host/learning-algol-68-genie.pdf")
sha256sums=('625746ccb08e6fbfea1f526400cf21068ab2af34f6b64756ccc20e37e4d2d4f8'
            'aa426dd7e60bf4ed01a5144d04b01f5e5db68e8eb3f961996d19f3c7ae23f249')
b2sums=('42401b17e685274804741441541834e9035e4dedd41df5d09343963e6ba0a693bb2b2f574f2a008a20ea4d9c6126099d162ff7af0da5524eb9a96edf9adfe54a'
        '53984e6addc94736340e7e7430012d530479604817e9367360555d2296645f008cdeedf79b12bbbbb1e52aa50d33f0e75c54b0f568f9b81fac03c92bc3f2da67')

build() {
  cd $pkgname-$pkgver
  ./configure --prefix=/usr
  make
}

package_algol68g() {
  make -C $pkgname-$pkgver DESTDIR="$pkgdir" docdir=/usr/share/doc/$pkgname install
}

package_algol68g-doc() {
  install -Dm644 learning-algol-68-genie.pdf "$pkgdir/usr/share/doc/algol68g/learning_algol.pdf"
}
