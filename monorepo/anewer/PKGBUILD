# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=anewer
pkgver=0.2.2
pkgrel=1
pkgdesc="Appends lines from stdin to a file if they don't already exist in the file"
url='https://github.com/ysf/anewer'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=(
  'glibc'
  'libgcc' 'libgcc_s.so'
)
makedepends=(
  'cargo'
)
source=(https://github.com/ysf/${pkgname}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz)
b2sums=('96606b7d6053afa223c045d23fdd0f6825505346703ddfa80dbfcb99f7b01628ac55ae057e2d864b881ea11983e9818626868ef0d5a5c0cb8cb20321acd840f4')

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target host-tuple
}

build() {
  cd ${pkgname}-${pkgver}
  cargo build --frozen --release
}

check() {
  cd ${pkgname}-${pkgver}
  cargo test --frozen
}

package() {
  cd ${pkgname}-${pkgver}
  install -Dm 755 -t "${pkgdir}/usr/bin" \
    target/release/anewer
}

