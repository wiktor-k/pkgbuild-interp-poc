prepare() {
  cd "$pkgname"

  # download dependencies
  npm install
}

build() {
  cd "$pkgname"

  npm run client
  npm ci --omit=dev
}

package() {
  # systemd integration
  install -vDm640 config.env "$pkgdir/etc/$pkgname.env"
  install -vDm644 systemd.service "$pkgdir/usr/lib/systemd/system/$pkgname.service"
  install -vDm644 sysusers.conf "$pkgdir/usr/lib/sysusers.d/$pkgname.conf"
  install -vDm644 tmpfiles.conf "$pkgdir/usr/lib/tmpfiles.d/$pkgname.conf"

  cd "$pkgname"

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" readme.md

  # application
  install -vDm644 -t "$pkgdir/usr/lib/$pkgname" ./*.json index.js
  find {client/dist,server,node_modules} -type f |
    xargs -I {} install -vDm644 {} "$pkgdir/usr/lib/$pkgname/"{}
}
