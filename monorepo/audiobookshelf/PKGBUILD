pkgname=audiobookshelf
pkgver=2.37.1
pkgrel=1
pkgdesc='Self-hosted audiobook and podcast server'
arch=(x86_64)
url='https://www.audiobookshelf.org/'
license=(GPL-3.0-only)
depends=(
  glibc
  libnusqlite3
  ffmpeg
  nodejs
)
makedepends=(
  git
  npm
)
backup=(etc/audiobookshelf.env)
source=(
  "$pkgname::git+https://github.com/advplyr/audiobookshelf#tag=v$pkgver"
  systemd.service
  sysusers.conf
  tmpfiles.conf
  config.env
)
