pkgname=bibtool
pkgver=2.68
pkgrel=7
pkgdesc='A tool for manipulating BibTeX files'
arch=(x86_64)
url='https://github.com/ge-ne/bibtool'
license=(
  GPL-2.0-or-later
  CC-BY-SA-3.0
  CC-PDM-1.0
  MIT
)
depends=(
  glibc
  texlive-bin
)
makedepends=(
  texlive-latex
  texlive-latexrecommended
)
