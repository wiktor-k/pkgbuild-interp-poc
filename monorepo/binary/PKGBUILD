# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=binary
pkgver=5.4
pkgrel=1
pkgdesc='Simple app to convert between different hexadecimal and binary numbers'
arch=(any)
url='https://apps.gnome.org/Binary/'
license=(GPL-3.0-or-later)
groups=(gnome-circle)
depends=(
  dconf
  glib2
  gtk4
  hicolor-icon-theme
  libadwaita
  python
  python-gobject
)
makedepends=(
  appstream
  blueprint-compiler
  git
  meson
)
source=("git+https://github.com/fizzyizzy05/binary.git#tag=$pkgver")
b2sums=(e8433e99b8bcc3c167d2061ea7990da7a409bef5ac4d05c9ee272259781303001a956a44aba27dc6d44f2c104b5d30d047c5693ee65e802d97798ac12a1a56be)

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  python -m compileall -d /usr/share "$pkgdir/usr/share"
  python -O -m compileall -d /usr/share "$pkgdir/usr/share"
}
