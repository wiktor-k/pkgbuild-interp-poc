build() {
  cd $pkgname

  #make PROBE_HOST=hosted
  mkdir build && cd build
  meson ..
  ninja 
}

package() {
  cd $pkgname

  install -Dm 755 build/blackmagic "$pkgdir"/usr/bin/blackmagic

  install -Dm 644 driver/99-blackmagic-uucp.rules -t "$pkgdir"/usr/lib/udev/rules.d/
}
