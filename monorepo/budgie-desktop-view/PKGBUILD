pkgname=budgie-desktop-view
pkgver=10.10.2
pkgrel=1
pkgdesc='Desktop icons implementation for the Budgie Desktop'
arch=(x86_64)
url='https://github.com/BuddiesOfBudgie/budgie-desktop-view'
license=(Apache-2.0)
groups=(budgie)
depends=(
	dconf
	gdk-pixbuf2
	glib2
	glibc
	gtk3
	gtk-layer-shell
	libxfce4windowing
)
makedepends=(
	git
	intltool
	meson
	vala
)
source=("git+https://github.com/BuddiesOfBudgie/budgie-desktop-view.git#tag=v$pkgver")
b2sums=('693a9fe30d05799edcaba542f3ce5e373c6a825ef33ec44d418fc40b05bbd865387856ecedf7747f68315cb9a899a352fe4346e68c473965adbeb6c3f024d156')
validpgpkeys=(
  96B4A0291094A86A2B7E3367DD672FE9A2BE5892
  0E0D97562A4EC8BD8E329DCDAA7A2325E04B609B # Joshua Strobl
)

build() {
	arch-meson $pkgname build
	meson compile -C build
}

package() {
	meson install -C build --destdir "$pkgdir"
}
