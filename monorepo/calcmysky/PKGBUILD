pkgname=calcmysky
pkgver=0.4.0
pkgrel=1
pkgdesc="Simulator of light scattering by planetary atmospheres"
arch=(x86_64)
url="https://github.com/10110111/CalcMySky"
license=(GPL-3.0-or-later)
depends=(glibc libgcc libstdc++ qt6-base)
makedepends=(cmake eigen git glm vulkan-headers)
source=(git+$url.git#tag=v$pkgver)
sha512sums=('7eaba7ac45d6e1feb4da2bef878706c5115b40ea2ab890629ff12acaf05cfd859f9b52ff56f23bc58a8a7f35fe0a552959361bb12c80eff90aa825d85b77e412')

build() {
  local cmake_options=(
    -B build
    -S CalcMySky
    -W no-dev
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CPM_LOCAL_PACKAGES_ONLY=ON
    -D QT_VERSION=6
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

check() {
  local ctest_flags=(
    --test-dir build
    --output-on-failure
    --parallel $(nproc)
  )
  ctest "${ctest_flags[@]}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -vDm 644 CalcMySky/COPYING -t "$pkgdir"/usr/share/licenses/$pkgname
}
