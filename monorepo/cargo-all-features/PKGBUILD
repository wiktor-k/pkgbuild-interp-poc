# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=cargo-all-features
pkgver=1.12.0
pkgrel=3
pkgdesc="A Cargo subcommand to build and test all feature flag combinations"
arch=(x86_64)
url="https://github.com/frewsxcv/cargo-all-features"
license=('Apache-2.0 OR MIT')
depends=(
  glibc
  libgcc
)
makedepends=(rust)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
sha512sums=('c60346ce1e49e017eb6c0d2189ad722e15eea7861539c78534e113cc9fb225ca894bdd739eb1da2dbcd741e8bf26af066cf0bf558af525760a4b1bc46e05501d')
b2sums=('53eee788fa3f54a79646025f3d9ccaf3a317d18ed43a3143fe90cf623c5b5e110a8a61f85482bea1b035d9db82f12cee4d4850265c5ddcf8f4ec919dfcb894dd')

prepare() {
  cd $pkgname-$pkgver
  cargo fetch --locked --target host-tuple
}

build() {
  cd $pkgname-$pkgver
  cargo build --frozen --release
}

check() {
  cd $pkgname-$pkgver
  cargo test --frozen
}

package() {
  cd $pkgname-$pkgver
  install -vDm 755 target/release/cargo-{{build-,check-,test-}all,all}-features -t "$pkgdir/usr/bin/"
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -vDm 644 LICENSE-{APACHE,MIT} -t "$pkgdir/usr/share/licenses/$pkgname/"
}
