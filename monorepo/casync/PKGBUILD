# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=casync
pkgver=2.r269.gb4b7e56
pkgrel=1
pkgdesc="Content-Addressable Data Synchronization Tool"
arch=(x86_64)
url="https://github.com/systemd/casync/"
license=(LGPL-2.1-or-later)
depends=(
  fuse
  glibc
  libgcc
  openssl
  zlib
)
makedepends=(
  acl
  curl
  fuse2
  git
  meson
  python-sphinx
  systemd
  xz
  zstd
)
checkdepends=(
  gzip
  nbd
  python
  rsync
)
# NOTE: we lock a recent commit because there has not been a release in a long
# time and the amount of patches to backport would be immense:
# https://github.com/systemd/casync/issues/99
# https://github.com/systemd/casync/issues/212
# https://github.com/systemd/casync/issues/253
_commit=b4b7e5606f785572b78a43626a27a45fe3df2fbd
source=($pkgname::git+$url#commit=$_commit)
sha512sums=('71efef09044544a1fa6e70057de3e00a3e01afcd195c5f15f6194dacdf08052ffd47d99f28a28d8fae492678ec277576e0631b20f65fa1f9e16985124c9c61d9')
b2sums=('c1e23159afdeabf0c87a811937c99bc4ae9a0ebacd7763cd664baa22545a38b3491759c943ec6bd2f9d7232aa033aa023df4cea76feea026d38dd2798d3f8020')

pkgver() {
  cd $pkgname
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/v//g;s/-/./g'
}

build() {
  arch-meson build $pkgname -Dselinux=false
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  depends+=(
    acl libacl.so
    curl libcurl.so
    systemd-libs libudev.so
    xz liblzma.so
    zstd libzstd.so
  )

  meson install -C build --destdir "$pkgdir"
}
