# Maintainer: George Rawlinson <grawlinson@archlinux.org>
# Contributor: Geoffrey Frogeye <geoffrey+aur@frogeye.fr>

pkgname=check-sieve
pkgver=1.0.1
pkgrel=1
pkgdesc='Syntax checker for Sieve scripts'
arch=(x86_64)
url='https://github.com/dburkart/check-sieve'
license=(MIT)
depends=(
  glibc
  libgcc
  libstdc++
)
makedepends=(git)
checkdepends=(python)
options=(!buildflags)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('269f97421e4b4c0b7d406418fffc6a0bca53d902f7ca496bd1f37719c656a1564c91db513e65f1bed9736c4e43eb974863219e629a428c6833f655d2b8e1d8fb')
b2sums=('a733aa8c650666dd22c55b95da3be311e7b6d6af9e4aecc60fa4d17c11a5a9d8dda874f19c50b5d06da2481a16592be1540f987da64f88959d5c1eda67fa5736')

prepare() {
  cd "$pkgname"

  # ensure LDFLAGS are passed to compiler
  sed \
    -i Makefile \
    -e '/\t$(CXX).*/s/$/ $(LDFLAGS)/'
}


build() {
  cd "$pkgname"

  export CFLAGS+=" -ffat-lto-objects"

  make
}

# https://github.com/dburkart/check-sieve/issues/66
#check() {
#  cd "$pkgname"
#
#  make test
#}

package() {
  cd "$pkgname"

  make INSTALL_PREFIX="$pkgdir/usr" install

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE

  # fix incorrect permissions on library
  chmod 644 "$pkgdir/usr/lib/libchecksieve.a"
}

