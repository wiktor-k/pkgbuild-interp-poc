# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=clairvoyant
pkgver=3.1.14
pkgrel=1
pkgdesc='Get psychic answers from this fortune teller'
arch=(x86_64)
url='https://apps.gnome.org/Clairvoyant/'
license=(GPL-3.0-or-later)
groups=(gnome-circle)
depends=(
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  libadwaita
)
makedepends=(
  appstream
  git
  meson
  vala
)
source=("git+https://github.com/cassidyjames/clairvoyant.git#tag=$pkgver")
b2sums=(0024d11968885f76e8fdeff1512217c4c231df6506abc52fb07e3263e952b09a085b399b7df91e3f2dbfe149eb0ecd267b7ddd803fdafed35da35695bcd0e5cd)

prepare() {
  cd $pkgname
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  ln -s com.cassidyjames.clairvoyant "$pkgdir/usr/bin/clairvoyant"
}
