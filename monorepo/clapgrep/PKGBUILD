# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=clapgrep
pkgver=26.09
pkgrel=1
pkgdesc='One app to search through all your files'
arch=(x86_64)
url='https://github.com/luleyleo/clapgrep'
license=(GPL-3.0-or-later)
depends=(
  cairo
  glib2
  glibc
  gtk4
  gtksourceview5
  hicolor-icon-theme
  libadwaita
  libgcc
  pango
  poppler-glib
)
makedepends=(
  appstream
  blueprint-compiler
  git
  meson
  rust
)
source=("git+https://github.com/luleyleo/clapgrep.git#tag=v$pkgver")
b2sums=(e75378f81474780dfe4a87b37b11c9f47bab87414cd8f797a24764116ae8dbd997ea907da3773dd1e5752c7d67c1bbab81b9e78f1f4ec0e1ca1dc2212a47b768)

prepare() {
  cd $pkgname

  CARGO_HOME="$srcdir/build/cargo-home" \
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  arch-meson $pkgname build

  CARGO_PROFILE_RELEASE_LTO=true \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
    CARGO_PROFILE_RELEASE_DEBUG=2 \
    CARGO_PROFILE_RELEASE_STRIP=false \
    meson compile -C build
}

check() {
  meson test -C build --print-errorlogs --no-rebuild --exclude cargo-test
}

package() {
  meson install -C build --destdir "$pkgdir" --no-rebuild
}
