pkgname=clonezilla
pkgver=5.19.7
pkgrel=1
pkgdesc="ncurses partition and disk imaging/cloning program"
arch=('x86_64')
url="https://clonezilla.org"
license=('GPL-2.0-only')
depends=(
        'drbl'
        'partclone'
        'ntfs-3g'
        'ntfsprogs'
        'partimage'
        'pigz'
        'sshfs'
        'parted'
        'gptfdisk'
        'dosfstools'
        'gzip'
        'bzip2'
        'pbzip2'
        'lbzip2'
        'lrzip'
        'xz'
        'pixz'
        'lzop'
        'python'
        'libtorrent-rasterbar'
        'ecryptfs-utils'
        'screen'
        'perl'
        'cifs-utils'
        'net-tools'
        'which'
        'jq'
)
makedepends=('git')
optdepends=('netcat')
backup=('etc/drbl/drbl-ocs.conf')
source=(
        "git+https://github.com/stevenshiau/clonezilla.git#tag=v${pkgver}"
        usrbin.patch
)
sha256sums=('f511de0d7df53f657113aa9ad4182bcfea50129ac7bf43f15fcf7558f28265e0'
            '9340f18b27a1b3b41c4935c5831f6503e4cadf333f03433769906da40a6e38e6')

prepare() {
  cd $pkgname

  patch -Np0 -i "$srcdir"/usrbin.patch
}

package() {
  cd $pkgname

  make DESTDIR="$pkgdir" install  
}
