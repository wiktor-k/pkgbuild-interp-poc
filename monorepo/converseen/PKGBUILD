pkgname=converseen
pkgver=0.15.2.9
pkgrel=2
pkgdesc="Batch image converter and resizer"
arch=('x86_64')
url="https://${pkgname}.fasterland.net"
license=('GPL-3.0-or-later')
depends=('glibc' 'hicolor-icon-theme' 'imagemagick' 'libgcc' 'libstdc++' 'qt6-base')
makedepends=('cmake' 'qt6-tools')
source=("https://downloads.sourceforge.net/${pkgname}/${pkgname}-${pkgver}.tar.bz2"
		"0001-Add-CMake-option-to-disable-update-checking.patch")
sha256sums=('80742bf467328436c92d3bdc9ce47a8c897e7afd501651899af34b0579b969cf'
			'0dda27e62ea98f03a8b30ac48ddf1af7fbff5503a5f206e235dd9bc97f764528')

prepare() {
	cd "${pkgname}-${pkgver}"

	# https://github.com/Faster3ck/Converseen/pull/266
	patch -Np1 -i "${srcdir}/0001-Add-CMake-option-to-disable-update-checking.patch"
}

build() {
	cmake -B build \
		-S "${pkgname}-${pkgver}" \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D USE_QT6=ON \
		-D DISABLE_CHECK_UPDATES=ON

	cmake --build build
}

package() {
	DESTDIR="${pkgdir}" cmake --install build
}
