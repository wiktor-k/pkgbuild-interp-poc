# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgbase=crunch64
pkgname=(
  crunch64
  python-crunch64
)
pkgver=0.6.2
pkgrel=1
pkgdesc='A library for handling common N64 compression formats'
arch=(x86_64)
url='https://github.com/decompals/crunch64'
license=(MIT)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  python-build
  python-installer
  python-maturin
)
source=("$pkgbase::git+$url#tag=$pkgver")
sha512sums=('d120adfbbde0986d2a52eab43b6b427273d7834d226fbb6edbb6ce775d9e7746a96eb25cc0b54cd838ad4fbec2d516177d4b86f962018608abf8cb468e3cdd5d')
b2sums=('964712ab5c70ea5dc47bb62536b36a271f284c660731836625b03f0bd2565e42ffe87bbd1da51c5cac4af323059cf7331cb02fe9b98795a6bb2ae3fc1ee939f2')

prepare() {
  cd "$pkgbase"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgbase"

  # cli/lib
  cargo build --frozen --release --all-features

  # wheel
  cd lib
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  # check rust code
  cargo test -F std

  # install to temporary directory
  python -m installer --destdir="$PWD/tmp_install" lib/dist/*.whl
  local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  export PYTHONPATH="$PWD/tmp_install$site_packages"

  # check python code
  python python_bindings/tests.py
}

package_crunch64() {
  cd "$pkgbase"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" target/release/crunch64

  # shared library
  install -vDm644 -t "$pkgdir/usr/lib" target/release/libcrunch64.so

  # headers
  install -vd "$pkgdir/usr/include"
  cp -vr c_bindings/include/* "$pkgdir/usr/include"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}

package_python-crunch64() {
  pkgdesc+=' - Python bindings'
  depends+=(python)

  cd "$pkgbase"

  python -m installer --destdir="$pkgdir" lib/dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
