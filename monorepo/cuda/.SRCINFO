pkgname = cuda
	optdepends = gdb: for cuda-gdb
	optdepends = glu: required for some profiling tools in CUPTI
	optdepends = nvidia-utils: for NVIDIA drivers (not needed in CDI containers)
	optdepends = nsight-compute: for profiling CUDA applications
	optdepends = nsight-systems: for system-wide profiling
	optdepends = rdma-core: for GPUDirect Storage (libcufile_rdma.so)
	provides = cuda-toolkit
	provides = cuda-sdk
	provides = libcudart.so
	provides = libcublas.so
	provides = libcusolver.so
	provides = libcusparse.so
	replaces = cuda-toolkit
	replaces = cuda-sdk
	replaces = cuda-static
	replaces = cuda-tools
