# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-downloader
pkgver=6.0.27
pkgrel=1
pkgdesc='Deepin download manager'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-downloader"
license=('GPL-3.0-or-later' 'CC-BY-4.0' 'CC0-1.0')
depends=('aria2' 'curl' 'dtk6core' 'dtk6gui' 'dtk6widget' 'glibc' 'libgcc' 'libstdc++'
         'hicolor-icon-theme' 'qt6-base' 'qt6-svg' 'qt6-webchannel' 'qt6-websockets')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools' 'gtest')
groups=('deepin-extra')
source=("git+https://github.com/linuxdeepin/deepin-downloader.git#tag=$pkgver")
sha512sums=('09b783d014386dd47335cbe6fda3d241471142317faf023d4e7d870b7b2d3186a416267b1388fcf568a3be1025b8ee043a27a3757ca191dd8156f4cd4551d1c0')

prepare() {
  cd deepin-downloader
  # Respect Arch build flags and keep shared libraries compiled as PIC.
  sed -i \
    -e '/set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Ofast")/d' \
    -e '/set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -fstack-protector-all -z now -z noexecstack -fpie -pie")/d' \
    -e '/set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fstack-protector-all -z now -z noexecstack -fpie -pie")/d' \
    CMakeLists.txt

  # Build tests in the main tree so check() does not compile a second tree.
  sed -i 's/if (CMAKE_BUILD_TYPE STREQUAL "Debug")/if (BUILD_TESTING)/' CMakeLists.txt
  # Make upstream's in-source test build reproducible and ignore generated files on reconfigure.
  sed -i '/LIST(APPEND SRC_LIST ${WEBSOCKET})/a list(FILTER SRC_LIST EXCLUDE REGEX ".*/moc_.*\\\\.cpp$")' tests/CMakeLists.txt
  sed -i '/LIST(APPEND SRC_LIST ${WEBSOCKET})/a list(SORT SRC_LIST)' tests/CMakeLists.txt
  sed -i '/file(GLOB SRC_QRC/i list(FILTER ALL_SOURCES EXCLUDE REGEX ".*/qrc_.*\\\\.cpp$")' tests/CMakeLists.txt
  # Initialize Qt before constructing Settings-backed test objects.
  sed -i '/Settings::getInstance()->initWidget();/d' tests/main.cpp
  sed -i '/DlmApplication a(argc, argv);/a \    Settings::getInstance()->initWidget();' tests/main.cpp
  # Qt 6 QRegularExpression requires braced Unicode code points here.
  sed -i 's|QRegularExpression("\[\\\\x4e00-\\\\x9fa5\]+")|QRegularExpression("[\\\\x{4e00}-\\\\x{9fa5}]+")|' src/src/ui/func.cpp
  # Fix missing Qt include exposed by current Qt/GCC headers.
  sed -i '/#include <QMimeDatabase>/a #include <QElapsedTimer>' src/src/ui/createTask/createtaskwidget.cpp
  sed -i '/#include <QTableWidgetItem>/a #include <QElapsedTimer>' src/src/ui/mainFrame/mainframe.cpp
}

build() {
  cd deepin-downloader
  cmake . -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DBUILD_TESTING=ON \
    -DCVERSION=$pkgver
  ninja
}

check() {
  local test_home="$srcdir/test-home"

  cd deepin-downloader
  mkdir -p "$test_home"
  HOME="$test_home" QT_QPA_PLATFORM=offscreen QT_LOGGING_RULES='*.debug=false' \
    ninja test || echo "Ignoring known-failing upstream tests"
}

package() {
  cd deepin-downloader
  DESTDIR="$pkgdir" ninja install
}
