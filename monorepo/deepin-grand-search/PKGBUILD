# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-grand-search
pkgver=6.0.19
pkgrel=1
pkgdesc='System-wide desktop search for DDE'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-grand-search"
license=('GPL-3.0-or-later')
# deepin-application-manager: org.deepin.dde.Application1.Manager :/
depends=(deepin-anything deepin-application-manager deepin-service-manager deepin-util-dfm deepin-shell taglib ffmpeg icu deepin-pdfium ffmpegthumbnailer lucene++
         deepin-qt-dbus-factory dtk6core dtk6gui dtk6widget qt6-base qt6-5compat)
makedepends=(git cmake deepin-desktop-base deepin-tray-loader ninja qt6-tools boost)
groups=(deepin-extra)
source=("git+https://github.com/linuxdeepin/dde-grand-search.git#tag=$pkgver"
         dfm-search-sync.patch)
sha512sums=('28862a07729cbe1afcd46fa82d99e83f4470c117f9d6bb88e048a1c2d3a8086d3809277ddd955b8be89c6b2c1125712460984db556fb424c6afffeb301da6715'
            '5a04f3800bef8e1309a31f6641678661247a03c16b6f412b9452142b269919a752a16386247cb69d8e36ce39b0344cc8acd5918363a509c09c43ba69ce3b7f8f')

prepare() {
  cd dde-grand-search

  # deepin-desktop-base installs the OS version file as /etc/uos-version on Arch.
  # https://github.com/linuxdeepin/dde-grand-search/pull/228
  sed -i 's|/etc/os-version|/etc/uos-version|' CMakeLists.txt

  # Remove invalid global PIE flags that break linking shared libraries.
  # https://github.com/linuxdeepin/dde-grand-search/pull/65
  sed -i 's/-fPIE -pie//g' src/*/CMakeLists.txt

  # Extract the bundled ANTLR runtime omitted from the Git tag checkout.
  # https://github.com/linuxdeepin/dde-grand-search/commit/54eb7ce7234cf6fd3d587eb39c3a697fc55bd265
  if [[ ! -d 3rdparty/antlr4 ]]; then
    bsdtar -xf 3rdparty/antlr4.tar.gz -C 3rdparty
  fi

  # Adapt the bundled ANTLR runtime's obsolete declarations for CMake 4.
  # https://github.com/linuxdeepin/dde-grand-search/commit/54eb7ce7234cf6fd3d587eb39c3a697fc55bd265
  sed -i 's/^cmake_minimum_required (VERSION 2\.8)$/cmake_minimum_required (VERSION 3.5)/' \
    3rdparty/antlr4/antlr4-runtime/CMakeLists.txt

  # Remove bundled ANTLR policy settings no longer accepted by CMake 4.
  # https://github.com/linuxdeepin/dde-grand-search/commit/54eb7ce7234cf6fd3d587eb39c3a697fc55bd265
  sed -i '/CMAKE_POLICY(SET CMP0054 OLD)/d; /CMAKE_POLICY(SET CMP0045 OLD)/d; /CMAKE_POLICY(SET CMP0042 OLD)/d; /CMAKE_POLICY(SET CMP0059 OLD)/d' \
    3rdparty/antlr4/antlr4-runtime/CMakeLists.txt

  # Add Qt includes missing from the EventLogUtil header introduced by upstream.
  # https://github.com/linuxdeepin/dde-grand-search/pull/195
  sed -i 's|#include <QVariantMap>|#include <QObject>\n#include <QJsonObject>\n#include <QThread>\n#include <QVariantMap>|' \
    src/grand-search/utils/report/eventlogutil.h

  # Avoid the asynchronous callback introduced upstream outliving its search engine.
  # https://github.com/linuxdeepin/dde-grand-search/pull/213
  patch -p1 -i ../dfm-search-sync.patch
}

build() {
  cd dde-grand-search
  cmake -GNinja . -DCMAKE_INSTALL_PREFIX=/usr -DVERSION=$pkgver
  ninja
}

package() {
  cd dde-grand-search
  DESTDIR="$pkgdir" ninja install
}
