# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-seatd
pkgver=0.9.3_3
pkgrel=1
pkgdesc='DDE seat management daemon and renamed libseat-compatible stack'
arch=('x86_64')
url='https://github.com/linuxdeepin/dde-seatd'
license=('MIT')
depends=('glibc')
makedepends=('git' 'meson' 'ninja' 'scdoc')
provides=('dde-seatd' 'libdde-seat.so')
conflicts=('dde-seatd')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/dde-seatd.git#tag=${pkgver/_/-}")
sha512sums=('91bb7584dd58d90b23063747fc8d2e7ea6b2a458a5568a69e94638a3185dbe56d40baeb40e9f27e2094ed790ffc92682887e662b0a3e5622a5c5fd8f5e65078e')

build() {
  local meson_options=(
    -Dexamples=disabled
    -Dlibseat-builtin=disabled
    -Dlibseat-logind=disabled
    -Dlibseat-seatd=enabled
    -Dman-pages=enabled
    -Dserver=enabled
    -Dwerror=false
  )

  arch-meson dde-seatd build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 dde-seatd/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
