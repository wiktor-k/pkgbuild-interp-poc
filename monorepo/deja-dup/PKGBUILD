# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=deja-dup
pkgver=50.2
pkgrel=1
pkgdesc='Easy to use backup tool based on Restic'
arch=(x86_64)
url='https://apps.gnome.org/DejaDup/'
license=(GPL-3.0-or-later)
groups=(gnome-circle)
depends=(
  bash
  dconf
  duplicity
  fuse3
  glib2
  glibc
  gtk4
  gvfs
  hicolor-icon-theme
  json-glib
  libadwaita
  libsecret
  libsoup3
  pango
  restic
)
makedepends=(
  appstream
  blueprint-compiler
  git
  itstool
  meson
  vala
)
checkdepends=(xdg-user-dirs)
optdepends=('rclone: Backup into Google Drive or Microsoft OneDrive')
source=("git+https://gitlab.gnome.org/World/$pkgname.git#tag=$pkgver")
b2sums=(58a8e9b98cb03dbcb6c8bc88f2f99de5e008ba43523af5881334244e1fe4d40d1bfa1a8fa16aeb430a609d323e7dcd60f6ed5e32037d9065e782c58e06358843)
validpgpkeys=(A3A5C2FC56AE7341D308D8571B50ECA373F3F233) # Michael Terry <mike@mterry.name>

build() {
  arch-meson $pkgname build \
    -D packagekit=disabled
  meson compile -C build
}

check() {
  dbus-run-session \
    meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
