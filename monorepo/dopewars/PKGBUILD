pkgname=dopewars
pkgver=1.6.2
pkgrel=4
pkgdesc='Turn based strategy game based on "Drug Wars" from 1984'
arch=(x86_64)
url='https://dopewars.sourceforge.io'
license=(GPL-2.0-only)
depends=(gtk3)
makedepends=(
  git
  alsa-lib
  audiofile
  gendesk
  sdl2
  sdl2_mixer
  ncurses
)
optdepends=(
  'sdl2: for the graphical interface'
  'alsa-lib: for audio'
  'audiofile: for audio'
  'sdl2_mixer: for audio'
)
backup=(srv/dopewars/dopewars.sco)
source=(
  "git+https://github.com/benmwebb/dopewars#tag=v$pkgver"
  dopewars.service
  dopewars.socket
  fix-translations.patch
)
