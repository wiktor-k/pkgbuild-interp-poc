# Contributor: Hoàng Văn Khải <hvksmr1996@gmail.com>

pkgname=dprint
pkgver=0.63.0
pkgrel=1
pkgdesc='Pluggable and configurable code formatting platform'
arch=('x86_64')
url='https://github.com/dprint/dprint'
license=('MIT')
depends=('bzip2' 'xz' 'libgcc' 'glibc' 'zstd')
makedepends=('cargo' 'git')
options=('!lto') # interferes with compiling
source=("git+$url#tag=$pkgver")
sha256sums=('5d84012850bf04fa2425169803b447f0d98de64e0170510481ece2c5a6dbfa99')

prepare() {
	cd $pkgname
	cargo fetch --locked --target host-tuple
}

build() {
	cd $pkgname

	export ZSTD_SYS_USE_PKG_CONFIG=1
	export RUST_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	cargo build --release --frozen --all-features

	for shell in bash elvish fish zsh; do
		./target/release/dprint completions $shell > completions_$shell
	done
}

package() {
	cd $pkgname

	install -Dm644 completions_bash "$pkgdir/usr/share/bash-completion/completions/dprint"
	install -Dm644 completions_elvish "$pkgdir/usr/share/elvish/lib/dprint.elv"
	install -Dm644 completions_fish "$pkgdir/usr/share/fish/vendor_completions.d/dprint.fish"
	install -Dm644 completions_zsh "$pkgdir/usr/share/zsh/site-functions/_dprint"

	install -Dm755 target/release/dprint -t "$pkgdir/usr/bin/"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
	install -Dm644 README.md docs/*.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
