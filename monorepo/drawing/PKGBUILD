# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=drawing
pkgver=1.0.2
pkgrel=3
pkgdesc='Basic image editor for the GNOME desktop'
arch=(any)
url='https://maoschanz.github.io/drawing/'
license=(GPL-3.0-or-later)
depends=(
  dconf
  gdk-pixbuf2
  glib2
  gtk3
  hicolor-icon-theme
  pango
  python
  python-cairo
  python-gobject
)
makedepends=(
  appstream
  git
  itstool
  meson
)
source=("git+https://github.com/maoschanz/drawing.git#tag=$pkgver")
b2sums=(cf91bedf355a35a475db86b867ce54f704c89bc5a061a130194c2a3855743e6151fdfa9c0b8efcf61007442556200cbb08fcb80d51d7369b40554ffe26b2c8a9)

prepare() {
  cd $pkgname

  # Use appstreamcli for appdata validation
  git cherry-pick -n b0fdc420af776e6cd1056d1d79952b5a46cb8e89
  git cherry-pick -n 3da3c2e1acb2e5c457fdafa7059d15f927603a28
}

build() {
  arch-meson $pkgname build
  ninja -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
