pkgname=dvdstyler
pkgver=3.2.1
pkgrel=7
pkgdesc='DVD authoring application for the creation of professional-looking DVDs'
arch=(x86_64)
url='https://www.dvdstyler.org/'
license=(GPL-2.0-only)
depends=(
  cdrtools
  dbus
  dvd+rw-tools
  dvdauthor
  ffmpeg
  fontconfig
  glibc
  hicolor-icon-theme
  libgcc
  libstdc++
  systemd-libs
  wxsvg
  wxwidgets-common
  wxwidgets-gtk3
)
makedepends=(
  docbook-xsl
  strip-nondeterminism
  xmlto
  zip
)
source=(
  "https://downloads.sourceforge.net/$pkgname/DVDStyler-$pkgver.tar.bz2"
  0001-fixed-encoding-of-silent-audio-file.patch
  0002-added-support-of-ffmpeg5.patch
  0003-added-support-of-ffmpeg-7.0.patch
  0004-added-support-of-ffmpeg-8.0.patch
  ffmpeg-9.patch
  dvdstyler-save-configuration-file.patch
)
b2sums=(
