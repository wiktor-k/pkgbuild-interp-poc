# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=eartag
pkgver=1.0.3
pkgrel=1
pkgdesc='Simple audio file tag editor'
arch=(any)
url='https://apps.gnome.org/EarTag/'
license=(MIT)
groups=(gnome-circle)
depends=(
  dconf
  gdk-pixbuf2
  glib2
  gtk4
  hicolor-icon-theme
  libadwaita
  pango
  python
  python-aiofiles
  python-aiohttp
  python-aiohttp-retry
  python-filetype
  python-gobject
  python-mutagen
  python-pillow
  python-pyacoustid
  python-xxhash
)
makedepends=(
  appstream
  blueprint-compiler
  git
  meson
)
checkdepends=(
  python-pytest
  python-pytest-asyncio
)
source=("git+https://gitlab.gnome.org/World/eartag.git#tag=$pkgver")
b2sums=(4ebe097fc04b1e1fd317382ed113729e27141282a4e42d9ead25205e2d0d3efa9853a73db4f1e485ad595975337bfd07a522f4f7dd3f674b4a5a9890cc97734d)

prepare() {
  cd $pkgname

  # Skip broken tests
  sed -i "/subdir('tests')/d" meson.build
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" $pkgname/COPYING

  python -m compileall -d /usr/share "$pkgdir/usr/share"
  python -O -m compileall -d /usr/share "$pkgdir/usr/share"
}
