pkgbase = easytier
	pkgdesc = A simple, decentralized mesh VPN with WireGuard support
	pkgver = 2.6.4
	pkgrel = 8
	url = https://easytier.cn/
	arch = x86_64
	license = LGPL-3.0-only
	makedepends = cargo
	makedepends = openssl
	makedepends = protobuf
	makedepends = rust-bindgen
	makedepends = sqlite
	makedepends = nodejs
	makedepends = pnpm
	depends = glibc
	depends = libgcc
	depends = zstd
	options = !lto
	source = EasyTier-2.6.4.tar.gz::https://github.com/EasyTier/EasyTier/archive/refs/tags/v2.6.4.tar.gz
	source = 0001-build-update-pnpm-config-for-v11-compatibility.patch
	source = 0002-native-tls.patch
	source = easytier.service
	source = easytier.sysusers
	source = config.toml
	sha256sums = 352c0866da709415a837405a6ce4f51b8dfae27e5d5c1da1fb4d8f7338e46795
	sha256sums = 70049779ad48f5257ecf36a5c92ed92c86e1f5f9e6a74650fe716ffb98a09803
	sha256sums = 586c4f7bf14108fcad29ef302d3c6cf4d5cfb0eac7bef8b36a0f8fbbc4278d28
	sha256sums = fcc79788a2a3c0953a2d85211347af86656428a80a8592353d17637930e861b0
	sha256sums = 3789cdd166a6bfbc942bade52ba743780ffc2d6313a61eda9fdb3f27de29067b
