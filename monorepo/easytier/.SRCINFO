pkgname = easytier
	depends = easytier-core
	depends = easytier-cli
	depends = easytier-web

pkgname = easytier-core
	pkgdesc = A simple, decentralized mesh VPN with WireGuard support - Core daemon
	depends = glibc
	depends = libgcc
	depends = zstd
	depends = openssl
	optdepends = easytier-cli: Command-line interface
	optdepends = easytier-web: Web management interface
	backup = etc/easytier/config.toml

pkgname = easytier-cli
	pkgdesc = A simple, decentralized mesh VPN with WireGuard support - Command-line interface
	optdepends = easytier-core: for managing a local EasyTier instance

pkgname = easytier-web
	pkgdesc = A simple, decentralized mesh VPN with WireGuard support - Web management interface
	depends = glibc
	depends = libgcc
	depends = zstd
	depends = openssl
	depends = sqlite
	optdepends = easytier-core: to run a local mesh node connected to this server
