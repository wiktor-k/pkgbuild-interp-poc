_pkgname=EasyTier
pkgbase=easytier
pkgname=(${pkgbase} ${pkgbase}-core ${pkgbase}-cli ${pkgbase}-web)
pkgver=2.6.4
pkgrel=8
pkgdesc="A simple, decentralized mesh VPN with WireGuard support"
arch=('x86_64')
url="https://easytier.cn/"
license=('LGPL-3.0-only')
depends=(
    'glibc'
    'libgcc'
    'zstd'
)
makedepends=(
    'cargo'
    'openssl'
    'protobuf'
    'rust-bindgen'
    'sqlite'
    # for embeded web
    'nodejs'
    'pnpm'
)
options=("!lto") # https://gitlab.archlinux.org/archlinux/packaging/packages/pacman/-/issues/20
source=(
    "${_pkgname}-${pkgver}.tar.gz::https://github.com/EasyTier/EasyTier/archive/refs/tags/v${pkgver}.tar.gz"
    "0001-build-update-pnpm-config-for-v11-compatibility.patch"
    "0002-native-tls.patch"
    "easytier.service"
    "easytier.sysusers"
    "config.toml"
)
sha256sums=(
    '352c0866da709415a837405a6ce4f51b8dfae27e5d5c1da1fb4d8f7338e46795'
    '70049779ad48f5257ecf36a5c92ed92c86e1f5f9e6a74650fe716ffb98a09803'
    '586c4f7bf14108fcad29ef302d3c6cf4d5cfb0eac7bef8b36a0f8fbbc4278d28'
    'fcc79788a2a3c0953a2d85211347af86656428a80a8592353d17637930e861b0'
    '3789cdd166a6bfbc942bade52ba743780ffc2d6313a61eda9fdb3f27de29067b'
    '05518beea8b047d5e9b9adb14f26f85a91e4eea81ead7eeb4743f8978e1fd842'
)

prepare() {
    cd "${_pkgname}-${pkgver}"

    # Fix `ERR_PNPM_LOCKFILE_CONFIG_MISMATCH` and `ERR_PNPM_IGNORED_BUILDS` on pnpm v11.0.0+.
    # https://github.com/EasyTier/EasyTier/pull/2322
    patch -Np1 -i "${srcdir}/0001-build-update-pnpm-config-for-v11-compatibility.patch"

    # https://github.com/NixOS/nixpkgs/pull/576942
    patch -Np1 -i "${srcdir}/0002-native-tls.patch"

    pnpm -r install --frozen-lockfile

    cargo fetch --locked --target host-tuple
}

build() {
    cd "${_pkgname}-${pkgver}"

    pnpm -r --filter "./easytier-web/*" build

    # Used for dynamic linking
    export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
    export OPENSSL_NO_VENDOR=1
    export ZSTD_SYS_USE_PKG_CONFIG=1

    cargo build --frozen --release --features=embed

    install -d completions

    for _shell in bash fish zsh nu elvish
    do
        ./target/release/easytier-core --gen-autocomplete "${_shell}" > completions/core-"${_shell}"
        ./target/release/easytier-cli gen-autocomplete "${_shell}" > completions/cli-"${_shell}"
    done
}

package_easytier() {
    depends=('easytier-core' 'easytier-cli' 'easytier-web')
}

package_easytier-core() {
    pkgdesc+=" - Core daemon"
    depends+=(
        'openssl'
    )
    optdepends=(
        'easytier-cli: Command-line interface'
        'easytier-web: Web management interface'
    )
    backup=('etc/easytier/config.toml')

    install -Dm644 "config.toml" -t "${pkgdir}/etc/easytier"
    install -Dm644 "easytier.service" -t "${pkgdir}/usr/lib/systemd/system"
    install -Dm644 "easytier.sysusers" "${pkgdir}/usr/lib/sysusers.d/easytier.conf"

    cd "${_pkgname}-${pkgver}"
    install -Dm755 "target/release/easytier-core" -t "${pkgdir}/usr/bin"

    install -Dm644 completions/core-bash "${pkgdir}/usr/share/bash-completion/completions/${pkgname}"
    install -Dm644 completions/core-fish "${pkgdir}/usr/share/fish/vendor_completions.d/$pkgname.fish"
    install -Dm644 completions/core-zsh "${pkgdir}/usr/share/zsh/site-functions/_${pkgname}"
    install -Dm644 completions/core-nu "${pkgdir}/usr/share/nushell/vendor/autoload/${pkgname}.nu"
    install -Dm644 completions/core-elvish "${pkgdir}/usr/share/elvish/lib/${pkgname}.elv"
}

package_easytier-cli() {
    pkgdesc+=" - Command-line interface"
    optdepends=(
        'easytier-core: for managing a local EasyTier instance'
    )

    cd "${_pkgname}-${pkgver}"
    install -Dm755 "target/release/easytier-cli" -t "${pkgdir}/usr/bin"

    install -Dm644 completions/cli-bash "${pkgdir}/usr/share/bash-completion/completions/${pkgname}"
    install -Dm644 completions/cli-fish "${pkgdir}/usr/share/fish/vendor_completions.d/${pkgname}.fish"
    install -Dm644 completions/cli-zsh "${pkgdir}/usr/share/zsh/site-functions/_${pkgname}"
    install -Dm644 completions/cli-nu "${pkgdir}/usr/share/nushell/vendor/autoload/${pkgname}.nu"
    install -Dm644 completions/cli-elvish "${pkgdir}/usr/share/elvish/lib/${pkgname}.elv"
}

package_easytier-web() {
    pkgdesc+=" - Web management interface"
    depends+=(
        'openssl'
        'sqlite'
    )
    optdepends=(
        'easytier-core: to run a local mesh node connected to this server'
    )

    cd "${_pkgname}-${pkgver}"
    install -Dm755 "target/release/easytier-web" -t "${pkgdir}/usr/bin"
}
