prepare() {
  cd "$pkgname-$pkgver"

  # Default CPP and CPPFLAGS cause errors. See FS#36228.
  # https://bugs.archlinux.org/task/36228
  autoreconf -vfi

  # enable usage of DESTDIR & harden makefile
  patch -p1 -i "$srcdir/makefile-destdir.patch"

  # fix FTBFS due to newer gcc versions
  patch -p1 -i "$srcdir/include-string-header.patch"
}

build() {
  cd "$pkgname-$pkgver"

  ./configure \
    --prefix=/usr \
    --localstatedir=/var/games

  make
}

package() {
  depends+=(glibc)

  cd "$pkgname-$pkgver"

  make DESTDIR="$pkgdir" install

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENCE
}
