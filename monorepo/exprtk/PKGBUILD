# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=exprtk
pkgver=0.0.3
pkgrel=2
pkgdesc="C++ Mathematical Expression Parsing And Evaluation Library"
arch=(any)
url="https://github.com/ArashPartow/exprtk/"
license=(MIT)
source=("$pkgname-$pkgver.tar.gz::${url}archive/refs/tags/$pkgver.tar.gz")
sha512sums=('1493b68929d3cb4e97c0180ef6f111ae4edbbee072ab78223976005b8402e4e7b56d94f013fbbc009f4db2652167fa3b4ba3c33d4029572ebbe61a36df9da9e4')
b2sums=('db96c6ba2aa8efd4fe7cd1115e09c12a07ec1ee7e496f6b0eacc22b61913c81574e93e1db77e35ec514813b63914518deeeb1f7c3cb83f9d6d32be2e698e84e9')

build() {
  make -C "$pkgname-$pkgver"
}

check() {
  "./$pkgname-$pkgver/${pkgname}_test"
}

package() {
  install -vDm 644 "$pkgname-$pkgver/$pkgname.hpp" -t "$pkgdir/usr/include/"
  install -vDm 644 "$pkgname-$pkgver/license.txt" -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 "$pkgname-$pkgver/readme.txt" -t "$pkgdir/usr/share/doc/$pkgname/"
}
