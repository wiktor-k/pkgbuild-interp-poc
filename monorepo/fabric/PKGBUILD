# Contributor: Francois Boulogne <fboulogne at april dot org>

pkgname=fabric
pkgver=3.2.3
pkgrel=1
pkgdesc="Python library and command-line tool designed to streamline deploying applications or performing system administration tasks via the SSH protocol"
url="https://www.fabfile.org/"
license=('BSD-2-Clause')
arch=('any')
depends=('python-paramiko' 'python-invoke' 'python-decorator' 'python-deprecated' 'python-pytest')
makedepends=(python-setuptools python-wheel python-build python-installer)
checkdepends=(python-pytest python-icecream python-pytest-relaxed)
optdepends=('python-patchwork: Common deployment/sysadmin operations')
source=("https://github.com/fabric/fabric/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz"
        "https://github.com/fabric/fabric/commit/7fa309db9dd5dac69079c1fb83b6f579555f7d53.patch"
        "${pkgname}-devendor-lexicon-in-tests.patch")
sha512sums=('305c0e70bc0ed7520bc550b99ebc9b1072e1c78111c391cb71e8bb442e57ea224658c9014bc4226bedba7ba1f71011ac6b3fa87afa521da3750108a37486ed7c'
            'a0aef5f0df99c659f117faac647f22f695deb8646b79b2598ec2cfa6ff7e29da80e40a0394abfed236fde1be42d3480db815a8a7905bdde31942895192aa175a'
            '1221cffcca631406dd0c6a8cbc72ba7d2665cab6bf6a8fe3a1ca18b7afb244704c1dd26625dbb5f59e9bb66b982861c40a62e8cb55ed2fd26bcc59faf04f5290')

prepare() {
  cd ${pkgname}-${pkgver}
  # python-invoke 3.0 compatibility
  patch -Np1 -i ../7fa309db9dd5dac69079c1fb83b6f579555f7d53.patch

  patch -Np1 -i ../${pkgname}-devendor-lexicon-in-tests.patch
}

build() {
  cd ${pkgname}-${pkgver}
  python -m build --wheel --no-isolation
}

check() {
  cd ${pkgname}-${pkgver}
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  # Deselect tests broken by pytest-relaxed incompatibility with newer pytest
  test-env/bin/python -m pytest \
    --deselect tests/config.py::Config_::from_v1 \
    --deselect tests/connection.py::Connection_::init::ssh_config::proxy_jump \
    --deselect tests/connection.py::Connection_::from_v1 \
    --deselect tests/connection.py::Connection_::shell \
    --deselect tests/group.py::ThreadingGroup_::executes_arguments_on_contents_run_via_threading \
    --deselect tests/transfer.py::Transfer_::get::mode_concerns
}

package() {
  cd ${pkgname}-${pkgver}
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 README.rst "${pkgdir}"/usr/share/doc/${pkgname}/README.rst
  install -Dm644 LICENSE "${pkgdir}"/usr/share/licenses/${pkgname}/LICENSE
}
