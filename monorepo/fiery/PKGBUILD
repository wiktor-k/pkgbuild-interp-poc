# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=fiery
pkgver=1.0.2
pkgrel=2
epoch=1
pkgdesc='A convergent web browser'
url='https://mauikit.org/'
arch=(x86_64)
license=(LGPL-3.0-only)
depends=(glibc
         hicolor-icon-theme
         kcoreaddons
         ki18n
         libstdc++
         mauikit
         mauikit-filebrowsing
         qt6-base
         qt6-declarative
         qt6-webengine)
makedepends=(extra-cmake-modules)
groups=(maui)
source=(https://download.kde.org/stable/maui/$pkgname/$pkgver/maui-$pkgname-$pkgver.tar.xz)
sha256sums=('ad668b02b7d020be6abf0fd9b7ef6ebf3e97f3ef4c4bc4f5d1a0a0f92447171f')

prepare() {
  sed -i '/find_package(Qt6WebEngineQuick REQUIRED)/a find_package(Qt6CorePrivate REQUIRED)\nfind_package(Qt6WebEngineQuickPrivate REQUIRED)' maui-$pkgname-$pkgver/CMakeLists.txt
}

build() {
  cmake -B build -S maui-$pkgname-$pkgver
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
