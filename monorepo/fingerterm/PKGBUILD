# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=fingerterm
pkgver=1.5.0
pkgrel=1
pkgdesc="A terminal emulator with a custom virtual keyboard"
arch=('x86_64')
url="https://github.com/sailfishos/fingerterm"
license=('GPL-2.0-only')
depends=('qt6-base' 'qt6-declarative')
makedepends=('git' 'qt6-tools')
source=("git+https://github.com/sailfishos/fingerterm.git#tag=$pkgver")
sha512sums=('268cb8067055bb40857c4f1b4d902c848e72d60a8236549257de57bb3ee9ec5af7c38c93264ce889501a732a7d730bdbea95779a1f6276fc54fbef0b0d03166b')

build() {
  cd fingerterm

  qmake6 VERSION_STRING="$pkgver"
  make
}

package() {
  cd fingerterm

  make INSTALL_ROOT="$pkgdir" install
}
