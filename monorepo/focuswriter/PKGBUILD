# Contributor: Graeme Gott <graeme@gottcode.org>

pkgname=focuswriter
pkgver=1.9.1
pkgrel=1
pkgdesc='Simple, distraction-free word processor'
arch=(x86_64)
url='https://gottcode.org/focuswriter/'
license=(GPL-3.0-or-later)
depends=(
  glibc
  hicolor-icon-theme
  hunspell
  kdsingleapplication
  libgcc
  libstdc++
  qt6-base
  qt6-multimedia
  zlib
)
makedepends=(
  cmake
  git
  qt6-tools
)
source=("git+https://github.com/gottcode/focuswriter.git?signed#tag=v$pkgver")
b2sums=(ec48363adc66a3613cfac4ab9b3413b46e9d38e12f592db6622b621e457671d9a94cd04e324da1a24921b8dad3a7a2a3e6c0f3ee7576ec4921c0eafd9e95d862)
validpgpkeys=(57E4D43C10CD7EDB8360C84774FFC7F02C4F6B37) # Graeme Gott <graeme@gottcode.org>

build() {
  cmake -B build -S $pkgname \
    -D CMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
