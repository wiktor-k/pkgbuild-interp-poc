# Maintainer: Carl Smedstad <carsme@archlinux.org>
# Contributor: huyz

pkgname=gemini-cli
pkgver=0.64.0
pkgrel=1
epoch=1
pkgdesc="Open-source AI agent that brings the power of Gemini directly into your terminal"
arch=(x86_64)
url="https://github.com/google-gemini/gemini-cli"
license=(Apache-2.0)
depends=(
  glib2
  glibc
  libgcc
  libsecret
  libstdc++
  nodejs
)
makedepends=(
  git
  jq
  node-gyp
  npm
  python
)
optdepends=(
  'ripgrep: file content search'
  'wl-clipboard: clipboard image pasting on Wayland'
  'xclip: clipboard image pasting on X11'
  'xdg-utils: opening URLs in default browser'
)
checkdepends=(
  bubblewrap
  vim
)
source=("git+$url.git#tag=v$pkgver")
b2sums=('d5478f9aa8713f5988f4d207fe2f7d1b5bd835e8e4cb73e0a5107217b104d3e3043fc10b406d1f63423d3ece4b12a53ba24e8cbcbc242a289d146942c794a29f')

prepare() {
  cd $pkgname
  # The repo's .npmrc points the @google scope at a publishing registry
  # (wombat-dressing-room). Point the scope back at the registry the lockfile
  # resolved against.
  npm clean-install --ignore-scripts \
    --@google:registry=https://registry.npmjs.org/
}

build() {
  cd $pkgname
  npm run bundle
  # Build keytar native addon to enable OS keychain integration via libsecret
  # (GNOME Keyring, KDE Wallet, etc.) instead of falling back to a file-based
  # keychain.
  (
    cd node_modules/@github/keytar
    node-gyp rebuild
  )
  local bundled=$(jq '.dependencies + .optionalDependencies | keys' package.json)
  npm pkg set --json bundledDependencies="$bundled"
  # npm refuses to pack when "overrides" touch a bundled package
  # (EBUNDLEOVERRIDE). The overrides were already applied when installing
  # node_modules, so drop them before packing.
  npm pkg delete overrides
  npm pack
}

check() {
  cd $pkgname
  # With CI set, scripts/build.js builds workspaces sequentially instead of via
  # npm-run-all, which forwards package.json "config" entries as CLI flags
  # that npm rejects (EUNKNOWNCONFIG).
  CI=1 npm run build
  # Deselect failing tests. FileCommandLoader and pathReader use mock-fs, which
  # patches Node internals and fails to load on current Node.
  npm run test --workspaces --if-present -- \
    --exclude='**/BuiltinCommandLoader.test.ts' \
    --exclude='**/FileCommandLoader.test.ts' \
    --exclude='**/config.integration.test.ts' \
    --exclude='**/gemini.test.tsx' \
    --exclude='**/mcp-client.test.ts' \
    --exclude='**/pathReader.test.ts' \
    --exclude='**/sandboxManager.integration.test.ts'
  npm run test:sea-launch
}

package() {
  cd $pkgname
  npm install --global --offline --prefix "$pkgdir/usr" \
    google-$pkgname-$pkgver.tgz
  # Remove node-gyp build artifacts
  rm -vrf "$pkgdir/usr/lib/node_modules/@google/gemini-cli/node_modules/@github/keytar/build/Release/obj.target"
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
