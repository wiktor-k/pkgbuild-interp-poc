# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgbase=ggml
pkgname=(
  ggml
  ggml-blas
  ggml-cuda
  ggml-hip
  ggml-openvino
  ggml-sycl
  ggml-vulkan
)
pkgver=0.26.0
pkgrel=1
pkgdesc='Tensor library for machine learning'
arch=(
  aarch64
  x86_64
)
url=https://github.com/ggerganov/ggml
license=(MIT)
depends=(
  glibc
  libgcc
  libstdc++
)
makedepends=(
  cuda
  chrpath
  cmake
  git
  ninja
  openblas
  procps-ng
  nccl
  ocl-icd
  opencl-clhpp
  openvino
  rocm-hip-sdk
  rocm-toolchain
  shaderc
  spirv-headers
  vulkan-headers
  vulkan-icd-loader
)
makedepends_x86_64=(
  intel-oneapi-toolkit
  level-zero-headers
  onetbb
)
options=(!buildflags)
source=(git+https://github.com/ggml-org/ggml.git#tag=v${pkgver})
b2sums=('203856692e049060844664d52340be47db0a31770be6f7b9965ce573d6b7ffe68a7890abb01df8a0371f0d7bbd7e01b4155231ee065e8dbc2af7fb0a13da5784')

build() {
  local _cmake_options=(
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DGGML_BACKEND_DL=ON
    -DGGML_BACKEND_DIR=/usr/lib/ggml
    -DGGML_BLAS=ON
    -DGGML_BLAS_VENDOR=OpenBLAS
    -DGGML_CPU_ALL_VARIANTS=ON
    -DGGML_CUDA=ON
    -DGGML_HIP=ON
    -DGGML_OPENVINO=ON
    -DGGML_VULKAN=ON
    "-DAMDGPU_TARGETS=$(rocm-supported-gfx)"
    )

  cmake -S ggml -B build-all -G Ninja "${_cmake_options[@]}"
  cmake --build build-all
  chrpath -d build-all/bin/libggml-*.so

  if [[ $CARCH == x86_64 ]]; then
    . /opt/intel/oneapi/setvars.sh

    cmake -S ggml -B build-sycl -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SKIP_RPATH=ON \
        -DCMAKE_C_COMPILER=icx \
        -DCMAKE_CXX_COMPILER=icpx \
        -DGGML_BACKEND_DL=ON \
        -DGGML_BACKEND_DIR=/usr/lib/ggml \
        -DGGML_BLAS=ON \
        -DGGML_BLAS_VENDOR=Intel10_64lp \
        -DGGML_CPU_ALL_VARIANTS=ON \
        -DGGML_SYCL=ON \
        -DGGML_SYCL_F16=ON
    cmake --build build-sycl
    chrpath -d build-sycl/bin/libggml-*.so
  fi
}

package_ggml() {
  depends+=(libgomp)
  optdepends=(
    'ggml-blas: BLAS backend'
    'ggml-cuda: CUDA backend'
    'ggml-hip: HIP backend'
    'ggml-openvino: Openvino backend'
    'ggml-vulkan: Vulkan backend'
  )
  conflicts=(
    ggml
    ggml-cpu
  )
  provides=(
    ggml
    ggml-cpu
  )

  DESTDIR="${pkgdir}" cmake --install build-all
  rm -rf "${pkgdir}"/usr/lib/ggml
  install -Dm 755 build-all/bin/libggml-cpu-*.so -t "${pkgdir}"/usr/lib/ggml/
  install -Dm 644 ggml/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}

package_ggml-blas() {
  depends+=(
    ggml
    openblas
  )

  install -Dm 755 build-all/bin/libggml-blas.so -t "${pkgdir}"/usr/lib/ggml/
  install -Dm 644 ggml/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}

package_ggml-cuda() {
  depends+=(
    cuda
    ggml
    nccl
  )

  install -Dm 755 build-all/bin/libggml-cuda.so -t "${pkgdir}"/usr/lib/ggml/
  install -Dm 644 ggml/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}

package_ggml-hip() {
  depends+=(
    ggml
    hipblas
    hip-runtime-amd
    rocblas
    rocm-hip-runtime
  )

  install -Dm 755 build-all/bin/libggml-hip.so -t "${pkgdir}"/usr/lib/ggml/
  install -Dm 644 ggml/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}

package_ggml-openvino() {
  depends+=(
    ggml
    ocl-icd
    onetbb
    openvino
  )

  install -Dm 755 build-all/bin/libggml-openvino.so -t "${pkgdir}"/usr/lib/ggml/
  install -Dm 644 ggml/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}

package_ggml-sycl() {
  arch=(x86_64)
  depends+=(
    intel-oneapi-toolkit
    level-zero-loader
    onetbb
  )
  conflicts=(
    ggml
    ggml-blas
    ggml-cpu
  )
  provides=(
    ggml
    ggml-blas
    ggml-cpu
  )

  DESTDIR="${pkgdir}" cmake --install build-sycl
  install -Dm 644 ggml/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}

package_ggml-vulkan() {
  depends+=(
    ggml
    vulkan-icd-loader
  )

  install -Dm 755 build-all/bin/libggml-vulkan.so -t "${pkgdir}"/usr/lib/ggml/
  install -Dm 644 ggml/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}
