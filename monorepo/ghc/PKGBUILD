prepare() {
  cd ghc-$pkgver

  patch -p1 -i ../$pkgbase-gcc-15.patch

  # Fix blackhole handling to prevent lost wakeups, deadlocks, and crashes in parallel programs.
  # https://gitlab.haskell.org/ghc/ghc/-/merge_requests/14734
  # https://gitlab.haskell.org/ghc/ghc/-/merge_requests/14963
  # https://gitlab.haskell.org/ghc/ghc/-/merge_requests/15640
  patch -p1 -i ../ghc-blackhole-wakeups.patch

  # Reduce startup symbol lookup costs for dynamically linked executables.
  patch -p1 -i ../ghc-core-first-dynamic-linking.patch

  # Let the system dynamic linker find bundled shared libraries without RPATH.
  patch -p1 -i ../ghc-shared-libdir.patch

  # devendor rtd-theme for sphinx compatibility
  rm -r docs/users_guide/rtd-theme
  sed -i 's/rtd-theme/sphinx_rtd_theme/' docs/users_guide/conf.py

  # detects GCC correctly
  sed -i 's/grep -q gcc/grep -qi gcc/' m4/fp_gcc_version.m4

  # Avoid obsolescent egrep warnings breaking tests with current GNU grep.
  # https://gitlab.haskell.org/ghc/ghc/-/issues/22351
  patch -p1 -i ../ghc-testsuite-egrep.patch

  # Use valid grep expressions instead of escapes that now produce warnings.
  # https://gitlab.haskell.org/ghc/ghc/-/commit/e305e60cf507808fa31c456ef98295f8f7d00c9d
  patch -p1 -i ../ghc-testsuite-grep-patterns.patch

  # Match pthread_create's callback type, which recent GCC rejects otherwise.
  # https://gitlab.haskell.org/ghc/ghc/-/commit/d6d5aafc0d9766f055a708f4d3dab9cba81d995a
  patch -p1 -i ../ghc-testsuite-pthread-callback.patch

  # Correct the work-stealing test's thread callback and diagnostic formats.
  # https://gitlab.haskell.org/ghc/ghc/-/merge_requests/12570
  patch -p1 -i ../ghc-testsuite-wsdeque.patch

  # Use closure pointers and matching format specifiers in the RTS roots test.
  # https://gitlab.haskell.org/ghc/ghc/-/issues/25237
  patch -p1 -i ../ghc-testsuite-closure-types.patch

  # Group T21035's compilation outputs to prevent duplicate recipes with parallel make.
  patch -p1 -i ../ghc-testsuite-T21035.patch

  # Serialize T7060's dump checks, which overwrite the same output files.
  patch -p1 -i ../ghc-testsuite-T7060.patch
}

build() {
  cd ghc-$pkgver

  LDFLAGS="${LDFLAGS/-Wl,-z,pack-relative-relocs/}" ./configure \
    --prefix=/usr \
    --docdir=/usr/share/doc/ghc \
    --with-system-libffi
  hadrian -j --flavour=perf
}

check() {
  cd ghc-$pkgver
  # Run performance tests from release archives without a Git checkout.
  hadrian test --flavour=perf --summary-metrics=testsuite_metrics.txt
}

package_ghc-static() {
  pkgdesc='The Glasgow Haskell Compiler - Static Libraries and Documentation'
  depends=('ghc')

  cd ghc-$pkgver

  DESTDIR="$pkgdir" LDFLAGS="${LDFLAGS/-Wl,-z,pack-relative-relocs/}" hadrian install --flavour=perf --prefix=/usr

  mv "$pkgdir"/usr/lib/ghc-$pkgver/lib/package.conf.d "$srcdir"/static-package.conf.d
  find "$pkgdir"/usr/lib ! \( -name "*.a" -o -name "*.o" -o -name "*.p_o" -o -name "*.p_hi" -o -name "*.hi" \) -type f -delete
  find "$pkgdir"/usr/lib -type d -empty -delete
  mv "$srcdir"/static-package.conf.d "$pkgdir"/usr/lib/ghc-$pkgver/lib/
  rm "$pkgdir"/usr/lib/ghc-$pkgver/lib/static-package.conf.d/*.copy
  rm -r "$pkgdir"/usr/bin "$pkgdir"/usr/share/man "$pkgdir"/usr/lib/ghc-$pkgver/bin
  mv "$pkgdir"/usr/share/doc/ghc{-$pkgver,}
  ln -s ghc "$pkgdir"/usr/share/doc/ghc-$pkgver

  install -Dm755 libraries/{gen_contents_index,prologue.txt} -t "$pkgdir"/usr/share/doc/ghc/html/libraries/
  install -Dm644 "$srcdir"/ghc-rebuild-doc-index.hook -t "$pkgdir"/usr/share/libalpm/hooks/
}

package_ghc() {
  pkgdesc='The Glasgow Haskell Compiler'
  install='ghc.install'
  depends=('gcc' 'ghc-libs' 'perl')
  provides=("haskell-ghc-pkg=$pkgver"
            'haskell-haddock=2.29.2'
            'haskell-hp2ps=0.1'
            'haskell-hpc-bin=0.68'
            'haskell-hsc2hs=0.68.9')
  replaces=('haskell-ghc-pkg'
            'haskell-haddock'
            'haskell-hp2ps'
            'haskell-hpc-bin'
            'haskell-hsc2hs')

  provides+=("haskell-ghc=$pkgver")
  replaces+=("haskell-ghc")

  cd ghc-$pkgver
  DESTDIR="$pkgdir" LDFLAGS="${LDFLAGS/-Wl,-z,pack-relative-relocs/}" hadrian install --flavour=perf --prefix=/usr

  # Remove static libs
  find "$pkgdir"/usr/lib \( -name "*.a" -o -name "*.o" -o -name "*.p_o" -o -name "*.p_hi" -o -name "*.hi" \) -delete

  rm "$pkgdir"/usr/lib/ghc-$pkgver/lib/package.conf.d/*.copy

  # Shared runtime libraries are in ghc-libs.
  find "$pkgdir"/usr/lib -maxdepth 1 \
    -name "*.so" ! -name "libHSghc-$pkgver-ghc$pkgver.so" -delete

  # docs moved to ghc-static
  rm -r "$pkgdir"/usr/share/doc

  install -Dm644 utils/completion/ghc.bash \
    "$pkgdir/usr/share/bash-completion/completions/ghc"

  install -Dm644 "$srcdir"/ghc-register.hook "$pkgdir"/usr/share/libalpm/hooks/ghc-register.hook
  install -Dm644 "$srcdir"/ghc-unregister.hook "$pkgdir"/usr/share/libalpm/hooks/ghc-unregister.hook

  install -dm755 "$pkgdir"/usr/share/haskell/{register,unregister}
}

package_ghc-libs() {
  pkgdesc='The Glasgow Haskell Compiler - Dynamic Libraries'
  depends=('gmp' 'libffi' 'numactl')
  provides=('haskell-array=0.5.8.0'
            'haskell-base=4.18.3.0'
            'haskell-binary=0.8.9.1'
            'haskell-bytestring=0.11.5.4'
            'haskell-cabal=3.10.3.0'
            'haskell-cabal-syntax=3.10.3.0'
            'haskell-containers=0.6.7'
            'haskell-deepseq=1.4.8.1'
            'haskell-directory=1.3.8.5'
            'haskell-exceptions=0.10.7'
            'haskell-filepath=1.4.301.0'
            'haskell-ghc-bignum=1.3'
            'haskell-ghc-boot=9.6.7'
            'haskell-ghc-boot-th=9.6.7'
            'haskell-ghc-compact=0.1.0.0'
            'haskell-ghc-heap=9.6.7'
            'haskell-ghc-prim=0.10.0'
            'haskell-haskeline=0.8.2.1'
            'haskell-hpc=0.6.2.0'
            'haskell-integer-gmp=1.1'
            'haskell-libiserv=9.6.7'
            'haskell-mtl=2.3.1'
            'haskell-parsec=3.1.16.1'
            'haskell-pretty=1.1.3.6'
            'haskell-process=1.6.19.0'
            'haskell-stm=2.5.1.0'
            'haskell-template-haskell=2.20.0.0'
            'haskell-terminfo=0.4.1.6'
            'haskell-text=2.0.2'
            'haskell-time=1.12.2'
            'haskell-transformers=0.6.1.0'
            'haskell-unix=2.8.6.0'
            'haskell-xhtml=3000.2.2.1')
  replaces=('haskell-array'
            'haskell-base'
            'haskell-binary'
            'haskell-bytestring'
            'haskell-cabal'
            'haskell-cabal-syntax'
            'haskell-containers'
            'haskell-deepseq'
            'haskell-directory'
            'haskell-exceptions'
            'haskell-filepath'
            'haskell-ghc-bignum'
            'haskell-ghc-boot'
            'haskell-ghc-boot-th'
            'haskell-ghc-compact'
            'haskell-ghc-heap'
            'haskell-ghc-prim'
            'haskell-haskeline'
            'haskell-hpc'
            'haskell-integer-gmp'
            'haskell-libiserv'
            'haskell-mtl'
            'haskell-parsec'
            'haskell-pretty'
            'haskell-process'
            'haskell-stm'
            'haskell-template-haskell'
            'haskell-terminfo'
            'haskell-text'
            'haskell-time'
            'haskell-transformers'
            'haskell-unix'
            'haskell-xhtml')

  provides+=("haskell-ghci=$pkgver")
  conflicts+=('haskell-ghci')

  cd ghc-$pkgver

  DESTDIR="$pkgdir" LDFLAGS="${LDFLAGS/-Wl,-z,pack-relative-relocs/}" hadrian install --flavour=perf --prefix=/usr

  # Compiler library, interfaces, headers, and other executables are in ghc.
  rm "$pkgdir"/usr/lib/libHSghc-$pkgver-ghc$pkgver.so
  rm -r "$pkgdir"/usr/lib/ghc-$pkgver "$pkgdir"/usr/bin

  # docs moved to ghc-static, man pages moved to ghc
  rm -r "$pkgdir"/usr/share/{man,doc}

  install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
