# Maintainer: George Rawlinson <grawlinson@archlinux.org>
# Maintainer: Caleb Maclennan <caleb@alerque.com>

pkgname=git-bug
pkgver=0.11.0
pkgrel=2
pkgdesc='Distributed, offline-first bug tracker embedded in git repositories'
arch=(x86_64)
url='https://github.com/MichaelMure/git-bug'
license=(GPL-3.0-only)
depends=(glibc git)
makedepends=(go pnpm)
options=(!lto)
source=("git+$url#tag=v$pkgver")
sha512sums=('8657e47d941599d5999db81b10878c2c48525560c4f8af772f9b4a0667bdaf07de7ef72edc8addb50aaf6838e0f676f00ab8c57e9ee025e06afc68398a5aa6c9')
b2sums=('ba28e0d29c919c15a069de6fd0c3e377c86e031397ae186fd80b6d8e98ca45a5a8ee1d587a0720ba569f55a3e2d9cbba541903046434a793b265c127f7d0bf3c')

prepare() {
  cd "$pkgname"

  # create directory for build output
  mkdir build

  # download go dependencies
  export GOPATH="${srcdir}"
  go mod download

  # download pnpm dependencies
  cd webui
  pnpm install
}

build() {
  cd "$pkgname"

  # build webui
  pushd webui
  pnpm build
  popd

  # set Go flags
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"

  go generate

  go build -v \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-compressdwarf=false \
    -linkmode external \
    -extldflags '${LDFLAGS}'\
    -X main.version=${pkgver}" \
    -tags "webui" \
    -o build \
    .
}

package() {
  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" build/git-bug

  # man pages
  install -vDm644 -t "$pkgdir/usr/share/man/man1" doc/man/*.1

  # shell completion
  install -vDm644 misc/completion/bash/git-bug "$pkgdir/usr/share/bash-completion/completions/$pkgname"
  install -vDm644 misc/completion/fish/git-bug "$pkgdir/usr/share/fish/vendor_completions.d/$pkgname.fish"
  install -vDm644 misc/completion/zsh/git-bug "$pkgdir/usr/share/zsh/site-functions/_$pkgname"

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname/" README.md
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname/md/" doc/md/*.md
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname/assets/" doc/assets/*.png
}
