# Maintainer: Caleb Maclennan <caleb@alerque.com>
# Contributor: Simon Legner <Simon.Legner@gmail.com>

pkgname=git-revise
pkgdesc='A git subcommand to efficiently update, split, and rearrange commits'
pkgver=0.8.0
pkgrel=2
url="https://mystor.github.io/$pkgname.html"
_url="https://github.com/mystor/$pkgname"
arch=(any)
license=(MIT)
depends=(git
         python)
makedepends=(git
             python-{build,installer,wheel}
             python-hatchling)
source=("git+$_url.git#tag=v$pkgver")
sha256sums=('b30583736edd23ac3304d2e6393512d2c787e0a5e5ce7dd91c5e278ce193c569')

build() {
	cd "$pkgname"
	python -m build -wn
}

package() {
	cd "$pkgname"
	python -m installer -d "$pkgdir" dist/*.whl
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
