# Contributor: Eric Bélanger <eric@archlinux.org>

pkgname=gitg
pkgver=50
pkgrel=1
epoch=2
pkgdesc="GNOME GUI client to view git repositories"
url="https://wiki.gnome.org/Apps/Gitg"
arch=(x86_64)
license=(GPL-2.0-or-later)
depends=(
  cairo
  dconf
  gdk-pixbuf2
  glibc
  glib2
  gpgme
  gsettings-desktop-schemas
  gspell
  gtk3
  gtksourceview4
  hicolor-icon-theme
  json-glib
  libgcc
  libgee
  libgirepository
  libgit2-glib
  libhandy
  libpeas
  libsecret
  libxml2
  pango
)
makedepends=(
  git
  gobject-introspection
  meson
  python-gobject
  vala
)
optdepends=('python-gobject: Python extension support')
source=(
  "git+https://gitlab.gnome.org/GNOME/gitg.git#tag=v$pkgver"
  0001-Fixes-to-build-on-fedora-43.patch
)
b2sums=('1c386c2e437bb500a81283b3b2aee9c12f45e26d713a173bebd702e0ae58552e005f052f22ec723481e858c595ce9d1482f762499239953f3dee5eedaf2ea8b5'
        '26cdff516457c876c555376bcab1921acafccfc0b7c5a5dbef4e500e7bcd5a6f13ccb69c6ed7776388e1574a6f3bea321addeb7fcdbc16a1e198531b349aa451')

prepare() {
  cd gitg

  # Fix build with libpeas 1.38
  git apply -3 ../0001-Fixes-to-build-on-fedora-43.patch
}

build() {
  arch-meson gitg build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}

# vim:set sw=2 sts=-1 et:
