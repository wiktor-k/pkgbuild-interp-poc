# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=gloobus-preview
pkgver=0.5
pkgrel=1
pkgdesc='Application designed to enable a full screen preview of any kind of file'
arch=(x86_64)
url='https://launchpad.net/gloobus-preview'
license=(GPL-3.0-or-later)
depends=(
  bash
  cairo
  freetype2
  gdk-pixbuf2
  glib2
  glibc
  gst-plugins-base
  gst-plugins-base-libs
  gstreamer
  gtk3
  gtksourceview4
  hicolor-icon-theme
  libgcc
  libstdc++
  libx11
  pango
  poppler-glib
  python
  python-gobject
)
makedepends=(
  autoconf-archive
  boost
  djvulibre
  git
  libgxps
  libspectre
)
optdepends=(
  'djvulibre: Preview DjVu documents'
  'gst-libav: Extra media codecs'
  'gst-plugins-bad: Extra media codecs'
  'gst-plugins-good: Extra media codecs'
  'gst-plugins-ugly: Extra media codecs'
  'imagemagick: Support for more image formats'
  'libgxps: Preview XPS documents'
  'libreoffice: Preview LibreOffice compatible documents'
  'libspectre: Preview PostScript documents'
)
_commit=cac40fb544ada4a887ead37af0601e538b91313d # main
source=("git+https://git.launchpad.net/gloobus-preview#commit=$_commit")
b2sums=(3faec91ca533a9be0d96c658e181cf4bbd6d6f9fab7fa456ab0f66135dec5b314c733e0173ca48c0a940e54e27c51414bd6d449169b9693ca318025befe0f2ad)

prepare() {
  cd $pkgname
  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
