pkgname=gnome-shell-extension-arc-menu
_pkgname=ArcMenu
pkgver=70.0
pkgrel=1
pkgdesc='Application menu extension for GNOME Shell'
arch=(any)
url='https://gitlab.com/arcmenu/ArcMenu'
license=(GPL-2.0-or-later)
depends=(
  gnome-menus
  gnome-shell
)
makedepends=(git)
source=("git+https://gitlab.com/arcmenu/$_pkgname.git#tag=v$pkgver")
b2sums=(977e3808dc6e2da123367d46ae3b27ab27f5e639e42f3afcffe5882f356207062daf9ad8f5e42c5fbbdcd05a0a22295440bca62f24a8c90f3c226ed37495f61f)

build() {
  cd $_pkgname
  make
}

package() {
  cd $_pkgname
  make VERSION="$pkgver" DESTDIR="$pkgdir" install
}
