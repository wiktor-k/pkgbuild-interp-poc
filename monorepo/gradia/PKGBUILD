# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=gradia
pkgver=1.13.0
pkgrel=1
pkgdesc='Screenshot annotation and editing tool'
arch=(x86_64)
url='https://apps.gnome.org/Gradia/'
license=(GPL-3.0-or-later)
groups=(gnome-circle)
depends=(
  dconf
  gdk-pixbuf2
  glib2
  glibc
  graphene
  gtk4
  gtksourceview5
  hicolor-icon-theme
  libadwaita
  libportal
  libsoup3
  pango
  python
  python-cairo
  python-gobject
  python-pillow
  python-pytesseract
)
makedepends=(
  appstream
  blueprint-compiler
  git
  meson
)
source=(
  "git+https://github.com/AlexanderVanhee/Gradia.git#tag=v$pkgver"
  gradia-image-rotation.patch
  gradia-use-libdir.patch
  gradia-tesseract-path.patch
)
b2sums=(
  6208fbc4b5ec3d9ceb730569e6cd5cde3c8c4aae581c93b8fb2f1a9ce494763eb8d15100adabb4640d639457c0ff92ba7dcfe8bb0ffe10f9a3ebcddd78992911
  2f8f817d2e7c9f16828d4538b4612ed55c76b78b5a38279151c3881c6ef87c2af18cc49f7e8cc9f1ef2e60d1c3e1481cc6c65e0f15986c7e403c01169f02d5ff
  e76f06fe05e4dd056678371adde7fc180062202d0aad8e02ba13e0e25c9ef83d62bde3b7c8b4dbaf45dac67867d1e4daf66cc07336dd732289c069e72be1a4f8
  ccd12e15b1c8f731563cdcb306f263510727d6cea6311cc5d5eaba1d633a730dd225a3193ecd8a905869d5bf40e735d9664453c08f19dff99f13ab6180955fc1
)

prepare() {
  cd Gradia

  # Fix rotate buttons rotating in the wrong direction
  # https://github.com/AlexanderVanhee/Gradia/pull/369
  git apply -3 ../gradia-image-rotation.patch

  # Move libgradient_gen.so under /lib
  # https://github.com/AlexanderVanhee/Gradia/pull/376
  git apply -3 ../gradia-use-libdir.patch

  # Substitute prefix for tesseract paths
  # https://github.com/AlexanderVanhee/Gradia/pull/377
  git apply -3 ../gradia-tesseract-path.patch
}

build() {
  arch-meson Gradia build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  python -m compileall -d /usr/share "$pkgdir/usr/share"
  python -O -m compileall -d /usr/share "$pkgdir/usr/share"

  # Remove bundled font
  rm -r "$pkgdir/usr/share/fonts"
}
