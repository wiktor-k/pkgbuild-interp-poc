pkgname=gtranslator
pkgver=51.0
pkgrel=1
pkgdesc='An enhanced gettext po file editor for the GNOME desktop environment'
arch=(x86_64)
url='https://gitlab.gnome.org/GNOME/gtranslator'
license=(GPL-3.0-or-later)
depends=(
  cairo
  dconf
  gettext
  glib2
  glibc
  gtk4
  gtksourceview5
  hicolor-icon-theme
  iso-codes
  json-glib
  libadwaita
  libgcc
  libgda6
  libsoup3
  libspelling
  libxml2
  pango
  sqlite
)
makedepends=(
  appstream
  git
  glib2-devel
  gobject-introspection
  meson
  yelp-tools
)
source=("git+https://gitlab.gnome.org/GNOME/$pkgname.git#tag=${pkgver/[a-z]/.&}")
b2sums=('b9f0d94ab697b8b13151e94635ae78b365c4aa1dba3ad6e567a195a09a1823ed5ac1eb226b9537edc0bf70c198d90a0206d7817c45153b536b4f5adf11aabbdb')

prepare() {
  cd $pkgname
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
