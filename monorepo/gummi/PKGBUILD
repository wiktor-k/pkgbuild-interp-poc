pkgname=gummi
pkgver=0.8.3
pkgrel=4
epoch=2
pkgdesc='Simple LaTeX editor'
arch=(x86_64)
url='https://alexandervdm.github.io/gummi/'
license=(MIT)
depends=(
  bash
  cairo
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  gtksourceview4
  gtkspell3
  libgcc
  libsynctex
  pango
  poppler-glib
  texlive-latex
)
makedepends=(
  git
  intltool
)
source=(
  "git+https://github.com/alexandervdm/gummi.git#tag=$pkgver"
  gummi-fix-close-prefs.patch
  gummi-gcc15.patch
  gummi-gtksourceview4.patch
  app.gummi.gummi.appdata.xml
)
b2sums=(
  6a0f90a007b2b10f84ccb5ae1c765640d104573479f6dc501865ed2c5d055bfd2e08c95e5af628e579e6e13a9051f8097795cb0f18118b029e4d9f40b90ecb5d
  aa27ede2d6b2984fca27b3c007f50536cc8080817b6dc0795125477ffad7407d98d2c614b1906a4ea28887008cb30b465d753ac5a1e6658a4bbafc932aa67932
  246713c129b9476043fd33adf54f5becc7d6a8294dc5118f4cbc79e468341588050adde5102fdf48c8f97fc573c5dc835cfa4651e8262fb8863ac374e164207a
  11500ed2a2c530c0f4944fbe4ad77886b70f77b98256e71fa7a4ff71028d471d8b4f4dc0834993a1343fec9674ee244f3e8c49fd4318e7940c553fb37979b8d4
  60a90843c49b1eb96ac61774fabf76f37b67b8e94873867b391cab2578c1117874566205467b771a35c9f9caa9ed3f83cc7788a5f36c8e096f99021df2eb1f26
)

prepare() {
  cd $pkgname

  # Add proper handler for delete-event
  # https://github.com/alexandervdm/gummi/pull/204
  git apply -3 ../gummi-fix-close-prefs.patch

  # Fix build with GCC-15
  # https://github.com/alexandervdm/gummi/pull/205
  git apply -3 ../gummi-gcc15.patch

  # Port to gtksourceview-4
  # https://github.com/alexandervdm/gummi/pull/206
  git apply -3 ../gummi-gtksourceview4.patch

  # Install icon into hicolor directory
  # https://github.com/alexandervdm/gummi/pull/207
  sed -i 's|$(datadir)/pixmaps|$(datadir)/icons/hicolor/512x512/apps|' data/icons/Makefile.am

  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" COPYING
  install -Dm644 -t "$pkgdir/usr/share/metainfo/" ../app.gummi.gummi.appdata.xml
}
