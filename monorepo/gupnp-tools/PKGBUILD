# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=gupnp-tools
pkgver=0.12.4
pkgrel=1
pkgdesc='Utilities and demos to work with UPnP'
arch=(x86_64)
url='https://wiki.gnome.org/Projects/GUPnP'
license=(GPL-2.0-or-later)
depends=(
  gdk-pixbuf2
  glib2
  glibc
  gssdp
  gtk3
  gtksourceview4
  gupnp
  gupnp
  gupnp-av
  hicolor-icon-theme
  libgcc
  libsoup3
  libxml2
)
makedepends=(
  git
  meson
)
source=("git+https://gitlab.gnome.org/GNOME/gupnp-tools.git#tag=$pkgname-$pkgver")
b2sums=(1bd208d4f4aae6d88b9c8af183c0113d2713a9ab7baaa71bd6283633f4a88411398a65c9e22c9322010e521991b19eacc30ac9c816344f556332a1039e5c1a77)

prepare() {
  cd $pkgname
  sed -i '/-Werror/d' meson.build
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
