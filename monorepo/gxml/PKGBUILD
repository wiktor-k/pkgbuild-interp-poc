# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=gxml
pkgver=0.20.4
pkgrel=1
pkgdesc='GObject-based XML parser and writer library'
arch=(x86_64)
url='https://gitlab.gnome.org/GNOME/gxml'
license=(LGPL-2.1-or-later)
depends=(
  glib2
  glibc
  libgee
  libxml2
)
makedepends=(
  git
  gobject-introspection
  meson
  vala
)
source=("git+https://gitlab.gnome.org/GNOME/gxml.git?signed#tag=$pkgver")
b2sums=(38914cfdd5ef5af5066529e0d0e886a865baad0f1bfe4157fffe4ecb9cc244b7a2b949d8c96853485931b7a41a0bc4afb45a0327e5b6d51f847cbdee9e10cb27)
validpgpkeys=(34772C3AD2AC0F15951DC5B48F896B567D50D20F) # Daniel Espinosa Ortiz <esodan@gmail.com>

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  # Serialization test fails with GLib 2.84, see: https://gitlab.gnome.org/GNOME/gxml/-/work_items/49
  meson test -C build --print-errorlogs --exclude serialization
}

package() {
  meson install -C build --destdir "$pkgdir"
}
