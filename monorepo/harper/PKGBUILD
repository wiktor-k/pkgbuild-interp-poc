# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=2.13.0
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('7eedcd82a6bd4eef01db1868c6030f1b76147f1a11f85f5f8dda61347e6fbff47aad7287eb370b1ed08b78d68391ed38c486acf3355ef69e241ef882a2ef5431')
b2sums=('8713b28b0f3f06e1ae2d548ea58cd8af1981bfe3b3024f6cc50753204e6e8c679fc8302c45da8ff7f238a09c5fb1337179ba2bb224c02ddcc3e02c7515272333')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

