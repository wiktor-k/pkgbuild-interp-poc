# Maintainer: George Rawlinson <grawlinson@archlinux.org>
# Contributor: aulonsal <aulonsal at gmail dot com>

pkgname=hck
pkgver=0.11.6
pkgrel=1
pkgdesc='A drop in replacement for cut that can use a regex delimiter instead of a fixed string'
arch=(x86_64)
url='https://github.com/sstadick/hck'
license=(Unlicense MIT)
depends=(glibc libgcc)
makedepends=(git rust cmake)
options=(!lto)
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha512sums=('bc83f6a3522533b8e4e1e31450b74d3b1cefbe2af9a3d6bac1b7fcbd78749c69950a9f0890424a080317e76c122449cf6490219c7b7986071a6400c7f6698868')
b2sums=('fe4deb6d7358d2427a9b1ee956d9ffe374e929aec29652793956000dd68a65ec60671cf9f32b9b58b6330f67072c85a3ce9949ee79efa8cbc4a4b03f252a562f')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target $(rustc --print host-tuple)
}

build() {
	cd "$pkgname"

	cargo build --release --frozen
}

check() {
	cd "$pkgname"

	cargo test --frozen
}

package() {
	cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" target/release/hck

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md

  # licenses
	install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE-MIT UNLICENSE
}
