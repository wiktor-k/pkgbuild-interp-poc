	optdepends = haskell-language-server: for Haskell language support
	optdepends = julia: for Julia language support
	optdepends = lua-language-server: for Lua language support
	optdepends = marksman: for Markdown language support
	optdepends = python-lsp-server: for Python language support
	optdepends = r: for R and rmarkdown language support
	optdepends = racket: for racket language support
	optdepends = rust-analyzer: for Rust language support
	optdepends = taplo: for TOML language support
	optdepends = texlab: for LaTeX language support
	optdepends = typescript-language-server: for jsx, tsx, typescript language support
	optdepends = typst-lsp: for Typst language support
