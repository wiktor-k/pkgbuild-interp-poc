	optdepends = vscode-css-languageserver: for CSS and SCSS support
	optdepends = vscode-html-languageserver: for HTML language support
	optdepends = vscode-json-languageserver: for JSON language support
	optdepends = yaml-language-server: for YAML language support
	optdepends = zls: for Zig language support
	optdepends = xclip: for the x11 clipboard
	optdepends = xsel: for the x11 clipboard
	optdepends = wl-clipboard: for the wayland clipboard
