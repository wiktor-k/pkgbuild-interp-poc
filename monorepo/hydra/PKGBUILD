pkgname=hydra
pkgver=9.7
pkgrel=1
pkgdesc='Very fast network logon cracker which support many different services'
url='https://github.com/vanhauser-thc/thc-hydra'
arch=('x86_64')
license=('AGPL-3.0-or-later')
depends=(
  afpfs-ng
  apr
  bash
  glibc
  libfbclient
  libgcrypt
  libidn
  libmemcached
  mongo-c-driver
  openssl
  pcre2
  subversion
  zlib
)
makedepends=(
  freerdp
  libssh
  mariadb-libs
  ncurses
  postgresql-libs
)
source=(${url}/archive/v${pkgver}/thc-hydra-v${pkgver}.tar.gz)
sha512sums=('daec8101ed5bd0889280cbb5ceeb6278fc704fa0c82a22da68d2b5ab3150e0eceffc16c4f5fcb929de849446616bb508309e6a917a410e57cc528371927feae3')
b2sums=('1c806770947e8ddd693300754d647677f551c70f2a0b4b185bc004fbe7d4e8675bf29f35b9a9e1c3e9245e87065f01480f6c97a6af581f302be322f5b7d3fa7a')

build() {
  cd thc-hydra-${pkgver}
  ./configure --fhs
  make
}

package() {
  depends+=(
    freerdp libfreerdp3.so libwinpr3.so
    libssh libssh.so
    mariadb-libs libmariadb.so
    ncurses libncursesw.so
    postgresql-libs libpq.so
  )

  cd thc-hydra-${pkgver}
  make DESTDIR="${pkgdir}" MANDIR=/share/man/man1 DATADIR=/share/hydra install
  install -vDm 644 README -t "${pkgdir}/usr/share/doc/${pkgname}"
  rm -v "${pkgdir}"/usr/share/man/man1/xhydra.1
}

