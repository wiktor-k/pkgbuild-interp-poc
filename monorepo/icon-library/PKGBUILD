# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=icon-library
pkgver=0.0.23
pkgrel=1
pkgdesc='Find the right icon to use on your GNOME application'
arch=(x86_64)
url='https://gitlab.gnome.org/World/design/icon-library'
license=(GPL-3.0-or-later)
depends=(
  dconf
  glib2
  glibc
  gtk4
  gtksourceview5
  hicolor-icon-theme
  libadwaita
  libgcc
)
makedepends=(
  appstream
  git
  meson
  rust
)
source=(
  "git+https://gitlab.gnome.org/World/design/icon-library.git#tag=$pkgver"
  icon-library-fix-tests.patch
)
b2sums=(
  9f9c151e5e9d384c0c024c2152165a18ee0f8781d6fe31fddcd7227d2f0de17db9c2ba889111d0d62dd2dccf403d14afa399d781213156a5420a6a6495dbb86c
  6ee23e4acafa1572672aee30eff9f5aa5422ca88b50eda31de9afd8640f6344b06e3deac562783b1f31902e5182bc88ce3211d85c484f17ddf8a9678403a2767
)

prepare() {
  cd $pkgname

  CARGO_HOME="$srcdir/build/cargo-home" \
    cargo fetch --target "$(rustc --print host-tuple)"

 # Fix running test out of tree
 # https://gitlab.gnome.org/World/design/icon-library/-/merge_requests/123
 git apply -3 ../icon-library-fix-tests.patch
}

build() {
  arch-meson $pkgname build

  CARGO_PROFILE_RELEASE_LTO=true \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
    CARGO_PROFILE_RELEASE_DEBUG=2 \
    CARGO_PROFILE_RELEASE_STRIP=false \
    meson compile -C build
}

check() {
  meson test -C build --print-errorlogs --no-rebuild
}

package() {
  meson install -C build --destdir "$pkgdir" --no-rebuild
}
