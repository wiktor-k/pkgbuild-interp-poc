# Maintainer: Santiago Torres-Arias <santiago@archlinux.org>
# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=in-toto
pkgver=3.1.0
pkgrel=1
pkgdesc="A framework to secure your software supply chain"
arch=('any')
license=('Apache-2.0')
url="https://in-toto.io"
depends=(
  'python'
  'python-attrs'
  'python-cryptography'
  'python-dateutil'
  'python-iso8601'
  'python-pathspec'
  'python-securesystemslib'
)
makedepends=(
  'git'
  'python-build'
  'python-hatchling'
  'python-installer'
  'python-wheel'
)
optdepends=("gnupg: pgp signing/verification")
source=("git+https://github.com/in-toto/in-toto.git#tag=v$pkgver")
b2sums=('c9395ea4d14f7d9da03add71663eac4e5b4544648b4e3bd37329e906f19942fe5108f113f67a9e775186fa1110f4cb68966d4ab9bd737f9f8a345438aa9f77bc')
validpgpkeys=(
  "903BAB73640EB6D65533EFF3468F122CE8162295" # Santiago Torres-Arias (upstream co-maintainer)
  "8BA69B87D43BE294F23E812089A2AD3C07D962E8" # Lukas Puehringher (upstream maintainer)
  "E32941299CB8C0D93DCF27ACB83110D012545604" # Aditya Saky (Upstream maintainer)
)

build() {
  cd $pkgname
  python -m build --wheel --no-isolation
}

check() {
  cd $pkgname
  python -m unittest discover -vs tests
}

package() {
  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
