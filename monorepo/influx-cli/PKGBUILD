pkgname=influx-cli
pkgver=2.8.0
_commit_sha=8b962c7
pkgrel=3
pkgdesc='CLI for managing resources in InfluxDB'
arch=('x86_64')
url='https://github.com/InfluxData/influx-cli'
license=('MIT')
makedepends=('go' 'go-tools' 'git')
options=('!lto')
backup=('etc/influxdb/influxdb.conf')
source=("git+https://github.com/influxdata/influx-cli.git#tag=v${pkgver}")
sha256sums=('e1feb0788d3871059f252b9efe382a5d0c5b218ca7aa0e2154981e82ee613dc7')

prepare() {
  cd "$pkgname"
  mkdir -p build
}

build(){
  cd "$pkgname"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw -ldflags=-linkmode=external"
  export CGO_ENABLED=1
  export GOPATH="${srcdir}"
  go build -o build ./cmd/influx
}

check(){
  cd "$pkgname"
  PATH="$(go env GOPATH)/bin:$PATH" go test ./...
}

package(){
  cd "$pkgname"
  install -Dm755 build/influx -t "$pkgdir/usr/bin"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/${pkgname}"
  build/influx completion bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/influx-cli"
  build/influx completion zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_influx-cli"
  # build/influx completion fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/influx-cli.fish"
}
