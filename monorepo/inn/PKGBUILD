prepare() {
  # Do not install the package files as the user and group we also run as.
  patch -Np1 -d $pkgname-$pkgver -i ../$pkgname-2.7.4-disable-installing-files-using-the-owner-and-group-we-also-run-as.patch


  sed --quiet '5,23p' $pkgname-$pkgver/LICENSE > ISC.txt

  cd "$srcdir"/inn-$pkgver

  ./autogen

  # Override unreproducible hostname
  sed -i 's/HOSTNAME=`hostname 2> \/dev\/null || uname -n`/HOSTNAME=archlinux/' configure
  sed -i 's/-ldb/-ldb-5.3/g' configure
}

build() {
  cd "$srcdir"/inn-$pkgver
  CFLAGS+=' -fcommon' # https://wiki.gentoo.org/wiki/Gcc_10_porting_notes/fno_common
  PYTHON=/usr/bin/python ./configure --prefix=/usr \
  --bindir=/usr/bin \
  --exec-prefix=/usr \
  --includedir=/usr/include \
  --sbindir=/usr/bin \
  --with-libtool \
  --with-gnu-id \
  --with-bdb-include=/usr/include/db5.3 \
  --with-db-dir=/var/db/inn \
  --sysconfdir=/etc/inn \
  --with-spool-dir=/var/spool/inn \
  --with-log-dir=/var/log/inn \
  --with-run-dir=/var/run/inn \
  --with-tmp-dir=/var/spool/inn/tmp \
  --enable-largefiles \
  --with-openssl=/usr \
  --with-perl \
  --with-python \
  --with-sendmail=/usr/bin/msmtp \
  --with-sasl=/usr \
  --with-news-user=news \
  --with-news-group=news \
  --with-news-master=news

  # prevent excessive overlinking due to libtool
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

package() {
  cd "$srcdir"/inn-$pkgver
  make DESTDIR="$pkgdir" install

  # Change the mode of all executables, so that they are automatically stripped.
  find "$pkgdir/usr/bin" -type f -exec chmod 0755 {} \;

  # Change the mode of all shared objects, so that they are automatically stripped.
  find "$pkgdir/usr/lib" -type f -iname "lib*.so*" -exec chmod 0755 {} \;

  # Move `archive` executable to `archive.inn`, as it otherwise conflicts with archivetools.
  mv --verbose "$pkgdir/usr/bin/archive" "$pkgdir/usr/bin/archive.inn"
  mv --verbose "$pkgdir/usr/share/man/man8/archive.8" "$pkgdir/usr/share/man/man8/archive.inn.8"

  # Remove /var/run (we are using /run).
  rm --force --recursive --verbose "$pkgdir/var/run/"

  # Remove auto-created contents of /var/.
  # We are creating them on first installation and manage their mode/ownership with tmpfiles.d.
  # They should not be part of the package, as they reside in the variable data dir.
  rm --force --recursive --verbose "$pkgdir/var/"

  # Move http dir to data dir.
  install -vdm 755 "$pkgdir/usr/share/$pkgname/"
  mv --verbose "$pkgdir/usr/http" "$pkgdir/usr/share/$pkgname/"

  # Move documentation to correct location.
  install -vdm 755 "$pkgdir/usr/share/doc"
  mv --verbose "$pkgdir/usr/doc" "$pkgdir/usr/share/doc/$pkgname"

  install -vDm 644 ../ISC.txt -t "$pkgdir/usr/share/licenses/$pkgname/"

  install -vDm 755 ../inn-first-run -t "$pkgdir/usr/share/libalpm/scripts/"
  install -vDm 644 ../inn-create-database.hook -t "$pkgdir/usr/share/libalpm/hooks/"
  install -vDm 644 ../innd.service -t "$pkgdir"/usr/lib/systemd/system/
  install -vDm 644 ../inn.sysusers "$pkgdir"/usr/lib/sysusers.d/inn.conf
  install -vDm 644 ../inn.tmpfiles "$pkgdir"/usr/lib/tmpfiles.d/inn.conf
}
