# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=ipxe
pkgver=2.0.0
pkgrel=2
pkgdesc="Network bootloader"
arch=(x86_64)
url="https://ipxe.org/"
_url=https://github.com/ipxe/ipxe
license=(
  0BSD
  GPL-2.0-or-later
  LicenseRef-UBDL
)
makedepends=(cdrtools)
optdepends=(
  'bash: for run_ipxe'
  'qemu-desktop: for run_ipxe'
  'edk2-ovmf: for run_ipxe'
)
# the TLS chain of trust is described at the upstream letsencrypt website:
# https://letsencrypt.org/certificates/
# the code signing setup is described in Arch Linux's releng repository:
# https://gitlab.archlinux.org/archlinux/releng/-/blob/master/README.rst#code-signing
source=(
  $pkgname-$pkgver.tar.gz::$_url/archive/refs/tags/v$pkgver.tar.gz
  arch.ipxe
  isrgrootx1.pem
  lets-encrypt-r3.pem
  codesigning_pierre_archlinux_{2026,2036}.pem
  remote.ipxe
  general.h
  run_$pkgname
  LICENSE
)
