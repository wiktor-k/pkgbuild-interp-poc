# Maintainer: Alexander F. Rødseth <xyproto@archlinux.org>
# Contributor: Marcello Haddeman <haddemanmarcello@gmail.com>

pkgname=ironwail
pkgver=0.8.2
pkgrel=3
pkgdesc='Quake engine based on QuakeSpasm'
arch=(x86_64)
url='https://github.com/andrei-drexler/ironwail'
license=(GPL-2.0-or-later)
depends=(curl flac glibc libglvnd libvorbis libxmp mpg123 opusfile sdl2)
makedepends=(gendesk)
optdepends=('quake: quake command and desktop shortcut'
            'librequake: open source quake resources')
provides=(quake-engine)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
b2sums=('62d8383a5bbc02df56351dbc32464dd632b937351fec13ac159c43373b21687e2a03c401439f0af8ef61d8efcb2bef6ab8b21e6d388c5f84442580baac711b85')

prepare() {
  gendesk -f -n --pkgname "$pkgname" --name Ironwail --pkgdesc "$pkgdesc" --categories 'Game;Shooter'

  cd $pkgname-$pkgver/Quake
  sed -i 's|host_parms->basedir = cwd;|host_parms->basedir = "/usr/share/librequake";|' sys_sdl_unix.c
  sed -i 's|"%s/" ENGINE_PAK, host_parms->basedir|"/usr/share/ironwail/" ENGINE_PAK|' common.c
}

build() {
  make -C $pkgname-$pkgver/Quake \
    MP3LIB=mpg123 \
    STRIP=: \
    USE_CODEC_FLAC=1 \
    USE_CODEC_OPUS=1 \
    USE_CODEC_XMP=1 \
    VORBISLIB=vorbis
}

package() {
  cd $pkgname-$pkgver

  install -Dm755 Quake/ironwail "$pkgdir/usr/bin/ironwail"
  install -Dm644 Quake/ironwail.pak "$pkgdir/usr/share/ironwail/ironwail.pak"

  install -Dm644 ../$pkgname.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 Misc/QuakeSpasm_512.png "$pkgdir/usr/share/pixmaps/$pkgname.png"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
