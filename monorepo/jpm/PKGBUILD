# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=jpm
pkgver=1.2.0
pkgrel=1
pkgdesc='Janet Project Manager'
arch=(any)
url='https://github.com/janet-lang/jpm'
license=(MIT)
depends=(janet)
makedepends=(git)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('bc602cf49389717843ffb5e813ba49f7110624035cf7f6910e09775c0c5f5d7c90a87c24fc2b3d37be92e4f3faf1e7872328bbdec22f94d84e37495e169efa66')
b2sums=('7c8202adc2c41bb0c9645e40e54d2364f4a3708a7666b3181e3dada6d9613640a4f1fe18a73da293a9aa0825cb2ee859126c281be5cd1107bfe71d525fc804ce')

package() {
  cd "$pkgname"

  DESTDIR="$pkgdir" PREFIX=/usr janet bootstrap.janet

  # remove empty directory
  rmdir "$pkgdir/usr/include"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
