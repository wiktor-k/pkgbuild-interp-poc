# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>
# Contributor: Specter119 <spcter119 AT gmail.com>

pkgname=jupyterlab-lsp
pkgver=5.3.0
pkgrel=1
pkgdesc="Coding assistance for JupyterLab with Language Server Protocol."
arch=(any)
url="https://github.com/jupyter-lsp/jupyterlab-lsp"
license=(BSD-3-Clause)
depends=(
  python
  jupyter-lsp
  jupyterlab
)
makedepends=(
  python-build
  python-installer
  python-setuptools
  python-wheel
  npm
  yarn
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
b2sums=('2160aa4f4dfc744f1d20c7d5f1eb7952d390960e4f59a757ca87b9a501bbd38f8c23d9fac517223d520db2db86269bc64950f8e2b691e0c17cfd09611bfe5295')

build() {
  cd $pkgname-$pkgver/python_packages/jupyterlab_lsp
  jlpm install
  jlpm build
  python -m build --wheel --no-isolation
}

package() {
  cd $pkgname-$pkgver/python_packages/jupyterlab_lsp
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
