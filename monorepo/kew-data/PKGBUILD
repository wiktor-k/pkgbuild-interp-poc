# Maintainer: Robin Candau <antiz@archlinux.org>

pkgname=kew-data
pkgver=1.0.0
pkgrel=1
pkgdesc="Artist information database for kew"
url="https://codeberg.org/ravachol/kew-data"
arch=('any')
license=('GPL-2.0-or-later AND CC-BY-SA-4.0')
depends=('kew')
makedepends=('python')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha512sums=('dd313315364d4f16bdac7461505527eef7360b291c9de37acf0d5117f290c78f3f81d6a9f1f5e5207e0dc47f8d62035ff714e21102ebc587c64d09b2d4caa8e7')

prepare() {
	# Delete the pre-built binary for the database
	# We are re-building it from source in build() instead 
	cd "${pkgname}"
	rm -fv artists.db
}

build() {
	cd "${pkgname}"
	python scripts/make_binary_db.py tsv/artists.tsv artists.db
}

package() {
	cd "${pkgname}"
	make PREFIX=/usr DESTDIR="${pkgdir}" install
}
