# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=klevernotes
pkgver=1.3.1
pkgrel=1
pkgdesc='Note-taking and management application using markdown'
arch=(x86_64)
url='https://apps.kde.org/klevernotes/'
license=(GPL-3.0-or-later)
depends=(
  glibc
  hicolor-icon-theme
  kcolorscheme
  kconfig
  kcoreaddons
  ki18n
  kiconthemes
  kio
  kirigami
  kirigami-addons
  kitemmodels
  libstdc++
  qqc2-desktop-style
  qt6-base
  qt6-declarative
  qt6-webchannel
  qt6-webengine
)
makedepends=(
  cmake
  extra-cmake-modules
  git
  ninja
)
source=("git+https://invent.kde.org/office/klevernotes.git?signed#tag=v$pkgver")
b2sums=('504b357ad6e126752e8894899c1571c486226e5575fb6c85ec15d50fd7e934125881d20a8f0ebf3cf94f3ab2fb0854e0d0dd4bb585f962e1de9e942f97e56a7e')
validpgpkeys=(311DA4D94B93A7AEA0496DAF5F812C367AC0A802) # Louis Schul <schul9louis@gmail.com>

build() {
  cmake -S $pkgname -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_BUILD_TYPE=None
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
