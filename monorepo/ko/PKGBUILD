# Maintainer: Christian Rebischke <chris.rebischke@archlinux.org>

pkgname=ko
pkgver=0.19.1
pkgrel=1
pkgdesc="Build and deploy Go container images"
arch=('x86_64')
url="https://github.com/ko-build/ko"
license=('Apache-2.0')
depends=(
  'glibc'
)
makedepends=(
  'repro-go'
)
options=(!lto)
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/ko-build/ko/archive/refs/tags/v${pkgver}.tar.gz")
sha512sums=('a82cc70db73b42b16206b4514c67b243835a1f0b64f764b9acec93325ed8bb3e83ed2ae3d46e1840d2e181360e03ce7c11beef52c222e401288cd64aece5acc1')
b2sums=('d5340d8323407ade6fcb8c5d303721595c428db43936a92cff32f630b8ec2a15224f55b601635b30e4687399d217672cc2b87c5780e446ad77a5634e1dfb5402')

build() {
  cd "${pkgname}-${pkgver}"
  repro-go build -modcacherw .
}

check() {
  cd "${pkgname}-${pkgver}"
  # currently disabled
  #go test -v -x ./...
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dsm755 ./ko "${pkgdir}/usr/bin/ko"
  mkdir -p "${pkgdir}/usr/share/bash-completion/completions/"
  mkdir -p "${pkgdir}/usr/share/zsh/site-functions/"
  mkdir -p "${pkgdir}/usr/share/fish/vendor_completions.d/"
  ./ko completion > "${pkgdir}/usr/share/bash-completion/completions/ko"
  ./ko completion zsh > "${pkgdir}/usr/share/zsh/site-functions/_ko"
  ./ko completion completion fish > "${pkgdir}/usr/share/fish/vendor_completions.d/ko.fish"
}
