# Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>
# Contributor: hexchain <arch at hexchain.org>
pkgname=krunvm
pkgver=0.2.7
pkgrel=1
pkgdesc="Create microVMs from OCI images"
url='https://github.com/containers/krunvm'
arch=('x86_64')
license=('Apache-2.0')
makedepends=('cargo' 'asciidoctor')
depends=(
  'glibc'
  'libgcc'
  'libkrun'
  'buildah'
)
source=("https://github.com/containers/krunvm/archive/refs/tags/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('1b2a54d670b09a8825a005184f7498a54535f86eb3d35850a37d4702da3121fc')

build() {
    cd "$pkgname-$pkgver"

    make
}

package() {
    cd "$pkgname-$pkgver"

    make DESTDIR="$pkgdir" PREFIX=/usr install
    install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
