# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=kst
pkgver=3.0.0
pkgrel=1
pkgdesc='Fast real-time plotting program with light data analysis capabilities'
arch=(x86_64)
url='https://kst-plot.kde.org/'
license=(GPL-2.0-or-later)
depends=(
  cfitsio
  glibc
  gsl
  hdf5
  hicolor-icon-theme
  libgcc
  libmatio
  libstdc++
  libtiff
  netcdf-cxx
  qt6-base
  qt6-svg
)
makedepends=(
  cmake
  git
  ninja
  qt6-tools
)
source=("git+https://invent.kde.org/graphics/kst-plot.git#tag=$pkgver")
b2sums=(5f747ac7d7488fc42c03cf4e6cfde621b9f49559d4af978e4dbfe4963b17de7815f05325d86d19fdc135c324656ae7fc9f3e45faf2cc25371ac9851c403a819b)

build() {
  cmake -S kst-plot -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
