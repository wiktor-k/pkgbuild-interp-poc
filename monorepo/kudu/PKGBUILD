# Maintainer: Orhun Parmaksız <orhun@archlinux.org>

pkgname=kudu
pkgver=0.4.1
pkgrel=2
pkgdesc="TUI for creating and managing virtual machines on Linux"
arch=('x86_64')
url="https://github.com/pythops/kudu"
license=('GPL-3.0-or-later')
depends=('gcc-libs'
         'glibc'
         'libisoburn'
         'passt'
         'qemu-system-x86')
makedepends=('cargo')
optdepends=('qemu-system-aarch64: AArch64 virtual machine support'
            'qemu-system-riscv: RISC-V virtual machine support'
            'xz: extracting compressed VM images, including FreeBSD images'
            'qemu-ui-egl-headless: headless EGL/OpenGL display support'
            'qemu-ui-gtk: GTK display support'
            'qemu-ui-opengl: OpenGL display support'
            'qemu-ui-sdl: SDL display support'
            'qemu-hw-display-qxl: QXL display device support'
            'qemu-hw-display-virtio-gpu: virtio GPU display device support')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('7290a1368e8ff01e90b68aaf57233bf5c6c949f3b017b7d51f30f6dd8dab749e')
options=('!lto')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --frozen
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm 755 "target/release/$pkgname" -t "$pkgdir/usr/bin"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
}

# vim: ts=2 sw=2 et:
