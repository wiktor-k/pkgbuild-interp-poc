pkgname=kupfer
pkgver=329
pkgrel=3
pkgdesc='Launcher application written in Python. Similar to Gnome-Do / Launchy'
arch=(any)
url='https://kupferlauncher.github.io/'
license=(GPL-3.0-or-later)
depends=(
  bash
  gdk-pixbuf2
  glib2
  gtk3
  hicolor-icon-theme
  libkeybinder3
  libwnck3
  pango
  python
  python-cairo
  python-dbus
  python-gobject
  python-pyxdg
  python-setproctitle
  tinysparql
)
makedepends=(
  git
  intltool
  itstool
  python-docutils
  waf
)
optdepends=(
  'gvfs: Trash plugin'
  'xautomation: Send Keys plugin'
  'libappindicator: StatusNotifierItem support'
  'python-qrcode: Show QRCode plugin'
)
source=("git+https://github.com/kupferlauncher/kupfer.git?signed#tag=v$pkgver")
b2sums=(487aeb5c119f6c8511c1c837c8d91dd7a5fcb410ae2badbca6c7014c4a8dcc4295a7b49e9981b42f6aaf1e11b42636c2c98ee2ed51b55e9b62f8995fa614a81a)
validpgpkeys=(E6B26A59AD3BD80DA22CF54BAFFC8A6894648B15) # Karol Będkowski <karol.bedkowski@gmail.com>

prepare() {
  cd $pkgname

  # Set correct prgname
  # https://github.com/kupferlauncher/kupfer/pull/197
  sed -i 's/set_prgname("Kupfer")/set_prgname("kupfer")/' kupfer/main.py

  # Use libappindicator
  sed -i 's/AyatanaAppIndicator3/AppIndicator3/' kupfer/{,ui/}*.py

  # Unbundle waf
  rm -r waf waflib
}

build() {
  cd $pkgname
  waf configure \
    --prefix=/usr \
    --no-update-mime \
    --no-update-icon-cache
  waf build
}

package() {
  cd $pkgname
  waf install --destdir="$pkgdir"
}
