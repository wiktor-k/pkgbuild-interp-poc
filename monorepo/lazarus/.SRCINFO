pkgbase = lazarus
	pkgver = 4.8
	pkgrel = 1
	url = http://www.lazarus.freepascal.org/
	arch = x86_64
	license = GPL-2.0-or-later
	license = LGPL-2.1-or-later
	license = MPL-1.1
	makedepends = fpc
	makedepends = fpc-src
	makedepends = qt5pas
	makedepends = qt6pas
	makedepends = rsync
	options = !makeflags
	options = libtool
	options = staticlibs
	options = !strip
	source = https://gitlab.com/freepascal.org/lazarus/lazarus/-/archive/lazarus_4_8/lazarus-lazarus_4_8.tar.bz2
	sha512sums = 461551b197d41502381be17e80bcb9194350e4c9acc018dc45d06b7d804de17b50fbfdb1b76acfc4ed8ffd8b2b84e9a8725d500084360978aaa4eebb26063dba

pkgname = lazarus
	pkgdesc = Delphi-like IDE for FreePascal common files
	depends = fpc
	depends = fpc-src
	depends = gdb
	optdepends = perl: to run some scripts in the tools directory
	optdepends = qt5pas: to compile Qt5 apps
	optdepends = qt6pas: to compile Qt6 apps

pkgname = lazarus-qt5
	pkgdesc = Delphi-like IDE for FreePascal Qt5 version
	depends = lazarus
	depends = qt5pas
	conflicts = lazarus-gtk2
	conflicts = lazarus-gtk3
	conflicts = lazarus-qt6
	replaces = lazarus-qt
	replaces = lazarus-qt4

pkgname = lazarus-qt6
	pkgdesc = Delphi-like IDE for FreePascal Qt6 version
	depends = lazarus
	depends = qt6pas
	conflicts = lazarus-gtk2
	conflicts = lazarus-gtk3
	conflicts = lazarus-qt5
	replaces = lazarus-gtk3
