# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=lcalc
pkgver=2.2.2
pkgrel=1
pkgdesc='C++ L-function class library and command line interface'
arch=(x86_64)
url='https://gitlab.com/sagemath/lcalc'
license=(GPL-2.0-or-later)
depends=(glibc
         libgcc
         libstdc++
         pari)
makedepends=(gengetopt
             git)
source=(git+https://gitlab.com/sagemath/lcalc#tag=$pkgver)
sha256sums=('3a30bdc2c794a89813bb95e81fb17fe07da9bb07d8b0488060ac31405b316849')

prepare() {
  cd $pkgname
  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --with-pari
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
