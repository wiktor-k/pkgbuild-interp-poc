# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=legba
pkgver=1.3.0
pkgrel=1
pkgdesc="A multiprotocol credentials bruteforcer / password sprayer and enumerator"
url='https://github.com/evilsocket/legba'
arch=('x86_64')
license=(
  'GPL-3.0-only'
)
depends=(
  'glibc'
  'libgcc' 'libgcc_s.so'
)
makedepends=(
  'cargo'
  'clang'
  'cmake'
)
options=('!lto')
source=(https://github.com/evilsocket/${pkgname}/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz)
sha256sums=('92707c3dfd809480714c2b5347d2f6506c8848466986597787671b9ffa8bc461')
b2sums=('29e5f109ab6cc4de48ff71ed2875df35a03809e6b833dc1d8f9f0f3f70b904cf3829a2e9243d1dcbdff1e24109b0cef998888bbb646205cb4ed27c943880951f')

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target host-tuple
}

build() {
  cd ${pkgname}-${pkgver}
  cargo build --frozen --release
}

check() {
  cd ${pkgname}-${pkgver}
  cargo test --frozen
}

package() {
  cd ${pkgname}-${pkgver}
  install -Dm 755 -t "${pkgdir}/usr/bin" \
    target/release/legba
}

