# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=libcoap
pkgver=4.3.5b
pkgrel=1
pkgdesc="A CoAP (RFC 7252) implementation in C"
arch=(x86_64)
url="https://github.com/obgm/libcoap/"
license=(
  BSD-1-Clause
  BSD-2-Clause
  BSD-3-Clause
  LicenseRef-Public-Domain
  LicenseRef-Internet-Society
)
depends=(
  glibc
  openssl
)
makedepends=(
  cmake
  cunit
)
source=("$pkgname-$pkgver.tar.gz::${url}archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('b8fc435412cd1909bc9ba5683cfa138a3ea08a76fecab78739ceedc7bb903d15d50d4362f702f7380fd047e5b6df3c76dfb75dd30bb20670a62205e6bc85021d')
b2sums=('055dd4ae443ca59149a0d8cb812bbb879c594c12dc708f62e7e757447c9cbcf1e3c83d55a64ba763fcbdbf75544f41e5da7a23a8fc6eaecd7fa774b562909081')

prepare() {
  sed -n '1,21p' $pkgname-$pkgver/include/coap3/coap_uthash_internal.h > BSD-1-Clause.txt
  sed -n '1,26p' $pkgname-$pkgver/LICENSE > BSD-2-Clause.txt
  sed -n '31,46p' $pkgname-$pkgver/LICENSE > LicenseRef-Public-Domain.txt
  sed -n '61,86p' $pkgname-$pkgver/LICENSE > BSD-3-Clause.txt
  sed -n '133,157p' $pkgname-$pkgver/LICENSE > LicenseRef-Internet-Society.txt
}

build() {
  local cmake_options=(
    -B build
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D DTLS_BACKEND=openssl
    -D ENABLE_EXAMPLES=OFF
    -D ENABLE_TESTS=ON
    -S "$pkgname-$pkgver"
    -W no-dev
  )

  cmake "${cmake_options[@]}"
  cmake --build build --verbose
}

check() {
  "./build/testdriver"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -vDm 644 ./*.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
