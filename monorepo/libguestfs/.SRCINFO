	optdepends = exfatprogs: for exFAT support in the VM appliance
	optdepends = f2fs-tools: for F2FS support in the VM appliance
	optdepends = gptfdisk: for GPT disk support in the VM appliance
	optdepends = iproute2: for iproute2 tools in the VM appliance
	optdepends = iputils: for iputils tools in the VM appliance
	optdepends = jfsutils: for JFS support in the VM appliance
	optdepends = less: for less tool in the VM appliance
	optdepends = libldm: for Microsoft Dynamic Disk support in the VM appliance
	optdepends = lrzip: for ZIP support in the VM appliance
	optdepends = lsof: for making lsof available in the VM appliance
	optdepends = lsscsi: for listing SCSI devices in the VM appliance
	optdepends = lvm2: for LVM2 block device support in the VM appliance
	optdepends = lzop: for LZO compression support in the VM appliance
	optdepends = mdadm: for MD-RAID support in the VM appliance
	optdepends = mtools: for MS-DOS disk support in the VM appliance
	optdepends = nilfs-utils: for NILFS support in the VM appliance
	optdepends = ntfs-3g: for NTFS FUSE support in the VM appliance
	optdepends = ntfsprogs: for NTFS support in the VM appliance
	optdepends = openssh: for SSH support in the VM appliance
	optdepends = parted: for partition handling support in the VM appliance
	optdepends = pciutils: for PCI bus support in the VM appliance
	optdepends = procps-ng: for system monitoring support in the VM appliance
	optdepends = psmisc: for procfs support in the VM appliance
	optdepends = rsync: for rsync support in the VM appliance
	optdepends = squashfs-tools: for squashfs support in the VM appliance
	optdepends = strace: for tracing support in the VM appliance
	optdepends = syslinux: for syslinux support in the VM appliance
	optdepends = systemd-sysvcompat: for sysvinit support in the VM appliance
	optdepends = vim: for vim support in the VM appliance
	optdepends = xfsprogs: for XFS support in the VM appliance
	provides = libguestfs.so
	backup = etc/libguestfs-tools.conf

