# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=libhomfly
pkgver=1.04
pkgrel=1
pkgdesc='Library to compute the homfly polynomial of a link'
arch=(x86_64)
url='https://github.com/miguelmarco/libhomfly'
license=(LicenseRef-libhomfly)
depends=(gc
         glibc)
makedepends=(git)
source=(git+https://github.com/miguelmarco/libhomfly#tag=$pkgver)
sha256sums=('7ffd05cd8346db5105f5dd72f9ea4d2273ec3c4bb9eeeee0b564ea0eb55bc0a3')

prepare() {
  cd $pkgname
  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
