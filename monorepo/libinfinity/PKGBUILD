pkgname=libinfinity
pkgver=0.7.2
pkgrel=5
pkgdesc='Library to build collaborative text editors. Includes the infinoted server'
arch=(x86_64)
url="https://gobby.github.io/"
license=(LGPL-2.0-or-later)
depends=(
  avahi
  cairo
  glib2
  glibc
  gnutls
  gsasl
  gtk3
  hicolor-icon-theme
  libdaemon
  libxml2
  pam
  systemd-libs
)
makedepends=(
  git
  gobject-introspection
  gtk-doc
)
source=("git+https://github.com/gobby/libinfinity.git?signed#tag=$pkgver")
b2sums=(4262c085b37318aae720e8985999248cb60f021e035fc7c63bea86dc3d75d9c0be2b87f7608258c7d55ef18ac5631e2e3102fc1eceb2abbe7b8bea2c48697a11)
validpgpkeys=(728834F3B8D552ED25CC1B1FB1C71544BF1D92C7) # Armin Burgmeier <armin@arbur.net>

prepare() {
  cd $pkgname
  glib-gettextize --force --copy
  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --enable-gtk-doc
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
