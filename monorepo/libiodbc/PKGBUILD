pkgname=libiodbc
pkgver=3.52.16
pkgrel=3
pkgdesc='Independent Open DataBase Connectivity for Linux'
arch=('x86_64')
url='http://www.iodbc.org/dataspace/doc/iodbc/wiki/iodbcWiki/'
license=('LGPL-2.0-or-later')
depends=('bash')
makedepends=('chrpath')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/openlink/iODBC/archive/v${pkgver}.tar.gz"
        '0001-Make-compilation-work-with-more-recent-compilers-C23.patch')
sha256sums=('a0cf0375b462f98c0081c2ceae5ef78276003e57cdf1eb86bd04508fb62a0660'
            '416be26957eb0db36eafe82dbc8a453d3b27ef14376ed098e51cc1ae3b412df6')

prepare() {
  cd "iODBC-${pkgver}"

  patch -Np1 < ../0001-Make-compilation-work-with-more-recent-compilers-C23.patch
}

build() {
  cd "iODBC-${pkgver}"

  ./autogen.sh
  ./configure \
    --prefix=/usr \
    --disable-static \
    --includedir=/usr/include/libiodbc \
    --disable-gui \
    --disable-libodbc
  make
}

package() {
  cd "iODBC-${pkgver}"

  make DESTDIR="${pkgdir}" install

  chrpath -d "${pkgdir}"/usr/bin/iodbctest{,w}
  rm -rf "${pkgdir}"/usr/share/libiodbc/
}
