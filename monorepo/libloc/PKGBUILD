# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>
# Contributor: Macxcool <macx cool at tutanota dot com>
# Contributor: loqs

pkgbase=libloc
pkgname=(
  libloc
  libloc-database
  lua-location
  python-location
)
pkgver=0.9.19
pkgrel=1
pkgdesc="IPFire Location Database - Determine the location of someone on the Internet"
url='https://git.ipfire.org/?p=location/libloc.git;a=summary'
arch=('x86_64')
license=('LGPL-2.1-or-later')
makedepends=(
  asciidoc
  intltool
  openssl libcrypto.so
  lua
  python
  systemd
)
source=(https://source.ipfire.org/releases/libloc/libloc-${pkgver}.tar.gz)
sha256sums=('ada280f045010baaef2204470c688f4aa515accfba9bfbcef2e554facb631609')
b2sums=('1eb8cc427bfe7cf5c52640d725d3c564b61fab85190ac516f7ac6245ac05f3202841f9059b62acc9f68ba8c63687b03dc636ea58e0f2341b76e815445c0f347e')

prepare() {
  cd ${pkgbase}-${pkgver}
  intltoolize -f
  autoreconf -fi
}

build() {
  cd ${pkgbase}-${pkgver}
  ./configure --prefix=/usr --localstatedir=/var --disable-perl
  make
}

check() {
  cd ${pkgbase}-${pkgver}
  make -k check
}

package_libloc() {
  depends=(
    glibc
    libcrypto.so
    libloc-database
  )
  provides=(libloc.so)

  cd ${pkgbase}-${pkgver}
  make DESTDIR="${pkgdir}" install

  rm -r \
    "${pkgdir}/usr/bin" \
    "${pkgdir}/usr/lib/lua" \
    "${pkgdir}/usr/lib/python3"* \
    "${pkgdir}/usr/lib/systemd" \
    "${pkgdir}/usr/share/bash-completion" \
    "${pkgdir}/usr/share/man/man1" \
    "${pkgdir}/var"

  install -Dm644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

package_libloc-database() {
  pkgdesc+=' (Database files)'
  license=('CC-BY-SA-4.0')
  install="${pkgname}.install"

  cd ${pkgbase}-${pkgver}
  install -Dm 644 data/database.db "${pkgdir}/usr/share/libloc-location/location.db"
}

package_lua-location() {
  pkgdesc+=' (Lua bindings)'
  depends=(
    glibc
    libloc.so
    lua
  )

  cd ${pkgbase}-${pkgver}
  make DESTDIR="${pkgdir}" install

  rm -r \
    "${pkgdir}/usr/bin" \
    "${pkgdir}/usr/include" \
    "${pkgdir}/usr/lib/libloc.so"* \
    "${pkgdir}/usr/lib/pkgconfig" \
    "${pkgdir}/usr/lib/python3"* \
    "${pkgdir}/usr/lib/systemd" \
    "${pkgdir}/usr/share/bash-completion" \
    "${pkgdir}/usr/share/locale" \
    "${pkgdir}/usr/share/man" \
    "${pkgdir}/var"

  install -Dm644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

package_python-location() {
  pkgdesc+=' (Python tooling)'
  depends=(
    glibc
    libloc.so
    python
    python-psycopg
  )

  cd ${pkgbase}-${pkgver}
  make DESTDIR="${pkgdir}" install

  rm -r \
    "${pkgdir}/usr/include" \
    "${pkgdir}/usr/lib/libloc.so"* \
    "${pkgdir}/usr/lib/lua" \
    "${pkgdir}/usr/lib/pkgconfig" \
    "${pkgdir}/usr/share/locale" \
    "${pkgdir}/usr/share/man/man3" \
    "${pkgdir}/var/lib/location/database.db"

  install -Dm644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

