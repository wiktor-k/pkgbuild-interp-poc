pkgname=libretro-beetle-pce
pkgver=20260926.103044.gb96c11e095b6
pkgrel=1
pkgdesc='NEC PC Engine/SuperGrafx/CD core'
arch=(x86_64)
url=https://github.com/libretro/beetle-pce-libretro
license=(GPL-2.0-only)
groups=(libretro)
depends=(
  glibc
  libgcc
  libretro-core-info
  libstdc++
  zlib
)
makedepends=(git)
source=(libretro-beetle-pce::git+https://github.com/libretro/beetle-pce-libretro.git#commit=${pkgver##*.g})
b2sums=('03241c6ffb1c27c2fc65d4557f9d904910e092de445134bfa30322396f71e1469cea6d79da25ba442dd68d45ea146a6ac957ee58a47122cc654f117d9177b201')

build() {
  make \
    SYSTEM_LIBCHDR=0 \
    SYSTEM_ZLIB=1 \
    -C libretro-beetle-pce
}

package() {
  install -Dm 644 libretro-beetle-pce/mednafen_pce_libretro.so -t "${pkgdir}"/usr/lib/libretro/
}

