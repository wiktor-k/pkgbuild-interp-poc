pkgname=libretro-kronos
pkgver=20260901.155445.g3791ffb2221f
pkgrel=1
pkgdesc='Sega Saturn core'
arch=(x86_64)
url=https://github.com/libretro/yabause
license=(GPL-2.0-only)
groups=(libretro)
depends=(
  glibc
  libgl
  libretro-core-info
)
makedepends=(
  git
  libglvnd
)
source=(libretro-yabause::git+https://github.com/libretro/yabause.git#commit=${pkgver##*.g})
b2sums=('55adf638c9dd134cf63ac73ed3a276c7141d3d6f5c8af265048d8f11c9c7d9bba31555dd197a99643fb28dc08a32c749c79674da54797422216a29ed72c7a959')

build() {
  make -C libretro-yabause/yabause/src/libretro
}

package() {
  install -Dm 644 libretro-yabause/yabause/src/libretro/kronos_libretro.so -t "${pkgdir}"/usr/lib/libretro/
}

