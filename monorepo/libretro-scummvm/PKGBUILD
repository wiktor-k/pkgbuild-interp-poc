pkgname=libretro-scummvm
pkgver=20260919.115140.gfcbce3ae8152
pkgrel=1
pkgdesc='ScummVM core'
arch=(x86_64)
url=https://github.com/libretro/scummvm
license=(GPL-3.0-only)
groups=(libretro)
depends=(
  glibc
  libgcc
  libretro-core-info
  libstdc++
)
makedepends=(git)
options=(!lto)
source=(libretro-scummvm::git+https://github.com/libretro/scummvm.git#commit=${pkgver##*.g})
b2sums=('a0d83549dd9f4fc14ca8bae3eeb7c1ed2dff99137ddceb7cca8082916dd45fc623addb10215c2c9e8916de98dfb05ea7fde52975d71b72b646c00850babdbbc8')

build() {
  make -C libretro-scummvm/backends/platform/libretro
}

package() {
  install -Dm 644 libretro-scummvm/backends/platform/libretro/scummvm_libretro.so -t "${pkgdir}"/usr/lib/libretro/
}

