# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=libxisf
pkgver=0.2.14
pkgrel=1
pkgdesc='Library to load and write XISF format from PixInsight'
url='https://gitea.nouspiro.space/nou/libXISF'
license=(GPL-3.0-only)
arch=(x86_64)
depends=(glibc
         libgcc
         libstdc++
         lz4
         pugixml
         zlib
         zstd)
makedepends=(cmake
             git)
source=(git+https://gitea.nouspiro.space/nou/libXISF#tag=v$pkgver)
sha256sums=('8f3aa999f0160e9d26bce26e4d6ef1d59b8a4f46d06b140a1676d909ad6b37e0')

build() {
  cmake -B build -S libXISF \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DUSE_BUNDLED_LIBS=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
