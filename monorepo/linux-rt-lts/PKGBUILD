pkgbase=linux-rt-lts
pkgver=6.18.58.rt9.arch1
pkgrel=1
pkgdesc='Linux RT LTS'
arch=(x86_64)
url='https://gitlab.archlinux.org/archlinux/packaging/upstream/linux-rt-lts'
makedepends=(
  bc
  binutils
  cpio
  gettext
  glibc
  graphviz  # docs
  imagemagick  # docs
