            'SKIP'
            '04f46c66941abdbd09827200aa24da1d2107dd4470d8f8f252fb12f63c1a1615f862777a9f788507d7716108b7a5cd26507aadd7aad9916eceaf316c8236890b')
sha512sums_x86_64=('bae974e19078bc49561eef620601c1a97114751fef8b65c1ac6cf277d695e5bb4c6b401f496e5ab28f39ba095ef5d3b3772f8da531b414bf4a051ec9f14facc3')
b2sums=('1c6373ec0d436c96431b63d2d5f00eddd3dc9395a85d45a47b2b7500c69c7b814280b7df6769d52a926410493f800a423c382591cd772e580b85431c72341263'
