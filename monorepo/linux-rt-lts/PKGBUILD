        'SKIP'
        '5db5f2040a5ebda158d7989dd655145d7ac150a267334a7763c0e5f6b0dc2b4bfaa1bdd287c0d19c06410022f19fbd97586b1f4376d7dce6cf643563c5d3bb55')
b2sums_x86_64=('a417756950560f4f500eeae42a97218944817f767ecbc1f5d473500f447c7a62a08fa02f2f1dd3c1ae47d2b913ef553dca424e0ff48aeb657e83cb23bd05001d')
validpgpkeys=(
  647F28654894E3BD457199BE38DBBDC86092693E  # Greg Kroah-Hartman <gregkh@linuxfoundation.org>
  D5653EA39C8675DA4BD5971C13B55DD07C53B851  # Clark Williams (Kernel Correspondence) <clrkwllms@kernel.org>
