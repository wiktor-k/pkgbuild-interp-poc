# Maintainer: Daurnimator <daurnimator@archlinux.org>
# Maintainer: Caleb Maclennan <caleb@alerque.com>

pkgname=('lua-argparse' 'lua51-argparse' 'lua52-argparse' 'lua53-argparse' 'lua54-argparse')
pkgver=0.7.2
pkgrel=1
arch=('any')
url='https://github.com/luarocks/argparse'
license=('MIT')
source=("$pkgname-$pkgver.tar.gz::https://github.com/luarocks/argparse/archive/$pkgver.tar.gz")
sha512sums=('6336c1d114daef69bbebb40fc906a0062cd79ad0d9cc6974a3f827fa9904ac0eb0801d758ac60d07bc94603a8c231f62de3b7622ed7095e6fe2696b97f6cbc0c')

package_lua-argparse() {
	pkgdesc='Feature-rich command line parser for Lua 5.5'

	cd "argparse-$pkgver"
	install -Dm644 src/argparse.lua "$pkgdir/usr/share/lua/5.5/argparse.lua"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

