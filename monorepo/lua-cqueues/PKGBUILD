# Maintainer: Daurnimator <daurnimator@archlinux.org>

pkgname=('lua-cqueues' 'lua54-cqueues' 'lua51-cqueues' 'lua52-cqueues' 'lua53-cqueues')
pkgver=20261006
pkgrel=1
arch=('x86_64')
pkgdesc='Continuation Queues: Embeddable asynchronous networking, threading, and notification framework'
url='http://25thandclement.com/~william/projects/cqueues.html'
license=('MIT')
makedepends=('luarocks' 'lua' 'lua54' 'lua51' 'lua52' 'lua53')
depends=('openssl')
source=("$pkgname-$pkgver.tar.gz::https://github.com/wahern/cqueues/archive/rel-$pkgver.tar.gz"
        "https://luarocks.org/manifests/daurnimator/cqueues-$pkgver.5"{1,2,3,4,5}"-0.rockspec")
sha256sums=('4a6d45982ff0b916a7c71fb1a9dacdfcd67f1f0fe828ac0fc669f234d2f8e7c4'
            'b57165550909fef80689bfd3c49c77b5cee6e0b1df6f844b4cffaa5d53acb260'
            '58e7f603d0420dfea26f11679ff2dc8a8543e460d5d05bd2ca7c47aeb07310b1'
            'b335c7e109e08a85b732ad02bc70005014b6705fd537e01f3058a6d60387d572'
            'ece380300726e9d00b63241359eddfd4223e7fb7f276d7699ad34b771b5f2ae9'
            '01fc1fabfb725f9c44d201a6f31237a6ab5ee0abfc23cd31be8351b82a986cd8')
build() {
	cd "cqueues-rel-$pkgver"
	for v in 5.1 5.2 5.3 5.4 5.5; do
		mkdir -p "$v/"
		# Use `-ffile-prefix-map` to avoid embedding srcdir into binary
		# Packed rocks with make backend don't work?
		# Workaround: don't use --pack-binary-rock; instead make into a temporary tree and then pack
		luarocks make --lua-version="$v" --tree="../luarocks-temp-$v" --deps-mode=none \
			CFLAGS="$CPPFLAGS $CFLAGS -fPIC -ffile-prefix-map=$(pwd)=" \
			LIBFLAG="$LDFLAGS -shared" \
			../cqueues-"$pkgver".5${v#5.}-0.rockspec
		luarocks pack --lua-version="$v" --tree="../luarocks-temp-$v" cqueues
		mv cqueues-"$pkgver".*.rock "$v/"
	done
}

package_lua-cqueues() {
	pkgdesc="$pkgdesc for Lua 5.5"
	optdepends=('lua55-luaossl: TLS support')

	cd "cqueues-rel-$pkgver"
	luarocks install --lua-version=5.5 --tree="$pkgdir/usr/" --deps-mode=none 5.5/*.rock --no-manifest
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

