# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=mado
pkgver=0.3.2
pkgrel=1
pkgdesc="A fast Markdown linter written in Rust"
arch=(x86_64)
url="https://github.com/akiomik/mado"
license=(Apache-2.0)
depends=(
  libgcc
  glibc
)
makedepends=(rust)
options=(!lto)
source=(
  $pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz
)
sha512sums=('ce76256c1e3ea20a931d239de80ff2940dd36e3c0e09ea1c2b15a09abf4ef6f77e1fa6aba8a25af6cb447b74bc0b885ad0b6ca44aa40f073704300aa13d754c7')
b2sums=('60b12d5e02bd87e5fa9635e57fa4f8a5a3bb9be94289618924eb1523add2b4a8996c72c825aea191e0eb4d0b0b20e9b93a2dbbe29c3904d383d494f9cb8cfdea')

prepare() {
  cd $pkgname-$pkgver
  cargo fetch --locked --target host-tuple
}

build() {
  cd $pkgname-$pkgver
  cargo build --frozen --release --all-features
}

check() {
  cd $pkgname-$pkgver
  cargo test --frozen --all-features
}

package() {
  cd $pkgname-$pkgver
  install -vDm 755 target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 {{CHANGELOG,README}.md,$pkgname.toml} -t "$pkgdir/usr/share/doc/$pkgname/"
}
