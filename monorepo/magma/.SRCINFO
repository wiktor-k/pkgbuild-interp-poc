pkgbase = magma
	pkgver = 2.10.0
	pkgrel = 1
	url = https://icl.utk.edu/magma/
	arch = x86_64
	license = BSD-3-Clause
	makedepends = git
	makedepends = cmake
	makedepends = ninja
	makedepends = python
	makedepends = gcc-fortran
	makedepends = cuda
	makedepends = rocm-core
	makedepends = rocm-toolchain
	makedepends = hip-runtime-amd
	makedepends = hipblas
	makedepends = hipsparse
	depends = blas
	depends = lapack
	optdepends = python: for examples and tests
	optdepends = gcc-fortran: Fortran interface
	options = !lto
	source = magma::git+https://github.com/icl-utk-edu/magma.git#tag=v2.10.0
	source = magma-cuda-smaller-cuda-binaries.patch::https://github.com/icl-utk-edu/magma/pull/83.patch
