# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>

pkgname=markdownlint-sentences-per-line
pkgver=0.1.7
pkgrel=1
pkgdesc='Markdownlint rule for limiting sentences per line'
arch=(any)
url=https://github.com/JoshuaKGoldberg/sentences-per-line
license=(MIT)
depends=(nodejs)
makedepends=(
  npm
  pnpm
)
optdepends=(
  'markdownlint-cli: use as --rules argument'
  'markdownlint-cli2: use as customRules'
)
options=(!emptydirs)
source=($url/archive/refs/tags/$pkgname@v$pkgver.tar.gz)
b2sums=('194e628576d094aba19e22d32770c7b0bf835af0ac0d9e72673d7cceda64344a03a6d30fa7959f19e010ed00288d63a1bc8328f5d0781cc5a63511af46e715de')

prepare() {
  cd sentences-per-line-$pkgname-v$pkgver
  pnpm install --frozen-lockfile
}

build() {
  cd sentences-per-line-$pkgname-v$pkgver
  pnpm build

  cd packages/$pkgname
  cp package.json{,.bak}
  sed -i 's/workspace:[~^*]/*/g' package.json
  npm pack
  mv package.json{.bak,}
}

check() {
  cd sentences-per-line-$pkgname-v$pkgver
  CI=true pnpm run test
}

package() {
  cd sentences-per-line-$pkgname-v$pkgver
  install -vDm 644 LICENSE.md -t "$pkgdir"/usr/share/licenses/$pkgname/

  cd packages/$pkgname
  npm install -g --prefix "$pkgdir"/usr $pkgname-$pkgver.tgz
}
