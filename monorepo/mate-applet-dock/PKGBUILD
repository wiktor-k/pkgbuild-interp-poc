# Contriburor: Balló György <ballogyor+arch at gmail dot com>

pkgname=mate-applet-dock
_pkgname=mate-dock-applet
pkgver=21.10.0
pkgrel=7
pkgdesc="Application dock for the MATE panel"
arch=(any)
url='https://github.com/ubuntu-mate/mate-dock-applet'
license=(GPL-3.0-or-later)
depends=(
  bamf
  dconf
  gdk-pixbuf2
  glib2
  gtk3
  libnotify
  libwnck3
  mate-panel
  pango
  python
  python-cairo
  python-dbus
  python-distro
  python-gobject
  python-pillow
  python-xdg
  python-xlib
)
makedepends=(git)
source=("git+https://github.com/ubuntu-mate/mate-dock-applet.git#tag=$pkgver")
b2sums=(33c5f7f93ee2444af16d07238597592c3ff0afd365b877c845b788d2016815526f94aa5cf067cd573f98b68be1c3c2921892a1bac40416619695e7ed5b9e5a93)

prepare() {
  cd $_pkgname
  autoreconf -fiv
}

build() {
  cd $_pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --with-gtk3
  make
}

package() {
  cd $_pkgname
  make DESTDIR="$pkgdir" install
}
