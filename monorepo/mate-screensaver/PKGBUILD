# Contributor: Brad Fanella <cesura@archlinux.org>
# Contributor: Martin Wimpress <code@flexion.org>

pkgname=mate-screensaver
pkgver=1.28.1
pkgrel=1
pkgdesc='Screensaver for MATE'
arch=(x86_64)
url='https://github.com/mate-desktop/mate-screensaver'
license=(GPL-2.0-or-later)
depends=(
  cairo
  dbus
  dbus-glib
  dconf
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  libglvnd
  libmatekbd
  libnotify
  libx11
  libxext
  libxklavier
  libxss
  libxxf86vm
  mate-desktop
  mate-menus
  mate-panel
  mate-session-manager
  pam
  pango
  systemd-libs
)
makedepends=(
  git
  glib2-devel
  mate-common
  python-gobject
  xmlto
)
optdepends=('python-gobject: for mate-screensaver-configure command')
groups=(mate-extra)
source=("git+https://github.com/mate-desktop/mate-screensaver.git#tag=v$pkgver")
b2sums=(113f5229e288f0503b6e3c103f70911b9721096f6d9e1a15bed03a808427e4f55d046dd9bc59b209e980a166e42635f4afbbc8ce67a7585335eadb637ba6d8f6)

prepare() {
  cd $pkgname
  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --libexecdir="/usr/lib/$pkgname" \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --enable-docbook-docs \
    --with-xscreensaverdir=/usr/share/xscreensaver/config \
    --with-xscreensaverhackdir=/usr/lib/xscreensaver \
    --without-console-kit
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
