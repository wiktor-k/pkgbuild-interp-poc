# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=mbuffer
pkgver=20261015
pkgrel=1
pkgdesc="A tool for buffering data streams"
arch=(x86_64)
url="https://www.maier-komor.de/mbuffer.html"
license=(GPL-3.0-or-later)
depends=(
  glibc
  libgcc
)
makedepends=(openssl)
source=(
  https://www.maier-komor.de/software/$pkgname/$pkgname-$pkgver.tgz
)
sha512sums=('a88b2f7135298c97a01aef658f8363b3b7b871acc24e1c3643aa39148fe80caed3c2244a31e07c7aed03f49c3ba03b76f78213f086b28f0f68bdb813c28e34e8')
b2sums=('3df1b21f50ea1da526c4832d50e0b7f16cab61ba2a0fe548c09bfbd76cd4321e5915622a6235fa66e665bf2f7a0de3d141c138b3eaea08e4b1ff5f3ade70cd62')

prepare() {
  cd $pkgname-$pkgver
  autoreconf -fiv
}

build() {
  cd $pkgname-$pkgver
  ./configure --prefix=/usr --sysconfdir=/etc
  make
}

check() {
  make -k check -C $pkgname-$pkgver
}

package() {
  depends+=(
    openssl libcrypto.so
  )

  make DESTDIR="$pkgdir/" install -C $pkgname-$pkgver
}
