pkgbase = mediawiki
	pkgdesc = Free and open-source wiki software system
	pkgver = 1.46.2
	pkgrel = 1
	url = https://www.mediawiki.org/wiki/MediaWiki
	install = mediawiki.install
	arch = any
	license = GPL-2.0-or-later
	depends = php
	depends = diffutils
	optdepends = pcre2: for regular expressions support
	optdepends = php-pgsql: for PostgreSQL database support
	optdepends = php-sqlite: for sqlite database support
	optdepends = memcached: for cache support
	optdepends = php-gd: for thumbnails rendering
	optdepends = imagemagick: for thumbnails rendering
	optdepends = smtp-forwarder: for mail sending
	optdepends = python: required for SyntaxHighlight/ConfirmEdit extensions
	optdepends = python-pillow: required for ConfirmEdit extension (creating FancyCaptcha images)
	optdepends = perl: compare_schemas.pl and mediawiki_mysql2postgres.pl
	optdepends = git: hash versions on Special:Version
	options = !strip
	options = !debug
	backup = etc/webapps/mediawiki/LocalSettings.php
	source = https://releases.wikimedia.org/mediawiki/1.46/mediawiki-1.46.2.tar.gz
	source = https://releases.wikimedia.org/mediawiki/1.46/mediawiki-1.46.2.tar.gz.sig
	source = apache.example.conf
