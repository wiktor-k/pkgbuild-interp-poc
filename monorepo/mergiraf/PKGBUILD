# Maintainer: Campbell Jones <serebit at archlinux dot org>
# Contributor: VCalV

pkgname=mergiraf
pkgver=0.20.0
pkgrel=1
pkgdesc='A syntax-aware git merge driver for a growing collection of programming languages and file formats'
arch=(x86_64)
url='https://mergiraf.org/'
license=(GPL-3.0-or-later)
makedepends=(git rust)
checkdepends=(jujutsu)
options=(!lto)
source=("$pkgname::git+https://codeberg.org/mergiraf/mergiraf#tag=v$pkgver")
sha512sums=('b6dd6672b05eedaaf7de45d1012f0141bdb845f8d1ca81029b11d82251a7d19f3072f2bbd21c521d275d1f373a2a3c49d15c650a5f67bd1a41447efd55dfa7b6')
b2sums=('62ffc0b42a7a25c3090cd8b11f7e8470bdd8fcbc8e2f848a932553392dec9609bb9a712a437b7260f3f89c60c30c36356ff72312f3001bec4c2ee9f4e468616a')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release --all-features --bin mergiraf
}

check() {
  cd "$pkgname"

  # See https://codeberg.org/mergiraf/mergiraf/issues/761
  export CFLAGS="${CFLAGS/-O2}"

  cargo test --all-features
}


package() {
  depends+=(
    glibc
    libgcc libgcc_s.so
  )

  cd "$pkgname"

  install -Dm755 -t "$pkgdir/usr/bin" target/release/mergiraf
  
  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE.txt
}
