# Maintainer: Balló György <ballogyor+arch at gmail dot com>
# Contributor: Dimitris Kiziridis <ragouel at outlook dot com>

pkgname=minder
pkgver=2.0.9
pkgrel=2
pkgdesc='Mind-mapping application to create, develop and visualize your ideas'
arch=(x86_64)
url='https://github.com/phase1geo/Minder'
license=(GPL-3.0-or-later)
depends=(
  cairo
  dconf
  gdk-pixbuf2
  glib2
  glibc
  granite7
  graphene
  gtk4
  gtksourceview5
  hicolor-icon-theme
  json-glib
  libarchive
  libgee
  libwebp
  libxml2
  pango
)
makedepends=(
  discount
  git
  meson
  vala
)
source=("git+https://github.com/phase1geo/Minder.git#tag=$pkgver")
b2sums=(1d6c5ff2ea25e2c558dfacc85962acc616587537e6139d1e4a090731bcf8c7dc15f55e972317212c3a9b627bf3e369d148e9367af53c0753299503aa998cdfc7)

prepare() {
  cd Minder

  # Set application name
  # https://github.com/phase1geo/Minder/pull/734
  git cherry-pick -n 71f4133a89cfc08d09d8659b66c94d3b4c7863be

  # Reduce height of the Shortcuts page
  # https://github.com/phase1geo/Minder/pull/735
  git cherry-pick -n 948cbc47779d2c6b08052c47a2bb8c7a24eb727e
}

build() {
  arch-meson Minder build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  ln -s com.github.phase1geo.minder "$pkgdir/usr/bin/$pkgname"
}
