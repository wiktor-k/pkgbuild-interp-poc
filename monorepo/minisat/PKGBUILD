# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Vojtěch Aschenbrenner <v@asch.cz>

pkgname=minisat
pkgver=2.2.1.20201216
_commit=55d7e7613b94f0369476a0a8ff35969485ed324f
pkgrel=3
pkgdesc="A minimalistic and high-performance SAT solver"
arch=('x86_64')
url="http://minisat.se/"
license=('MIT')
depends=('glibc' 'libgcc' 'libstdc++' 'zlib')
makedepends=('git')
source=(git+https://github.com/msoos/minisat.git#commit=$_commit)
sha512sums=('9573d30e012c1b2436cf0a263a2d840702c36c9dc8f140e26aaf05ae2cfd37cb5bd5214152b09d4f3fed60ca4cf569a75d26529780f0f6dae1a58b23fc3056b7')

build() {
  cd $pkgname
  make config prefix=/usr
  make lr lsh
  make sh
}

package() {
  cd $pkgname
  make install DESTDIR="$pkgdir"
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

