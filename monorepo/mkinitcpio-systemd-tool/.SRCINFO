pkgbase = mkinitcpio-systemd-tool
	pkgdesc = Provisioning tool for systemd in initramfs (systemd-tool)
	pkgver = 40
	pkgrel = 1
	url = https://github.com/random-archer/mkinitcpio-systemd-tool
	arch = any
	license = Apache-2.0
	depends = bash
	depends = mkinitcpio
	depends = systemd
	optdepends = busybox: for initrd-tinysshd.service
	optdepends = cryptsetup: for initrd-cryptsetup.service
	optdepends = dropbear: for initrd-dropbear.service
	optdepends = mc: for initrd-debug-progs.service
	optdepends = nftables: for initrd-nftables.service
	optdepends = tinyssh: for initrd-tinysshd.service
	conflicts = mkinitcpio-dropbear
	conflicts = mkinitcpio-tinyssh
	backup = etc/mkinitcpio-systemd-tool/config/crypttab
	backup = etc/mkinitcpio-systemd-tool/config/fstab
	backup = etc/mkinitcpio-systemd-tool/config/initrd-nftables.conf
	backup = etc/mkinitcpio-systemd-tool/config/initrd-util-usb-hcd.conf
	backup = etc/mkinitcpio-systemd-tool/config/ntp.conf
	backup = etc/mkinitcpio-systemd-tool/mkinitcpio-systemd-tool.conf
	backup = etc/mkinitcpio-systemd-tool/network/initrd-network.network
