pkgbase = mkosi
	pkgdesc = Build Legacy-Free OS Images
	pkgver = 27.1
	pkgrel = 1
	url = https://github.com/systemd/mkosi
	arch = any
	license = LGPL-2.1-or-later
	checkdepends = python-pytest
	makedepends = git
	makedepends = pandoc-cli
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-setuptools
	makedepends = python-setuptools-scm
	makedepends = python-wheel
	depends = python
	depends = python-argcomplete
	depends = sh
	depends = systemd
	optdepends = acl: for removing directories created by mkosi
	optdepends = apt: for creating Debian and Ubuntu images
	optdepends = btrfs-progs: raw_btrfs and subvolume output formats
	optdepends = cpio: for cpio output format
	optdepends = debian-archive-keyring: build Debian images
	optdepends = dnf: for creating CentOS, Fedora, OpenMandriva, Mageia and OpenSUSE images
	optdepends = dosfstools: for FAT support
	optdepends = e2fsprogs: for ext2/3/4 support
	optdepends = edk2-ovmf: for running bootable images using QEMU
	optdepends = erofs-utils: for EROFS support
	optdepends = gnupg: for signing image checksums
	optdepends = kmod: for images using Linux kernels
	optdepends = mtools: for FAT support
	optdepends = openssl: for UEFI SecureBoot
	optdepends = python-pefile: for bootable images
	optdepends = qemu: for running bootable images using QEMU
	optdepends = sbsigntools: for UEFI SecureBoot
	optdepends = socat: for running the "mkosi ssh" subcommand
	optdepends = squashfs-tools: for squashfs support
	optdepends = swtpm: for adding software TPM when running bootable images using QEMU
	optdepends = systemd-ukify: for Unified Kernel Image (UKI) support
	optdepends = tar: for tar output format and Debian or Ubuntu images
	optdepends = ubuntu-keyring: for building Ubuntu images
	optdepends = xfsprogs: for XFS support
	optdepends = xz: for compressing images with xz
	optdepends = zstd: for compressing images with zstd
	optdepends = zypper: for creating OpenSUSE images
