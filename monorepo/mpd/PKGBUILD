pkgname=mpd
pkgver=0.24.17
pkgrel=1
pkgdesc="Flexible, powerful, server-side application for playing music"
arch=(x86_64)
url="https://www.musicpd.org/"
_url="https://github.com/MusicPlayerDaemon/MPD"
license=(
  BSD-2-Clause
  GPL-2.0-or-later
  ISC
  LGPL-2.1-only
)
