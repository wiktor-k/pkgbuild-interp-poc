# Contributor: Josh Taillon <jat255@gmail.com>

pkgname=msr-tools
pkgver=1.3
pkgrel=6
pkgdesc="Utilities to access the processor MSRs and CPU ID directly"
arch=('x86_64')
url="https://01.org/msr-tools"
license=('GPL-2.0-only')
depends=('glibc')
source=("https://github.com/intel/${pkgname}/archive/refs/tags/${pkgname}-${pkgver}.zip")
sha512sums=('e29f79a2d3de875af5663257f300472fe022879992a2f88bef6ec62e483368dcf68ca2d09502d6f41ee8d62e4f530ea7162585b954f24f3cc1665f6faaadc898')

build() {
  cd "${pkgname}-${pkgname}-${pkgver}"
  make CFLAGS="$CFLAGS -D_GNU_SOURCE -D_FILE_OFFSET_BITS=64" \
    LDFLAGS="$LDFLAGS"
}

package() {
  cd "${pkgname}-${pkgname}-${pkgver}"
  mkdir -p "$pkgdir"/usr/bin
  make sbindir="$pkgdir"/usr/bin install
}
