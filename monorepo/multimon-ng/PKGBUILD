pkgname=multimon-ng
pkgver=1.6.2
pkgrel=1
pkgdesc="An SDR decoder that supports POCSAG, UFSK, CLIPFSK, AFSK, HAPN, FSK, DTMF, ZVEI"
url="https://github.com/EliasOenal/multimon-ng"
arch=('x86_64')
license=("GPL-2.0-only")
depends=(
  'glibc'
  'libpulse'
)
makedepends=('cmake')
optdepends=('sox: wav conversion')
source=("$url/archive/$pkgver/$pkgname-$pkgver.tar.gz")
sha512sums=('2ded07069dcdce4675181f65dc2faf9f4be42a9bec1b1c058ab746ba0ab2c754c9e26930ebca04930c3d5e273c1a23eeb74f0be07b49df021aa823fddef59ca9')

build() {
  export CMAKE_POLICY_VERSION_MINIMUM=3.5
  cmake -S $pkgname-$pkgver -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
