# Maintainer: Justin Kromlinger <hashworks@archlinux.org>
pkgname=mustache
pkgver=4.1
pkgrel=4
pkgdesc="Mustache implementation for modern C++"
license=('Boost')
arch=('any')
url='https://github.com/kainjow/Mustache'
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('acd66359feb4318b421f9574cfc5a511133a77d916d0b13c7caa3783c0bfe167')

prepare() {
	cd "Mustache-${pkgver}"
	# `SIGSTKSZ` is no longer a compile-time constant in newer glibc.
	sed -i 's/static char altStackMem\[SIGSTKSZ\];/static char altStackMem[32768];/' catch.hpp
	sed -i 's/char FatalConditionHandler::altStackMem\[SIGSTKSZ\] = {};/char FatalConditionHandler::altStackMem[32768] = {};/' catch.hpp
}

check() {
	cd "Mustache-${pkgver}"
	make
}

package() {
	install -Dm644 "Mustache-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/$pkgname/LICENSE"
	install -D -m644 "Mustache-${pkgver}/mustache.hpp" "${pkgdir}/usr/include/mustache.hpp"
}

