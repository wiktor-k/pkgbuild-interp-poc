# Maintainer: Hyacinthe Cartiaux <hyacinthe@archlinux.org>
# Contributor: Ivan Kanis

pkgname=nagelfar
pkgver="1.3.5"
pkgrel=2
pkgdesc="Tcl syntax checker"
arch=('any')
url="http://nagelfar.sourceforge.net/"
license=('GPL-2.0-or-later AND TCL')
depends=("sh" "tcl")
source=("https://downloads.sourceforge.net/nagelfar/Rel_${pkgver//./}/${pkgname}${pkgver//./}.tar.gz" nagelfar-paths.patch doc-syntaxdatabase.patch)
sha256sums=('3baf920fb34b73e32067118365d074d859298e2bce3748ad9458624bece85b23'
            '8abe0390652c0f2bea59497d3c568dda7ad5ed58187733e2620b71c17825110f'
            '19aa5b8a3fd6d14ba7c4fe3dd9d277ba70a4e17096e29bacc716d82bb7b26e76')

prepare() {
    cd "${pkgname}${pkgver//./}"
    patch -Np1 -i "${srcdir}/doc-syntaxdatabase.patch"
    patch -Np1 -i "${srcdir}/nagelfar-paths.patch"
}

package() {
    cd "${pkgname}${pkgver//./}"

    install -Dm755 "${pkgname}.tcl" "${pkgdir}/usr/bin/${pkgname}"
    local libdir="${pkgdir}/usr/lib/${pkgname}"

    install -Dm644 -t "${libdir}/lib/textsearch" lib/textsearch/tcl/textsearch.tcl lib/textsearch/pkgIndex.tcl
    install -Dm644 -t "${libdir}/packagedb" packagedb/*
    install -Dm644 -t "${libdir}" syntax*.tcl *.syntax

    install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}" doc/*
    install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" COPYING lib/textsearch/licence.terms
    install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 lib/textsearch/licence.terms "${pkgdir}/usr/share/licenses/${pkgname}/textsearch/LICENSE"
}
