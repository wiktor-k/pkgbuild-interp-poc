pkgname=nethack
pkgver=5.0.0
pkgrel=1
pkgdesc='A single player dungeon exploration game'
arch=(x86_64)
url='https://www.nethack.org'
license=(NGPL)
depends=(filesystem ncurses gzip lua54)
makedepends=(git)
backup=(etc/nethack/sysconf)
source=(
  "$pkgname::git+https://github.com/NetHack/NetHack#tag=NetHack-${pkgver}_Released"
  use-system-lua54.patch
  tmpfiles.conf
)
