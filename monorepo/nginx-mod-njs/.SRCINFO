pkgbase = nginx-mod-njs
	pkgdesc = nginScript module for nginx
	pkgver = 1.0.2
	pkgrel = 5
	url = https://nginx.org/en/docs/njs_about.html
	arch = x86_64
	license = BSD-2-Clause
	makedepends = nginx
	makedepends = nginx-src
	depends = glibc
	depends = libxslt
	depends = openssl
	depends = zlib
	depends = pcre2
	depends = libxml2
	source = https://github.com/nginx/njs/archive/refs/tags/1.0.2/nginx-mod-njs-1.0.2.tar.gz
	sha256sums = 84a114499fa6878d3ec52b99c1cf2874a91eb0d915408f418a2b1279519f09ae

pkgname = nginx-mod-njs
	depends = glibc
	depends = libxslt
	depends = openssl
	depends = zlib
	depends = pcre2
	depends = libxml2
	depends = nginx
	backup = etc/nginx/modules.d/20-njs-http.conf

pkgname = nginx-mod-njs-stream
	pkgdesc = nginScript module for nginx streams
	depends = glibc
