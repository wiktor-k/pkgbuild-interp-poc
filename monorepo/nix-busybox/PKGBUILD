pkgname=nix-busybox
_pkgname="${pkgname#nix-}"
pkgver=1.37.0
pkgrel=1
pkgdesc='Slimmed down busybox for Nix sandbox builds'
arch=('x86_64')
url='https://www.busybox.net'
license=('GPL-2.0-only')
makedepends=(
  'ncurses'
  'musl'
  'kernel-headers-musl'
)
source=(
  "$url/downloads/$_pkgname-$pkgver.tar.bz2"{,.sig}
  'config'
)
sha512sums=('ad8fd06f082699774f990a53d7a73b189ed404fe0a2166aff13eae4d9d8ee5c9239493befe949c98801fe7897520dbff3ed0224faa7205854ce4fa975e18467e'
            'SKIP'
            'fe1a8c26184b980bc71d937a8133453dfc43781fcd4b5f91710ddeae129311250a72a6b98896c1088fb1fbfcb512028f5c03dcd0c8cfb85d027222ae65effbab')
b2sums=('bfd9b81a2428670722934316d429b56886b232dc43ced5873a1f72966dd2bb604e3d607082bb8404bc7e8c15c5c79265fc19f8932e2c9703caafd16fc8037a5a'
        'SKIP'
        'dbcc129ffde907b183fca6ea80f61b519f876acf9cc56bad2e498c0d414743ab6163511291297451232f5ee54ccb5d5adef57b3406eb54f3fefd7fe5d4a37ee7')
validpgpkeys=('C9E9416F76E610DBD09D040F47B70C55ACC9965B') # Denis Vlasenko <vda.linux@googlemail.com>

build() {
  cd "$_pkgname-$pkgver"

  cp "$srcdir/config" .config

  # reproducible build
  export KCONFIG_NOTIMESTAMP=1
  make CC=musl-gcc
}

package() {
  cd "$_pkgname-$pkgver"

  install -vDm755 -t "$pkgdir/usr/lib/nix" busybox
}
