# Maintainer: Peter Jung <ptr1337@archlinux.org>

pkgname=noctalia-greeter
pkgver=1.7.0
pkgrel=1
pkgdesc='Minimal greetd greeter matching the look and feel of Noctalia Shell'
arch=('x86_64')
url='https://github.com/noctalia-dev/noctalia-greeter'
license=('MIT AND (Apache-2.0 OR MIT)')
depends=(
  'bash'
  'cairo'
  'dbus'
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'glib2'
  'glibc'
  'greetd'
  'libglvnd'
  'libinput'
  'libjxl'
  'librsvg'
  'libwebp'
  'libxkbcommon'
  'libxml2'
  'pango'
  'tomlplusplus'
  'wayland'
  'wlroots0.20'
)
makedepends=(
  'meson'
  'nlohmann-json'
  'stb'
  'wayland-protocols'
)
optdepends=(
  'noctalia: wallpaper and palette sync from Noctalia Shell'
  'polkit: authorize appearance sync from Noctalia Shell'
  'xorg-xinit: start X11 sessions'
)
provides=('greetd-greeter')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5b092784c0147bb6739efc2e8146d2d07e3572a59d7a370e93092f9f56d4fcc8')

build() {
  arch-meson $pkgname-$pkgver build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 $pkgname-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 $pkgname-$pkgver/README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
