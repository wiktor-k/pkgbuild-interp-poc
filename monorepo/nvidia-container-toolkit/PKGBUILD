# Contributor: Mark Wagie <mark dot wagie at proton dot me>
# Contributor: Kien Dang <mail at kien dot ai>
# Contributor: Julie Shapiro <jshapiro at nvidia dot com>

pkgname=nvidia-container-toolkit
pkgver=1.20.1
pkgrel=1
pkgdesc="NVIDIA container toolkit"
arch=(x86_64)
url="https://github.com/NVIDIA/nvidia-container-toolkit"
license=(Apache-2.0)
depends=(glibc libnvidia-container=$pkgver)
makedepends=(go)
backup=(
  etc/nvidia-container-runtime/config.toml
  etc/nvidia-container-toolkit/nvidia-cdi-refresh.env
)
install=nvidia-container-toolkit.install
# we cannot use LTO as otherwise we do not get reproducible package with full RELRO
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
b2sums=('aa9d66374d1caea72dcd0f59291c81ba26e110367c02fd00acf8ec272e491c36b0e486238d9ce7a5312d1f3cdedefb09ca85ed5f60aa5fa173deba17d17af233')

prepare() {
  cd "$pkgname-$pkgver"
  mkdir -p build
}

build() {
  cd "$pkgname-$pkgver"

  # set GOPATH so makepkg puts source files into the debug package
  export GOPATH="$srcdir"

  # FIXME: nvml requires lazy binding (-Wl,-z,lazy) which prevents FULL RELRO: https://github.com/NVIDIA/nvidia-container-toolkit/issues/49
  go build -v \
    -buildmode=pie \
    -mod=vendor \
    -modcacherw \
    -ldflags "-compressdwarf=false -linkmode external -extldflags \"$LDFLAGS -Wl,-z,lazy\" -X github.com/NVIDIA/$pkgname/internal/info.version=$pkgver" \
    -o build ./...
}

check() {
  cd "$pkgname-$pkgver"
  PATH="$PATH:$PWD/build" go test -v ./...
}

package() {
  cd "$pkgname-$pkgver"

  # install binaries
  install -vDm 755 build/nvidia-{ctk,container-runtime{,.cdi,.legacy,-hook},cdi-hook} -t "$pkgdir/usr/bin/"
  ln -s nvidia-container-runtime-hook "$pkgdir/usr/bin/nvidia-container-toolkit"

  # install systemd units, conf snippet, env file, and udev rule
  install -vDm 644 deployments/systemd/nvidia-cdi-refresh.{path,service} -t "$pkgdir"/usr/lib/systemd/system/
  install -vDm 644 deployments/systemd/10-container-engines.conf -t "$pkgdir"/usr/lib/systemd/system/nvidia-cdi-refresh.service.d/
  install -vDm 644 deployments/systemd/nvidia-cdi-refresh.env -t "$pkgdir"/etc/nvidia-container-toolkit/
  install -vDm 644 deployments/udev/99-nvidia-cdi-refresh.rules -t "$pkgdir"/usr/lib/udev/rules.d/

  # enable path and service units (substitute for upstream preset)
  install -vdm 755 "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/
  ln -s ../nvidia-cdi-refresh.path "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/nvidia-cdi-refresh.path
  ln -s ../nvidia-cdi-refresh.service "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/nvidia-cdi-refresh.service

  # install the license
  install -vDm 644 LICENSE THIRD_PARTY_NOTICES.md -t "$pkgdir/usr/share/licenses/$pkgname/"

  # generate the default config
  "$pkgdir"/usr/bin/nvidia-ctk --quiet config --config-file="$pkgdir"/etc/nvidia-container-runtime/config.toml --in-place
}
