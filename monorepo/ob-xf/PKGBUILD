prepare() {
  cd "$pkgbase"

  # explicitly state which submodules to use,
  # omitting devendored & unused submodules
  git submodule init \
    libs/JUCE \
    libs/sst/sst-cmake \
    libs/simde \
    libs/sst/sst-cpputils \
    libs/sst/sst-basic-blocks \
    libs/sst/sst-plugininfra \
    libs/melatonin_inspector \
    libs/clap-juce-extensions \
    libs/MTS-ESP

  git config submodule.libs/JUCE.url "$srcdir/github.com-juce-framework-JUCE"
  git config submodule.libs/sst/sst-cmake.url "$srcdir/github.com-surge-synthesizer-sst-cmake"
  git config submodule.libs/simde.url "$srcdir/github.com-simd-everywhere-simde"
  git config submodule.libs/sst/sst-cpputils.url "$srcdir/github.com-surge-synthesizer-sst-cpputils"
  git config submodule.libs/sst/sst-basic-blocks.url "$srcdir/github.com-surge-synthesizer-sst-basic-blocks"
  git config submodule.libs/sst/sst-plugininfra.url "$srcdir/github.com-surge-synthesizer-sst-plugininfra"
  git config submodule.libs/melatonin_inspector.url "$srcdir/github.com-sudara-melatonin_inspector"
  git config submodule.libs/clap-juce-extensions.url "$srcdir/github.com-free-audio-clap-juce-extensions"
  git config submodule.libs/MTS-ESP.url "$srcdir/github.com-ODDSound-MTS-ESP"

  git -c protocol.file.allow=always submodule update

  # setup git submodules for sst-plugininfra
  pushd libs/sst/sst-plugininfra
  git submodule init
  git config submodule.libs/filesystem/filesystem.url "$srcdir/github.com-gulrak-filesystem"
  git -c protocol.file.allow=always submodule update
  popd

  # setup git submodules for clap-juce-extensions
  pushd libs/clap-juce-extensions
  git submodule init
  git config submodule.clap-libs/clap.url "$srcdir/github.com-free-audio-clap"
  git config submodule.clap-libs/clap-helpers.url "$srcdir/github.com-free-audio-clap-helpers"
  git -c protocol.file.allow=always submodule update
  popd

  # devendor libs
  patch -p1 -i "$srcdir/devendor-libs.patch"
}

build() {
  cd "$pkgbase"

  # binaries and shared libs have executable stack:
  # https://github.com/surge-synthesizer/surge/issues/1701
  export LDFLAGS="$LDFLAGS,-z,noexecstack"

  local cmake_options=(
    -B build
    -S .
    -D CMAKE_INSTALL_PREFIX='/usr'
    -D CMAKE_INSTALL_LIBDIR='/usr/lib'
    -D CMAKE_BUILD_TYPE=Release
    -W no-dev
  )

  cmake "${cmake_options[@]}"

  cmake --build build
}

package_ob-xf-common() {
  pkgdesc='Common files for OB-Xf'

  cd "$pkgbase"

  # so far, only installs assets (themes/presets)
  DESTDIR="$pkgdir" cmake --install build
}

package_ob-xf-standalone() {
  pkgdesc+=' - standalone'
  depends=(
    "ob-xf-common=$pkgver"
    hicolor-icon-theme
    "${_common_depends[@]}"
  )
  optdepends=(
    'jack: audio backend'
    'alsa-lib: audio backend'
  )

  cd "$pkgbase"

  install -vDm755 -t "$pkgdir/usr/bin" build/OB-Xf_artefacts/Release/Standalone/OB-Xf
}
package_ob-xf-vst3() {
  pkgdesc+=' - VST3 plugin'
  groups+=(vst3-plugins)
  depends=(
    "ob-xf-common=$pkgver"
    "${_common_depends[@]}"
    vst3-host
  )

  cd "$pkgbase"

  install -vd "$pkgdir/usr/lib/vst3"
  cp -vr build/OB-Xf_artefacts/Release/VST3/* "$pkgdir/usr/lib/vst3"
}
package_ob-xf-lv2() {
  pkgdesc+=' - LV2 plugin'
  groups+=(lv2-plugins)
  depends=(
    "ob-xf-common=$pkgver"
    "${_common_depends[@]}"
    lv2-host
  )
  cd "$pkgbase"

  
  install -vd "$pkgdir/usr/lib/lv2"
  cp -vr build/OB-Xf_artefacts/Release/LV2/* "$pkgdir/usr/lib/lv2"
}
package_ob-xf-clap() {
  pkgdesc+=' - CLAP plugin'
  groups+=(clap-plugins)
  depends=(
    "ob-xf-common=$pkgver"
    "${_common_depends[@]}"
    clap-host
  )

  cd "$pkgbase"

  install -vDm644 -t "$pkgdir/usr/lib/clap" build/OB-Xf_artefacts/Release/CLAP/*
}
