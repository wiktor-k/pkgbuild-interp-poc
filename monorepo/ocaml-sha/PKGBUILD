# Maintainer: Alexander F. Rødseth <xyproto@archlinux.org>

pkgname=ocaml-sha
pkgver=1.15.4
pkgrel=1
pkgdesc='SHA1 and SHA2 implementations for OCaml'
arch=(x86_64)
url='https://github.com/djs55/ocaml-sha'
license=(ISC)
depends=(glibc ocaml ocaml-stdlib-shims)
makedepends=(dune)
options=(!strip !makeflags !debug)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
b2sums=('1658a99384de4de4063ede9f41191b27ce34a0c5a303fda4bbd0a7185a0ce1419f8207249cda3a606e525ec1f68a83b548352374f76727a15ab0c685f8f77190')

build() {
  cd ocaml-sha-$pkgver
  dune build --release
}

package() {
  cd ocaml-sha-$pkgver
  dune install --prefix="$pkgdir/usr" --libdir="$pkgdir/usr/lib/ocaml"
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
