pkgname=oils-for-unix
pkgver=0.38.0
pkgrel=1
pkgdesc='Oils for Unix: OSH and YSH shells'
arch=(x86_64)
url='https://oils.pub/'
license=(Apache-2.0)
depends=(
  glibc
  libgcc libgcc_s.so
  libstdc++ libstdc++.so
  readline libreadline.so
)
makedepends=(bash)
replaces=(osh oil)
install=oil.install
source=("$url/download/oils-for-unix-$pkgver.tar.gz")
sha512sums=('27ad5bf6446b9b3918344776c42e190d1640df74bda01da692818b588e5fdfa4d4650eacd53ac5674d02f61232f83e199dfc36d6a65ee34d37c962ce936ee23d')
b2sums=('0f0606f578d756c0b9f0bc5ee08df641cb39d7cdead0b71bded3f4b0f370bc062f2292c9d79af44cbfbb048fc0352cbb3851dfffaa4f1d940b71c644dd63b538')
noextract=("oils-for-unix-$pkgver.tar.gz")

prepare() {
  # fix: LTO + strip
  mkdir -p path
  cat >path/c++ <<END
#!/bin/sh
exec g++ \$CXXFLAGS \$LDFLAGS -fPIC "\$@"
END
  cat >path/strip <<END
#!/bin/sh
exec cp -p "\$3" "\$2"
END
  chmod +x path/*

  # fix: bsdtar choking on hardlinked files pointing to self, e.g.:
  # _gen/frontend/option.asdl.h: Skipping hardlink pointing to itself: _gen/frontend/option.asdl.h: No such file or directory
  tar -xf "oils-for-unix-$pkgver.tar.gz"
}

build() {
  cd "oils-for-unix-$pkgver"

  ./configure \
    --prefix=/usr \
    --datarootdir=/usr/share

  PATH="$srcdir/path:$PATH" _build/oils.sh
}

package() {
  cd "oils-for-unix-$pkgver"

  DESTDIR="$pkgdir" ./install
}
