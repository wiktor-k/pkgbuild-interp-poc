# Maintainer: Justin Kromlinger <hashworks@archlinux.org>

_plugin_type=auth
_plugin_name=github

pkgname="openbao-plugin-${_plugin_type}-${_plugin_name}"
pkgdesc="OpenBao Plugin - Authenticate using GitHub credentials"
pkgver="0.0.1"
pkgrel=1
arch=("x86_64")
url="https://openbao.org/docs/plugins/"
license=('MPL-2.0')
depends=(openbao)
makedepends=(go go-tools git)
install=openbao-plugin.install
source=(
    "openbao-plugin-${_plugin_type}-${_plugin_name}::git+https://github.com/openbao/openbao-plugins.git#tag=${_plugin_type}-${_plugin_name}-v${pkgver}"
)
sha256sums=('b72727a8ea9e5dd112796312e2569f0cbb1969742d8638f645c16c086fe73044')

prepare() {
  cd "${pkgname}"

  export GOPATH="${srcdir}"
  go mod download -modcacherw
}

build() {
  cd "${pkgname}"

  export CGO_ENABLED=0
  export GOPATH="${srcdir}"

  go build \
    -trimpath \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-X github.com/openbao/openbao-plugins/${_plugin_type}/${_plugin_name}.pluginVersion=v${pkgver}" \
    -o "dist/${_plugin_type}-${_plugin_name}" \
    "./${_plugin_type}/${_plugin_name}/cmd"
}

package() {
  cd "${pkgname}"

  install -Dm755 "dist/${_plugin_type}-${_plugin_name}" "${pkgdir}/usr/lib/openbao/plugins/${_plugin_type}-${_plugin_name}"
}
