# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=openboard
pkgver=1.7.7
pkgrel=6
pkgdesc='Interactive whiteboard application intended for use in a classroom setting'
arch=(x86_64)
url='https://www.openboard.ch/'
license=(GPL-3.0-only)
depends=(
  ffmpeg
  glibc
  hicolor-icon-theme
  libgcc
  libstdc++
  libx11
  openssl
  poppler
  qt6-base
  qt6-multimedia
  qt6-svg
  qt6-webchannel
  qt6-webengine
  quazip-qt6
  zlib
)
makedepends=(
  cmake
  git
  ninja
  qt6-tools
)
source=(
  "git+https://github.com/OpenBoard-org/OpenBoard.git#tag=v$pkgver"
  openboard-poppler-26.4.patch
  ch.openboard.OpenBoard.metainfo.xml
)
b2sums=(
  41b6b764d14da03c4b54cd0178e00cccedf7560f00927f3ea0ae63aac298b63f0aa2e167376ca1ee3730c07e77fd3676b054c31e37a01cf0a62986db951ca8c2
  803602bfdfe719de8a92d934a6a42b0df76e9b8afecb74988e2000274bd7a2a3a69fadae6c361a7090ee95e4af70cdee40f18861cff1fd5623001895c11e6877
  6a132dbaa5e16ecf09ba51f17b26386940e8854a7c22ac3221a74001d7e4eaaf3ae9c2172b4105ff400ee361f654f3d5d264a2b9b3b2dc52eb94b7cf55b7acd8
)

prepare() {
  cd OpenBoard

  # Fix build with FFmpeg 9
  # https://github.com/OpenBoard-org/OpenBoard/pull/1219
  git cherry-pick -n 41ba5bdcb2d6d10106eccec579e0e2db93c5e9e5

  # Fix build with Poppler 26.04
  # https://github.com/OpenBoard-org/OpenBoard/pull/1474
  git apply -3 ../openboard-poppler-26.4.patch
}

build() {
  cmake -S OpenBoard -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_CXX_STANDARD=20
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 -t "$pkgdir/usr/share/metainfo/" ch.openboard.OpenBoard.metainfo.xml
}
