# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=opencloud-desktop
pkgver=4.0.0
pkgrel=1
pkgdesc='The OpenCloud desktop application'
arch=(x86_64)
url='https://github.com/opencloud-eu/desktop'
license=(GPL-2.0-only)
depends=(
  glibc
  libstdc++
  kdsingleapplication
  libre-graph-api
  qt6-base
  qt6-declarative
  hicolor-icon-theme
  qtkeychain-qt6
  sqlite
  zlib
)
makedepends=(
  git
  cmake
  ninja
  doxygen
  extra-cmake-modules
  python-sphinx
  qt6-tools
)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('8e04969dca1b9d3d4bcda0a1d3980842fb8bb93059c238f5cee8dd2513f8db275f5eae11b7c62fef1402d4862a103764bf6d55f5d851583b991e8071602ac1e7')
b2sums=('7b4f00b9f92629af6f92b9d1e6608a6d91eae396af382bb44e4bf036d6f6d0e46388993cd4983662d234f58ab32d42c76f992400a3f515bae60255bb33073f84')

build() {
  local cmake_options=(
    -B build
    -S "$pkgname"
    -W no-dev
    -G Ninja
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
		-D CMAKE_SKIP_INSTALL_RPATH=ON
		-D BUILD_TESTING=OFF
		-D KDE_INSTALL_SYSCONFDIR=/etc
  )

  cmake "${cmake_options[@]}"

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
