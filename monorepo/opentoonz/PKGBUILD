pkgname=opentoonz
pkgver=1.8.0
pkgrel=3
pkgdesc='A full-featured 2D animation creation software'
arch=(x86_64)
url='https://opentoonz.github.io/e/'
license=(BSD-3-Clause)
depends=(
  libusb
  cblas
  ffmpeg
  freeglut
  glew
  libmypaint
  libtiff
  opencv
  qt5-base
  qt5-multimedia
  qt5-script
  qt5-serialport
  qt5-svg
  superlu
  zlib
  libjpeg-turbo
  hicolor-icon-theme
  libpng
  xz
  lzo
  sh
  lz4
  libglvnd
  glu
  kissfft
)
makedepends=(
  git
  boost
  boost-libs
  cmake
  ninja
  qt5-tools
)
