prepare() {
  cd "$pkgname"

  # prefer system libraries
  pushd thirdparty
  rm -rf boost glew glut libjpeg-turbo libmypaint libpng-1.6.21 libusb lz4 lzo superlu tiff-4.0.3 zlib-1.2.8 kiss_fft
  popd

# canon
# openblas
# quicktime
# tinyexr

  # specify path for ffmpeg
  patch -p1 -i "$srcdir/ffmpeg-path.patch"

  # use system libtiff
  patch -p1 -i "$srcdir/tiff-fix.patch"

  # disable toonzrle due to libtiff internal API access
  patch -p1 -i "$srcdir/remove-toonzrle.patch"

  # use libtiff external APIs
  patch -p1 -i "$srcdir/tiffiop-fix.patch"

  # use system lzo
  patch -p1 -i "$srcdir/lzo-fix.patch"

  # use system kissfft
  patch -p1 -i "$srcdir/kissfft-fix.patch"

  # fix build with opencv 5
  patch -p1 -i ../opencv-5.patch
}

build() {
  # WITH_TRANSLATION doesn't do anything, generated translations aren't installed
  local cmake_options=(
    -B build
    -S "$pkgname/toonz/sources"
    -G Ninja
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_SKIP_RPATH=YES
    -D WITH_TRANSLATION=OFF
    -D CMAKE_POLICY_VERSION_MINIMUM=3.5
    -D CMAKE_C_STANDARD=17
    -D WITH_SYSTEM_LZO=ON
    -D WITH_SYSTEM_SUPERLU=ON
  )

  cmake "${cmake_options[@]}"

  cmake --build build

}

package() {
  depends+=(
    glibc
    libgcc libgcc_s.so
    libstdc++ libstdc++.so
  )
  DESTDIR="$pkgdir" cmake --install build

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$pkgname/LICENSE.txt"
}
