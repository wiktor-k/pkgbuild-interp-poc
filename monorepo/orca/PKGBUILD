pkgname=orca
pkgver=51.1
pkgrel=1
pkgdesc="Screen reader for individuals who are blind or visually impaired"
url="https://orca.gnome.org/"
arch=(any)
license=(LGPL-2.1-or-later)
depends=(
  at-spi2-core
  dconf
  glib2
  glibc
  gobject-introspection-runtime
  gsettings-desktop-schemas
  gst-plugins-base # playbin, audiotestsrc, basic decoders
  gst-plugins-good # pulsesink, more decoders
  gstreamer
  gtk3
  hicolor-icon-theme
  libgcc
  liblouis
  libwnck3
  pango
  python
  python-brltty
  python-cairo
  python-dasbus
  python-dbus
  python-gobject
  python-psutil
  python-setproctitle
  speech-dispatcher
  xorg-xkbcomp
  xorg-xmodmap
)
checkdepends=(
  python-pytest
  python-pytest-mock
  xorg-server-xvfb
)
makedepends=(
  cargo
  git
  itstool
  meson
  yelp-tools
)
groups=(gnome)
source=(
  "git+https://gitlab.gnome.org/GNOME/orca.git?signed#tag=${pkgver/[a-z]/.&}"
)
b2sums=('99afc145bf2407635d6083ad1d6be47e0e9ec7213b459781cb7317463fa25f32a74181d08726ce9a3e043ef1093761485d43aa6cc91cdf1086fdac0858a7c513')
validpgpkeys=(
  DBDB67681333AA61BBCB97140A042BFD3DA3816C # Joanmarie Diggs <jdiggs@igalia.com>, older
  85D0D0B3FB02946101A46295E7A697B5609D4701 # Joanmarie Diggs <jdiggs@igalia.com>, newer
)

# Use debug
export CARGO_PROFILE_RELEASE_DEBUG=2 CARGO_PROFILE_RELEASE_STRIP=false

# Use LTO
export CARGO_PROFILE_RELEASE_LTO=true CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1

prepare() {
  cd orca

  cargo fetch --locked --target host-tuple \
    --manifest-path subprojects/mathcat-py/Cargo.toml
}

build() {
  local meson_options=(
    -D spiel=false
  )

  arch-meson orca build "${meson_options[@]}"
  meson compile -C build
}

check() {
  dbus-run-session xvfb-run -s '-nolisten local' \
    meson test -C build --print-errorlogs
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}

