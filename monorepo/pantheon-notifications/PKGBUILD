# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=pantheon-notifications
pkgver=8.1.2
pkgrel=2
pkgdesc='Gtk Notifications Server'
arch=(x86_64)
url=https://github.com/elementary/notifications
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  dconf
  gdk-pixbuf2
  glib2
  glibc
  granite7
  gtk4
  libadwaita
  libcanberra
  libgee
  libx11
  wayland
)
makedepends=(
  git
  intltool
  meson
  vala
)
source=(pantheon-notifications::git+https://github.com/elementary/notifications.git#tag=${pkgver})
b2sums=('07c467754d292223d09d9f100b7f476f56942e7dcdca30f7f666847b29f12a64c7fe3e8799ebbf97332e4a4d86298dba705ae0d3d9744ee07c341d9a0107e541')

build() {
  arch-meson pantheon-notifications build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}
