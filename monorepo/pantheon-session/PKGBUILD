# Maintainer: Maxime Gauduin <alucryd@archlinux.org>
# Contributor: Helder Bertoldo <helder.bertoldo@gmail.com>

pkgname=pantheon-session
pkgver=8.1.0
pkgrel=1
pkgdesc='Session settings for Pantheon'
arch=(any)
url=https://github.com/elementary/session-settings
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  dconf
  gala
  gnome-keyring
  gnome-session
  gnome-settings-daemon
  pantheon-applications-menu
  orca
  plank
  wingpanel
  xdg-user-dirs-gtk
)
makedepends=(
  git
  meson
)
optdepends=(pantheon-default-settings)
source=(pantheon-session-settings::git+https://github.com/elementary/session-settings.git#tag=${pkgver})
b2sums=('3c85a8ada3e340fea40fc0eade4d5a89d3943df6acae10c397fcdcad4222a6392eb5e63dc8fb56b5e01d4d83caaf594e6ac3cb451a91f78f924ebcc0fafaf78a')

prepare() {
  cd pantheon-session-settings
  # cherry-pick upstream fixes: remove onboard (PR #83), then remove gsd autostarts (PR #100)
  git cherry-pick --no-commit cfbcda4 6e8eee7
}

build() {
  arch-meson pantheon-session-settings build \
    -Dfallback-session=gnome \
    -Dx11=false
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}

