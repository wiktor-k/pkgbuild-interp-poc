# Maintainer: Christian Heusel <gromit@archlinux.org>
# Contributor: Thomas Weißschuh <thomas t-8ch de>

pkgname=patatt
pkgver=0.8.0
pkgrel=1
pkgdesc="A simple library to add cryptographic attestation to patches sent via email"
arch=("any")
depends=('python-pynacl')
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
url="https://git.kernel.org/pub/scm/utils/patatt/patatt.git/about/"
license=("MIT")
source=("git+https://git.kernel.org/pub/scm/utils/patatt/patatt.git#tag=v${pkgver}?signed")
validpgpkeys=('DE0E66E32F1FDD0902666B96E63EDCA9329DD07E')
sha256sums=('c011870431655e2a2671e53f3b68a119517a5594ccb334c9cb0f633566afffec')

build() {
  cd "$pkgname"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 COPYING "$pkgdir"/usr/share/licenses/$pkgname/LICENSE

  install -d "$pkgdir/usr/share/man/man5"
  install -m644 man/*.5 "$pkgdir/usr/share/man/man5"
}
