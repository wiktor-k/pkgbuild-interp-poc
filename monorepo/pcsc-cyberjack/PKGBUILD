# Maintainer: Jonathan Grotelüschen <tippfehlr@archlinux.org>
# Contributor: Christoph Drexler <chrdr at gmx dot at>

pkgname=pcsc-cyberjack
pkgver=3.99.5_SP17
_pkgver=${pkgver/_SP/final.SP}
pkgrel=4
pkgdesc="PCSC Driver for Reiner SCT cyberjack Cardreaders"
arch=('x86_64')
url="https://help.reiner-sct.com/de/support/solutions/articles/101000480008"
license=('GPL-2.0-or-later AND LGPL-2.0-or-later AND LGPL-2.1-or-later')
depends=('glibc' 'libusb' 'pcsclite' 'libgcc' 'libstdc++')
source=(
	"https://support.reiner-sct.de/downloads/LINUX/V$pkgver/$pkgname-$_pkgver.tar.bz2"
	"libifd-cyberjack6.udev"
)
sha256sums=('f1a8e15db3a4268b0d79c32a76195b34d79518bb891685443e253311f9e9d30a'
            'd0f0587aef5f15f44178140e28844cad0d003cae59adede078fb890688135a8b')

prepare() {
	cd "$pkgname-$_pkgver"
	autoreconf -i
}

build() {
	cd "$pkgname-$_pkgver"

	local _conf_args=(
		--prefix=/usr
		--mandir=/usr/share/man/man8
		--sysconfdir=/etc/$pkgname
		--enable-udev
		--with-usbdropdir=$(pkg-config libpcsclite --variable=usbdropdir)
	)

	./configure "${_conf_args[@]}"
	make
}

package() {
	install -Dm644 libifd-cyberjack6.udev "$pkgdir/usr/lib/udev/rules.d/60-libifd-cyberjack6.rules"

	cd "$pkgname-$_pkgver"
	make DESTDIR="$pkgdir" install
}
