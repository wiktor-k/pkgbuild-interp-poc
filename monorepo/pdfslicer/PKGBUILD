# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=pdfslicer
pkgver=1.8.8
pkgrel=8
pkgdesc='Simple application to extract, merge, rotate and reorder pages of PDF documents'
arch=(x86_64)
url='https://junrrein.github.io/pdfslicer/'
license=(GPL-3.0-or-later)
depends=(
  atkmm
  cairomm
  glib2
  glibc
  glibmm
  gtk3
  gtkmm3
  hicolor-icon-theme
  libgcc
  libsigc++
  libstdc++
  poppler
  qpdf
  util-linux-libs
)
makedepends=(
  cmake
  git
  intltool
  ninja
)
source=(
  "git+https://github.com/junrrein/pdfslicer.git#tag=v$pkgver"
  git+https://github.com/ericniebler/range-v3.git
  git+https://github.com/Microsoft/GSL.git
  git+https://github.com/fmtlib/fmt.git
  https://github.com/catchorg/Catch2/releases/download/v2.13.8/catch.hpp
  pdfslicer-qpdf-11.patch
  pdfslicer-prgname.patch
)
b2sums=(
  0ad7c983f6628796fd5bbbb0dd924bc1b659dba1490f3dd48705f7c6c9756efdc88c9a15f1e4f5339a4ddad73a85f13c7b0e59d7bfd6cc3867a23d751cd7ac8d
  SKIP
  SKIP
  SKIP
  b1cb64ec2a00eb04fbbb97091b262cf4e904264a2ec5b2cbd5f4137e7797d595a6eb0d6be0b111bb8a9ddd9a084060bed1a998b9672574d6d1d1ab1c0de373c9
  512d4e627b3b435a238df486410452b21f8f30014923e96c4f8041bd4591eb5ff7c7bc29c5d9d4ae2a10501baac84e85fbfdd9cb03a28cdbd8450d22b1cc1040
  5aad1156a0727c5f78caa423ab4d0fcc6581a011a3ac889dfc9c9dd1d7d4192bb809c2aa8b1a27cc394f4f836e571d00d623f0b56ad65431923f74fab22bd520
)

prepare() {
  cd $pkgname
  git submodule init
  git submodule set-url third-party/range-v3 "$srcdir/range-v3"
  git submodule set-url third-party/GSL "$srcdir/GSL"
  git submodule set-url third-party/fmtlib "$srcdir/fmt"
  git -c protocol.file.allow=always submodule update

  # Fix incompatibility with qpdf 11
  git apply -3 ../pdfslicer-qpdf-11.patch

  # Set prgname to application ID
  # https://github.com/junrrein/pdfslicer/pull/241
  git apply -3 ../pdfslicer-prgname.patch

  # Update third-party projects to newer versions to fix the build
  cp ../catch.hpp third-party/catch2/catch.hpp
  cd "$srcdir/$pkgname/third-party/range-v3"
  git checkout 0.12.0
  cd "$srcdir/$pkgname/third-party/fmtlib"
  git checkout 7.1.3
}

build() {
  cmake -S $pkgname -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_POLICY_VERSION_MINIMUM=3.5
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  rm -r "$pkgdir"/usr/{include,lib}
}
