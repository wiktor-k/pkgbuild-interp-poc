# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=pdftricks
pkgver=0.4.1
pkgrel=2
pkgdesc='Simple, efficient application for small manipulations in PDF files using Ghostscript'
arch=(x86_64)
url='https://github.com/muriloventuroso/pdftricks'
license=(GPL-3.0-or-later)
depends=(
  gdk-pixbuf2
  ghostscript
  glib2
  glibc
  granite
  gtk3
  hicolor-icon-theme
  imagemagick
)
makedepends=(
  git
  meson
  vala
)
source=(
  "git+https://github.com/muriloventuroso/pdftricks.git#tag=$pkgver"
  pdftricks-meson.patch
)
b2sums=(
  e48e220300b0e5597f445dd3f9e7b9469eb553c02e27fd5eb1ef3328f000cc7d40314359df97fc4bb7e03f41725a616b7ada60e142683ce731a072d746aabb45
  52016cb3f7d929a3fc1d60fdd9ef230a5593f7832315bbda246868cd90b6926ea9167d8c85f7839eef642a072b7663eb31989d61a3f9e88e2842d1109579d272
)

prepare() {
  cd $pkgname

  # Fix meson build
  # https://github.com/muriloventuroso/pdftricks/pull/70
  git apply -3 ../pdftricks-meson.patch

  # Use standard icon name
  sed -i 's/process-completed/gtk-apply/' src/Widgets/*.vala
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  ln -s com.github.muriloventuroso.pdftricks "$pkgdir/usr/bin/$pkgname"
}
