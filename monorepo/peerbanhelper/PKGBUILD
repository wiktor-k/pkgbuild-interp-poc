# Contributor: Jisu-Woniu <jswn@jswn9945.xyz>

pkgname=peerbanhelper
pkgver=9.5.1
# Check build.gradle.kts
_sqlite_ver=3.53.2.1
_flatlaf_ver=3.7.2
_javaversion=25
pkgrel=2
pkgdesc="A tool to auto ban peers on the Bittorrent network"
arch=('x86_64')
url="https://github.com/PBH-BTN/PeerBanHelper"
license=('GPL-3.0-or-later')
depends=(
    'glib2'
    'glibc'
    'gtk3'
    "java-runtime-headless>=${_javaversion}"
    'libgcc'
    'libstdc++'
    'sh'
    'sqlite'
)
makedepends=(
    'gradle'
    'git'
    "java-environment=${_javaversion}"
    'nodejs'
    'pnpm'
    'zip'
)
source=(
    "${pkgname}::git+https://github.com/PBH-BTN/PeerBanHelper.git#tag=v${pkgver}" # show commit hash in WebUI
    "sqlite-jdbc-${_sqlite_ver}.tar.gz::https://github.com/xerial/sqlite-jdbc/archive/refs/tags/${_sqlite_ver}.tar.gz"
    "flatlaf-${_flatlaf_ver}.tar.gz::https://github.com/JFormDesigner/FlatLaf/archive/refs/tags/${_flatlaf_ver}.tar.gz"
    "${pkgname}.sh"
    "${pkgname}.sysusers"
    "${pkgname}.service"
)
sha256sums=('f0768e674a34893da859bfefb7b9c53e93e01f75773bb8f6b494d61759441e56'
            'd32bb87f5ba9cc794305ccd1602c326991020b7ed2d9d5e23aa9a093b10a4e07'
            '41870b2abf026fb9ed35ed95343ceb454fb8db2f32fc042309160257a585edb3'
            '3c48af98067ce355934d1ca394d7bcfa1616733b79ce13277f3f2861ffb955f5'
            '394ee8f74dd630f375c34cf5160059078516033b0867ad43b1c43377b4104bde'
            '5ba62e5b6f0cefcc4a70ca14be19a0913bd024f88c445e50c6f8f26077348ff6')

prepare() {
    cd "${pkgname}"

    # Remove dependencies for other platforms
    sed -i \
        -e '/natives-android/d' \
        -e '/osx-/d' \
        -e 's/+ " libraries\/swt.jar"//' \
        build.gradle.kts

    # Remove dependencies for other architectures
    local _exclude_arch
    case "$CARCH" in
        x86_64)  _exclude_arch='linux-aarch_64' ;;
        aarch64) _exclude_arch='linux-x86_64' ;;
        *)       _exclude_arch='linux-x86_64|linux-aarch_64' ;;
    esac
    sed -i -E "/${_exclude_arch}/d" build.gradle.kts

    pushd webui
    pnpm install --frozen-lockfile
    popd
}

build() {
    cd "${pkgname}"

    pushd webui
    pnpm run build
    popd
    cp -rT webui/dist src/main/resources/static

    # Enforce to use the specific Java version
    local _javadirs=(/usr/lib/jvm/java-${_javaversion}-*)
    export JAVA_HOME="${_javadirs[0]}"
    export PATH="${JAVA_HOME}/bin:${PATH}"

    gradle jar --no-daemon -Porg.gradle.java.installations.auto-download=false

    mkdir -p "${srcdir}/lib"

    # SQLite JDBC
    zip -qd "build/libraries/sqlite-jdbc-"*.jar "org/sqlite/native/*"

    local _jni_dir="${srcdir}/sqlite-jdbc-${_sqlite_ver}/src/main/java/org/sqlite/core"
    javac -h "${_jni_dir}" \
        -cp "${srcdir}/${pkgname}/build/libraries/sqlite-jdbc-${_sqlite_ver}.jar" \
        "${_jni_dir}/NativeDB.java"
    mv "${_jni_dir}/org_sqlite_core_NativeDB.h" "${_jni_dir}/NativeDB.h"
    gcc -shared -fPIC ${CFLAGS} ${LDFLAGS} -fvisibility=hidden \
        -Wl,-soname,libsqlitejdbc.so \
        -I"${JAVA_HOME}/include" -I"${JAVA_HOME}/include/linux" \
        -I"${_jni_dir}" \
        "${_jni_dir}/NativeDB.c" \
        -lsqlite3 -o "${srcdir}/lib/libsqlitejdbc.so"

    # FlatLaf
    zip -qd "build/libraries/flatlaf-"*.jar "com/formdev/flatlaf/natives/*"

    local _flatlaf_so_name
    case "$CARCH" in
        x86_64)  _flatlaf_so_name='libflatlaf-linux-x86_64.so' ;;
        aarch64) _flatlaf_so_name='libflatlaf-linux-arm64.so' ;;
        *)       _flatlaf_so_name="libflatlaf-linux-${CARCH}.so" ;;
    esac

    local _flatlaf_src="${srcdir}/FlatLaf-${_flatlaf_ver}/flatlaf-natives/flatlaf-natives-linux"
    g++ -shared -fPIC ${CXXFLAGS} ${LDFLAGS} -fvisibility=hidden \
        -Wl,-soname,"${_flatlaf_so_name}" \
        -I"${JAVA_HOME}/include" -I"${JAVA_HOME}/include/linux" \
        -I"${_flatlaf_src}/src/main/headers" \
        $(pkg-config --cflags gtk+-3.0) \
        "${_flatlaf_src}/src/main/cpp/"*.cpp \
        -L"${JAVA_HOME}/lib" -ljawt $(pkg-config --libs gtk+-3.0) \
        -o "${srcdir}/lib/${_flatlaf_so_name}"
}

package() {
    cd "${pkgname}"

    install -Dm644 "build/libs/PeerBanHelper.jar" "${pkgdir}/usr/share/java/${pkgname}/${pkgname}.jar"
    install -Dm644 "build/libraries/"*.jar -t "${pkgdir}/usr/share/java/${pkgname}/libraries"

    install -Dm755 "${srcdir}/lib/"*.so -t "${pkgdir}/usr/lib/${pkgname}"

    install -Dm755 "${srcdir}/${pkgname}.sh" "${pkgdir}/usr/bin/${pkgname}"
    install -Dm644 "${srcdir}/${pkgname}.sysusers" "${pkgdir}"/usr/lib/sysusers.d/${pkgname}.conf
    install -Dm644 "${srcdir}/${pkgname}.service" -t "${pkgdir}/usr/lib/systemd/system"
}
