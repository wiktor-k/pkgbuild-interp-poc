pkgname = percona-server-clients
	pkgdesc = Percona Server client tools
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = zlib
	depends = zstd
	depends = openssl
	depends = jemalloc
	depends = libfido2
