pkgname=performous
pkgver=1.3.1
pkgrel=22
pkgdesc='A free game like "Singstar", "Rockband" or "Stepmania"'
arch=('x86_64')
url="https://performous.org/"
license=('GPL-2.0-or-later')
depends=(
  'aubio'
  'boost-libs'
  'cairo'
  'ffmpeg'
  'fontconfig'
  'libgcc'
  'libstdc++'
  'glib2'
  'glibc'
  'glibmm'
  'icu'
  'fmt'
  'libepoxy'
  'libjpeg-turbo'
  'libpng'
  'librsvg'
  'libxml++2.6'
  'opencv'
  'pango'
  'portaudio'
  'portmidi'
  'sdl2'
)
makedepends=(
  'cmake'
  'boost'
  'git'  # TODO: this is used to clone sources during build time and should be devendored!!!
  'glm'
  'help2man'
  'nlohmann-json'
  'mesa'
)
optdepends=('performous-freesongs: free songs for performous')
options=('!lto')
source=($pkgname-$pkgver.tar.gz::https://github.com/performous/performous/archive/refs/tags/${pkgver}.tar.gz
        ffmpeg-7.patch
        0001-Fix-compatibility-with-ffmpeg-8.patch
        boost-1.89.patch)
sha512sums=('0c8ffe9eb9d6b6f177917b56f084399f104c57041ad2c23bee211e0fa1380a1875ccc258a07c269997b15f802a3c5d24b2c4d83a132da4cd5033a2c8bb25e1b4'
            '6ec94f7c0ac2142fdbdeb7ebc94ad499e7f4b4a30c8d8303d46627472b89dd252822813b9fec6249695a8be018b6f6a426d28c30aa806b4756e6964d09501735'
            'ca03f0acb85bd99ac8346a494d22b2be857eea1ef5453141120c7aef56b028316f844f171e46fc73bacfb66299a9193025242be4f2e99e064b954e60314cc47c'
            'fac203223d2f7078a500a791de5bdeec996e9dfd4ca7958400ba7d9fd698cced9a8ce6f47ce93478f38b76dceb7d239d40079fe92dfd57708b7f3634a074fd6f')

prepare() {
  cd $pkgname-$pkgver

  sed -e '/-Werror/d' -i */CMakeLists.txt

  # Fix build with ffmpeg 8
  patch -p1 -i ../ffmpeg-7.patch
  patch -p1 -i ../0001-Fix-compatibility-with-ffmpeg-8.patch

  patch -p1 -i ../boost-1.89.patch
}

build() {
  local cmake_options=(
    -B build
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_CXX_FLAGS="$CXXFLAGS -Wno-error=unused-result" # Fix build with GCC 14
    -S $pkgname-$pkgver
    -W no-dev
  )

  cmake "${cmake_options[@]}"
  cmake --build build --verbose
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
