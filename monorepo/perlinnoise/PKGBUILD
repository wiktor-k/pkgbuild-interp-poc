# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=perlinnoise
_name=PerlinNoise
pkgver=3.0.0
pkgrel=1
pkgdesc="Header-only Perlin noise library for modern C++ (C++17/C++20)"
arch=(any)
url="https://github.com/Reputeless/PerlinNoise/"
license=(MIT)
source=("$pkgname-$pkgver.tar.gz::${url}archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('5e79e10ea7f32e0bcf0c45f13f59805a592475b5ff6ea9409e4c7b8fd83f25deea80acc96bea3143c25db81c7966ee11c773c91bf22c9731cf2d8f63d816c837')
b2sums=('6fd4e4151e5f66e467574d8d5716ad7cd094f1e1ec651e9b79216c398ecb791b238562fa31214721560b62a0c30bb6450686330640ec64c6066686734d51a541')

package() {
  install -vDm 644 $_name-$pkgver/${_name}.hpp -t "$pkgdir/usr/include/"
  install -vDm 644 $_name-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 $_name-$pkgver/README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
