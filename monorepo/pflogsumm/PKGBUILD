# Maintainer: Sebastien Luttringer

pkgname=pflogsumm
pkgver=1.2.0
pkgrel=2
pkgdesc='Postfix log entry summarizer'
url='https://athena.linxnet.com/postfix_contrib.html'
license=('GPL-2.0-or-later')
arch=('any')
depends=('perl' 'perl-date-calc')
optdepends=('perl-config-simple')
validpgpkeys=('EA9B405D506516A5E05E77FB3889C1A2FE5F530F')
source=("https://athena.linxnet.com/downloads/$pkgname-$pkgver.tar.gz"{,.asc})
sha256sums=('82a1b5558aad4e15ba2b46124fccc6a56a55610d80b43df6eee5f5fb0677ea6b'
            'SKIP')

package() {
  cd $pkgname-$pkgver
  install -D -m755 pflogsumm "$pkgdir/usr/bin/pflogsumm"
  install -D -m644 pflogsumm.1 "$pkgdir/usr/share/man/man1/pflogsumm.1"
  install -D -m644 pflogsumm-faq.txt "$pkgdir/usr/share/doc/$pkgname/FAQ"
}
