# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=planify
pkgver=4.20.0
pkgrel=2
pkgdesc='Task manager with Todoist, Nextcloud and CalDAV support designed for GNOME'
arch=(x86_64)
url='https://useplanify.com/'
license=(GPL-3.0-or-later)
depends=(
  cairo
  chrono
  dconf
  evolution-data-server
  glib2
  glibc
  gtk4
  gtksourceview5
  gxml
  hicolor-icon-theme
  icu
  json-glib
  libadwaita
  libgee
  libgoa
  libical
  libportal
  libportal-gtk4
  libsecret
  libsoup3
  libspelling
  pango
  sqlite
)
makedepends=(
  git
  meson
  vala
)
source=("git+https://github.com/alainm23/planify.git#tag=v$pkgver")
b2sums=(6109010d1d41d52c0484a5e1bb78b32850ef0ebeba80cb757e832333fde9f3b11570be83d88c1c72a7e22b489ec85cd1e9a6cc500df5cd2190283b7611105766)

prepare() {
  cd $pkgname
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  # core test needs installed GSettings schema
  meson test -C build --print-errorlogs --exclude io.github.alainm23.planify:core
}

package() {
  meson install -C build --destdir "$pkgdir"
  ln -s io.github.alainm23.planify "$pkgdir/usr/bin/planify"
  ln -s io.github.alainm23.planify.cli "$pkgdir/usr/bin/planify-cli"
  ln -s io.github.alainm23.planify.quick-add "$pkgdir/usr/bin/planify-quick-add"
}
