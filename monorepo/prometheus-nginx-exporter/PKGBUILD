# N.B. we're using a slightly modified package name for consistency with other
# prometheus exporters at the request of arojas.
_pkgname=nginx-prometheus-exporter
pkgname=prometheus-nginx-exporter
pkgdesc='NGINX Prometheus Exporter for NGINX and NGINX Plus'
pkgver=1.5.3
pkgrel=1
arch=(x86_64)
license=('Apache-2.0')
url="https://github.com/nginxinc/nginx-prometheus-exporter"
depends=(glibc)
provides=($_pkgname)
conflicts=($_pkgname)
replaces=($_pkgname)
makedepends=(go)
backup=(etc/conf.d/prometheus-nginx-exporter)
source=(${_pkgname}-${pkgver}.tar.gz::https://github.com/nginxinc/nginx-prometheus-exporter/archive/v${pkgver}.tar.gz
        prometheus-nginx-exporter.service
        prometheus-nginx-exporter.conf)
sha512sums=('36554b5bd78f8470e61f8562be03704f779871cfd19f6a3472f45275f170be5ae57f2adc57ca48cfb8c03bf451cba778ab6b27d8dde67c5acd9a5902faf1dfe6'
            '4868bd54d20dd3f4f67bd0623c9f28121d1dd9f0ddf75a6e9ba0098d4b6722b726c92de4ef9f6e31c9826dec4685d6d4e5594e8d66de6665050481039d6d8bdb'
            '843d6903c8da8356cef0c53722c176f5ed12d140a2888f3f3cf5dedaf6437fdc3c0a527ba6635bd949b28a64af98221aeb5caa13edb12b05a712c6e2aadddf77')

build() {
  cd "$_pkgname-$pkgver"
  go build \
    -trimpath \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-linkmode external -extldflags \"${LDFLAGS}\"  -X main.version=${pkgver} -X main.gitCommit=${pkgver}" \
    .
}

check() {
  cd "$_pkgname-$pkgver"
  go test ./...
}

package() {
  install -Dm644 prometheus-nginx-exporter.service "${pkgdir}"/usr/lib/systemd/system/prometheus-nginx-exporter.service
  install -Dm644 prometheus-nginx-exporter.conf "${pkgdir}"/etc/conf.d/prometheus-nginx-exporter

  cd "$_pkgname-$pkgver"
  install -Dm755 $_pkgname "$pkgdir"/usr/bin/$pkgname
}
