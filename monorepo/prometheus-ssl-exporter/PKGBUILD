pkgrel=1
pkgdesc='Prometheus exporter for TLS certificates'
arch=(x86_64)
url='https://github.com/piotrkochan/ssl_exporter'
license=(MIT)
makedepends=(go git)
backup=(
  etc/prometheus/ssl-exporter.yml
  etc/prometheus/ssl-exporter.env
)
options=(!lto)
source=(
  "$pkgname::git+$url.git#tag=v$pkgver"
  systemd.service
  sysusers.conf
  config.yml
  config.env
)
