# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=python-aiodiscover
pkgver=3.3.2
pkgrel=1
pkgdesc='Discover Hosts via ARP and PTR lookup'
arch=(any)
url=https://github.com/bdraco/aiodiscover
license=(Apache-2.0)
depends=(
  python
  python-cached-ipaddress
  python-ifaddr
  python-pyroute2
  python-aiodns
  python-pycares
)
makedepends=(
  git
  python-build
  python-installer
  python-poetry-core
  python-wheel
)
source=(git+https://github.com/bdraco/aiodiscover.git#tag=v${pkgver})
b2sums=('350f4a09d5c10952707352199b7a9c20db8691ce5bf048ef389956cb5f716aa7fba33498f3d4e211c86f0c9afde5eac7a0a0018fd5111e071eba8621be7572b3')

build() {
  cd aiodiscover
  python -m build --wheel --no-isolation
}

package() {
  python -m installer --destdir="${pkgdir}" aiodiscover/dist/*.whl
}

