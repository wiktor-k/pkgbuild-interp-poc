# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=python-babel-glade
pkgver=0.7.2
pkgrel=1
pkgdesc='Message catalog extractor for Glade XML, extending Babel'
arch=(any)
url='https://github.com/gnome-keysign/babel-glade'
license=(BSD-3-Clause)
depends=(
  python
  python-babel
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("git+https://github.com/gnome-keysign/babel-glade.git#tag=$pkgver")
b2sums=(fd6a3a38c5e2576f5518327fdbf1638335325036c2da75bee695dcca3865b10a90b5c82ef280e3a31e1f06fcb768c65430adef8f959447148f00c704eada3b56)

build() {
  cd babel-glade
  python -m build --wheel --no-isolation
}

check() {
  cd babel-glade
  pytest
}

package() {
  cd babel-glade
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE

  # Remove installed tests
  rm -r "$pkgdir$(python -c 'import site; print(site.getsitepackages()[0])')"/babelglade/tests/
}
