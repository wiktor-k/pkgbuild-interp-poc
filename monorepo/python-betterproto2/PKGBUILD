# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=python-betterproto2
pkgver=0.10.0
pkgrel=1
pkgdesc='A better Protobuf / gRPC generator & library'
url='https://github.com/betterproto/python-betterproto2'
arch=('any')
license=('MIT')
depends=(
  python
  python-pydantic
  python-pydantic-core
  python-typing_extensions
)
makedepends=(
  python-build
  python-installer
  python-uv-build
  python-wheel
)
source=(${pkgname}-${pkgver}.tar.gz::https://github.com/betterproto/${pkgname}/archive/refs/tags/lib-v${pkgver}.tar.gz)
b2sums=('e1d6be8c711591f7ef7d5fa9e0cda243b20f19930ae38d4c628f02f2c89688706786b36916a4dab82d44710f329a0440c5a9a7c154ca03a207bd8e751c7c368a')

build() {
  cd "${pkgname}-lib-v${pkgver}/betterproto2"
  python -m build --wheel --no-isolation
}

check() {
  local _site_packages=$(python -c "import site; print(site.getsitepackages()[0])")

  cd "${pkgname}-lib-v${pkgver}/betterproto2"
  python -m installer --destdir=test_dir dist/*.whl

  PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH" python -c 'import betterproto2'
}

package() {
  cd "${pkgname}-lib-v${pkgver}/betterproto2"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -D ../LICENSE.md "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

