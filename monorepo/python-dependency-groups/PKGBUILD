# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>
# Contributor: Daniel Bershatsky <bepshatsky@yandex.ru>

_name=dependency-groups
pkgname=python-$_name
pkgver=1.3.2
pkgrel=1
pkgdesc="A standalone implementation of PEP 735 Dependency Groups"
arch=(any)
url="https://github.com/pypa/dependency-groups"
license=(MIT)
depends=(
  python
  python-packaging
  python-tomli
)
makedepends=(
  python-build
  python-flit-core
  python-installer
  python-wheel
)
checkdepends=(
  python-pytest
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
b2sums=('2f1044bf10712e61fb577e6ca192ebc1d3f3c825585eb753213d4f3917cc70e08e42eac60a9d2a6e98f75d19570e71ba6b32af2571bd9501c841e825eae5f1b0')

build() {
  cd $_name-$pkgver
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
  )

  cd $_name-$pkgver
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest "${pytest_options[@]}" tests
}

package() {
  cd $_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname/
}
