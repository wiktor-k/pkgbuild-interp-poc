# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=python-erbsland-sphinx-ansi
_name=${pkgname#python-}
pkgver=1.2.4
pkgrel=1
pkgdesc="A Sphinx extension to format ANSI colored/formated terminal output"
arch=(any)
url="https://github.com/erbsland-dev/erbsland-sphinx-ansi"
license=(Apache-2.0)
depends=(
  python
  python-docutils
  python-sphinx
)
makedepends=(
  python-build
  python-hatchling
  python-hatch-vcs
  python-installer
)
checkdepends=(
  python-pytest
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('0b59e64ce3de0b47f30183b8f712642f93f1ad0f77154976df2bc3709007ccad4d50b4ea014d54f90d802b83be38ef722b04e40e6a3c86b57c44b9fdd459f05f')
b2sums=('9beac79f42c9f25e5058d26384118e2b70b95cac3556eb87decfb4a5989937d927739ba0a40c16df2717ecf88edaaa4c6ce96b5baec3e33db01314ad80ea3c43')

build() {
  cd $_name-$pkgver
  SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver python -m build --wheel --no-isolation
}

check() {
  cd $_name-$pkgver
  pytest -vvv
}

package() {
  cd $_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
}
