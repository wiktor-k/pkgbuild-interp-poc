# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>

_name=fast-simplification
pkgname=python-$_name
pkgver=0.2.0
pkgrel=1
pkgdesc="Fast quadric mesh simplification"
arch=(x86_64)
url="https://github.com/pyvista/fast-simplification"
license=(MIT)
depends=(
  glibc
  libgcc
  libstdc++
  python
  python-numpy
)
makedepends=(
  nanobind
  python-build
  python-installer
  python-scikit-build-core
  python-setuptools-scm
)
checkdepends=(
  python-pytest
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz)
b2sums=('2f575c7815e6bbc2f9496c3f9959feb17d0877bc8a5c81f48f06eef6333becf91d16f86aef219b46f1ef21583f144ea9a14b8a97afe562c7444f811fcc8cbcb7')

build() {
  cd $_name-$pkgver
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
    -W ignore::DeprecationWarning
  )

  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer $_name-$pkgver/dist/*.whl
  test-env/bin/python -m pytest "${pytest_options[@]}" $_name-$pkgver/tests
}

package() {
  cd $_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
