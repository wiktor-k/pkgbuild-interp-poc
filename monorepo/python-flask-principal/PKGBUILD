# Maintainer: Levente Polyak <anthraxx[at]archlinux[dot]org>
# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=python-flask-principal
pkgver=0.5.0
pkgrel=1
pkgdesc='Identity management for Flask applications'
arch=('any')
url='https://github.com/pallets-eco/flask-principal'
license=('MIT')
depends=(
  'python'
  'python-flask'
)
makedepends=(
  'python-blinker'
  'python-build'
  'python-flit-core'
  'python-installer'
  'python-sphinx'
  'python-wheel'
)
source=("$url/archive/$pkgver/$pkgname-$pkgver.tar.gz")
b2sums=('cb0e370f57c0737563bfa112304ea90677150e6e93b8a23b78c8dc7d92d8ce2011ede5c086b28ad79625a89d8f669e013d2302fdd96a5bd5c124a089221e4805')

prepare() {
  cd ${pkgname#python-}-$pkgver
  # 'author' is not a valid PEP 621 key, flit-core 4 rejects it
  sed -i 's/^author = /authors = /' pyproject.toml
}

build() {
  cd ${pkgname#python-}-$pkgver
  # Upstream pins flit_core<4, we build against 4.x
  python -m build --wheel --no-isolation --skip-dependency-check
  sphinx-build -b text docs docs/_build/text
  sphinx-build -b man docs docs/_build/man
}

check() {
  cd ${pkgname#python-}-$pkgver
  # The module lives in src/ since 0.5.0, so test the built wheel
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m unittest discover -v -s tests -t tests
}

package() {
  cd ${pkgname#python-}-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 -t "$pkgdir/usr/share/doc/$pkgname" README.md CHANGES
  install -vDm 644 -t "$pkgdir/usr/share/doc/$pkgname" docs/_build/text/*.txt
  install -vDm 644 docs/_build/man/flask-principal.1 "$pkgdir/usr/share/man/man1/$pkgname.1"
  install -vDm 644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE.txt
}
