# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=python-fxrays
pkgver=1.3.6
pkgrel=1
pkgdesc='Computes extremal rays of polyhedral cones'
url='https://snappy.computop.org/'
depends=(glibc
         python)
makedepends=(cython
             git
             python-build
             python-installer
             python-setuptools)
license=(GPL-2.0-or-later)
arch=(x86_64)
source=(git+https://github.com/3-manifolds/FXrays#tag=${pkgver}_as_released)
sha256sums=('77cde25e90d90846ced4b278f8307f9783b693d18a014290480306c2317c1912')

build() {
  cd FXrays
  python -m build --wheel --no-isolation
}

package() {
  cd FXrays
  python -m installer --destdir="$pkgdir" dist/*.whl
}
