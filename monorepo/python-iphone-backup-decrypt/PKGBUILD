# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

_pyname=iphone_backup_decrypt
pkgname=python-iphone-backup-decrypt
pkgver=0.11.2
pkgrel=1
pkgdesc="Decrypt and extract files from an iOS13+ encrypted local backup"
arch=(any)
url='https://github.com/jsharkey13/iphone_backup_decrypt'
license=('MIT AND BSD-3-Clause')
depends=(
  'python'
  'python-fastpbkdf2'
  'python-pycryptodome'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
source=("https://files.pythonhosted.org/packages/source/${_pyname::1}/$_pyname/$_pyname-$pkgver.tar.gz")
sha512sums=('b4610e981fc295e60b413d84c2f3d41d06c91a88eaabb75dc93c067ee0b1377a599b1b9515c613f1fc379b3ac78fe0d45531b7994dd5d7c9d5ac3e9356936892')

build() {
  cd "${_pyname}-${pkgver}"
  python -m build --wheel --no-isolation
}

check() {
  local _site_packages=$(python -c "import site; print(site.getsitepackages()[0])")

  cd "${_pyname}-${pkgver}"
  python -m installer --destdir=test_dir dist/*.whl

  PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH" python -c 'import iphone_backup_decrypt'
}

package() {
  cd "${_pyname}-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -D LICENSE.txt -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

