# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

_pyname=json-stream-rs-tokenizer
pkgname=python-${_pyname}
pkgver=0.5.3
pkgrel=1
pkgdesc='Faster tokenizer for the json-stream Python library'
arch=(x86_64)
url="https://github.com/smheidrich/py-json-stream-rs-tokenizer"
license=('MIT')
depends=(
  libgcc
  glibc
  python
)
makedepends=(
  python-build
  python-installer
  python-setuptools-rust
  python-wheel
)
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/smheidrich/py-json-stream-rs-tokenizer/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('0af6894caf754f2caae460b8ccd7d48ae6af9b2a4ba4ff4ec8c21104af1a3c1d')
b2sums=('c13e1deb85774a6fd6349836bb1502ac6e6cc243e83a9e46e1d5d521179692aa7f43e5c3d41bd28e8c2b6e51a9c7ea31cba23e2c78f6399aaaf98c5183c298a8')

build() {
  cd "py-${_pyname}-${pkgver}"
  python -m build --wheel --no-isolation
}

check() {
  local _site_packages=$(python -c "import site; print(site.getsitepackages()[0])")

  cd "py-${_pyname}-${pkgver}"
  python -m installer --destdir=test_dir dist/*.whl

  PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH" python -c 'import json_stream_rs_tokenizer'
}

package() {
  cd "py-${_pyname}-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

