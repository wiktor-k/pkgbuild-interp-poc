# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.62
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('65b0a27811dbc8baaaf730b2459afb4ddfa7fbf5c6d808d700fb0cacbca42dc21d682b2f48bc7fa9c5f6a1b04500993e299ef2b24fa8302bea9ec529d41c0978')
b2sums=('563ea63451da74939384e3debca8bb2dcfa3e27fc585c4fbedeb5ccf0bb5548e64fd6791443f59518c5b01f54016b56a2010ac37ab0091beb54c1069cbdbc744')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
