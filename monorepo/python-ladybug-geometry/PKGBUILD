# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-geometry
pkgver=1.35.6
pkgrel=1
pkgdesc='Python library housing basic geometry objects and computation methods'
arch=(any)
url='https://github.com/ladybug-tools/ladybug-geometry'
license=(AGPL-3.0-only)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('a0416073dc75a558c5612521d00f026a0ef19664cf8144030daee8598377a77171bd6eb90c1b02ceea739f2522518120521ced83ab4975370e16491a3d23a0a9')
b2sums=('05d2e453641cba22398c2a5eb1abcea88ba289273256f006a277bc14900ee5ef089d81d6a424324e6e83896105091f51d8d9edd1c6616b40d5db589f1f30f9a4')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
