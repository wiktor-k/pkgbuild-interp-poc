# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-langchain-text-splitters
pkgver=1.1.3
pkgrel=1
pkgdesc="LangChain text splitting utilities"
arch=('any')
url="https://github.com/langchain-ai/langchain"
license=('MIT')
depends=(
  'python'
  'python-langchain-core'
)
makedepends=(
  'git'
  'python-build'
  'python-hatchling'
  'python-installer'
  'python-wheel'
)
checkdepends=(
  'python-beautifulsoup4'
  'python-lxml'
  'python-pytest'
  'python-pytest-asyncio'
)
source=("git+https://github.com/langchain-ai/langchain.git")
sha512sums=('SKIP')

prepare() {
  cd langchain

  # makepkg's git fragment parser treats "=" inside tag values as separators.
  git checkout -q "langchain-text-splitters==$pkgver"
}

build() {
  cd langchain/libs/text-splitters
  python -m build --wheel --no-isolation
}

check() {
  cd langchain/libs/text-splitters

  # These integration tests require model/data downloads or unpackaged NLP stacks.
  pytest tests/unit_tests tests/integration_tests \
    --ignore=tests/integration_tests/test_nlp_text_splitters.py \
    --ignore=tests/integration_tests/test_text_splitter.py
}

package() {
  cd langchain/libs/text-splitters
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 ../../LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
