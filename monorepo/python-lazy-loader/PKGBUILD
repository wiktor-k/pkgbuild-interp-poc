# Maintainer: Maxime Gauduin <alucryd@archlinux.org>
# Contributor: Butui Hu <hot123tea123@gmail.com>

pkgname=python-lazy-loader
pkgver=0.6
pkgrel=1
pkgdesc='Populate library namespace without incurring immediate import costs'
arch=(any)
url=https://github.com/scientific-python/lazy_loader
license=(BSD-3-Clause)
depends=(
  python
  python-importlib-metadata
  python-packaging
)
makedepends=(
  git
  python-build
  python-flit-core
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=(git+https://github.com/scientific-python/lazy-loader.git#tag=v${pkgver})
b2sums=('feb1bde3fba3da9121f08f2831e97044f16e83fd654f4ed01a11a582b7d1401f2e8bd7751efd41fcca346035ccce7d1e34e886cfaab43c3edca540a266e587ed')

build() {
  cd lazy-loader
  python -m build --wheel --no-isolation
}

check() {
  cd lazy-loader
  PYTHONPATH="$PWD/src" pytest -v
}

package() {
  python -m installer --destdir="${pkgdir}" lazy-loader/dist/*.whl
  install -Dm 644 lazy-loader/LICENSE.md -t "${pkgdir}"/usr/share/licenses/python-lazy-loader/
  local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  rm -rf ${pkgdir}${site_packages}/lazy_loader/tests
}

