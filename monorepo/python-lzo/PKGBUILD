# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-lzo
pkgver=1.16
pkgrel=1
pkgdesc='Python bindings for the LZO data compression library'
arch=(x86_64)
url='https://github.com/jd-boyd/python-lzo'
license=(GPL-2.0-only)
depends=(
  python
  lzo
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('0c9b55ddde05a3aeeb9946508da0fc73a00630559f79eb53df75963fbbfc12e25904f904590d6ce6e647768ae670d1e6322d53cd5703f1b1b83852b15e7a05a5')
b2sums=('d254087a3f1b5433eaf7da1861ae416f554c353604640ea07e0e8d81566ee6079c6fea8fd21a5ca0d0b5b8593cdd34f91f7640c035dd1d700bb4e3791b507633')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  # temporary install
  python -m installer --destdir="$(pwd)/tmp" dist/*.whl
  local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  export PYTHONPATH="$(pwd)/tmp/$site_packages"

  pytest -v
}

package() {
  depends+=(glibc)

  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
