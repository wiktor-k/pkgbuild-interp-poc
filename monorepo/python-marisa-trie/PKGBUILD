# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-marisa-trie
pkgver=1.4.1
pkgrel=1
pkgdesc="Static memory-efficient and fast Trie-like structures for Python"
arch=('x86_64')
url="https://github.com/pytries/marisa-trie"
license=('MIT')
depends=(
  'marisa'
  'python'
)
makedepends=(
  'cython'
  'git'
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
checkdepends=(
  'python-hypothesis'
  'python-pytest'
  'python-pytest-run-parallel'
  'python-readme-renderer'
)
source=(
  "git+https://github.com/pytries/marisa-trie.git#tag=$pkgver"
  'devendor-system-marisa.patch'
)
sha512sums=('211566c6a90394b9624160565cabf357a78e97d7d496f8a364600b90e506e6cc323bd48a1841e810e7e375a5e78f1221347848773d8c7f86b3766a74ff1481fa'
            'b9ac3659eafbde51ccf8b3115ec5c6a628032fda02ad64fa4743878f21272ceae597579c35602e5a18d9917a3c9baca2073a7fe757759fe0285eef133818b1c2')

prepare() {
  cd marisa-trie
  git cherry-pick -n c79fa73e968866a74028cf6261f5b1e02e58f007
  patch -Np1 -i ../devendor-system-marisa.patch
}

build() {
  cd marisa-trie
  python -m build --wheel --no-isolation
}

check() {
  cd marisa-trie
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd marisa-trie
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
