# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-mfusepy
pkgver=3.1.1
pkgrel=2
pkgdesc='Ctypes bindings for the high-level API in libfuse 2 & 3'
arch=(any)
url='https://github.com/mxmlnkn/mfusepy'
license=(ISC)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-pytest
  python-pytest-order
  python-pytest-xdist
  fuse2
  fuse3
  python-ioctl-opt
)
optdepends=(fuse2 fuse3)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('3140e5a8bbec2be1f5c5dfefb70b8b3034d9323a9b99c9cc176c4ce5f4ae3f90662d25d0fb95edb4910bb922a62fb7a4dc0e67ce55054f1a6dea05b5cddf2f65')
b2sums=('dd55a1b5d1c6495cde8369a91ed33ef65f57d235e4d7cbc80bb4bd87e1c8fa1c724c2042362f9b1fb057838d1c736f49f4993224cb61b4280b423fcedd75d070')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
