# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-opentracing
pkgver=2.4.0
pkgrel=6
pkgdesc="OpenTracing API for Python"
url="https://github.com/opentracing/opentracing-python"
license=('Apache-2.0')
arch=('any')
depends=('python')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-gevent' 'python-pytest' 'python-six' 'python-tornado')
source=("git+https://github.com/opentracing/opentracing-python.git#tag=$pkgver" "python-3.11-compat.patch")
sha512sums=('SKIP'
             '920ae7fd81d33957dbc46105a62371022391645a40a23debe52764771f9562e287cae7f3485894bb562ce5bf6f91b6b9ae37a16ff8c1dec6099e235e4fba3dad')

prepare() {
  cd opentracing-python
  patch -Np1 -i ${srcdir}/python-3.11-compat.patch
  sed -i 's/^import mock$/from unittest import mock/' opentracing/harness/*.py tests/*.py tests/*/*.py
  sed -i 's/asyncio.get_event_loop().run_until_complete(async_test_fn())/asyncio.run(async_test_fn())/' tests/scope_managers/test_asyncio.py tests/scope_managers/test_contextvars.py
  sed -i 's/self.loop = asyncio.get_event_loop()/self.loop = asyncio.new_event_loop(); asyncio.set_event_loop(self.loop)/' testbed/*/*.py
  sed -i 's/assertEquals/assertEqual/g' testbed/*/*.py
}

build() {
  cd opentracing-python
  python -m build --wheel --no-isolation
}

check() {
  cd opentracing-python
  pytest tests
  python -m testbed
}

package() {
  cd opentracing-python
  python -m installer --destdir="$pkgdir" dist/*.whl
}
