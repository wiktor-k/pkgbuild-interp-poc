# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-ormsgpack
pkgver=1.13.0
pkgrel=1
pkgdesc="Fast, correct Python msgpack library supporting dataclasses, datetimes, and numpy"
arch=('x86_64')
url="https://github.com/ormsgpack/ormsgpack"
license=('Apache-2.0' 'MIT')
depends=(
  'glibc'
  'libgcc'
  'python'
)
makedepends=(
  'cargo'
  'git'
  'python-build'
  'python-installer'
  'python-maturin'
  'python-wheel'
)
checkdepends=(
  'python-dateutil'
  'python-msgpack'
  'python-numpy'
  'python-pendulum'
  'python-pydantic'
  'python-pytest'
  'python-pytz'
)
source=("git+https://github.com/ormsgpack/ormsgpack.git#tag=$pkgver")
sha512sums=('1eaea2cf37a501c2b934375c6324706f89fda935c8c488d2664c6594917461d2a46dd451b4f7f473263398175e9d199f883a5ab5526ebc5d7578a4714bcc6700')

prepare() {
  cd ormsgpack
  cargo fetch --locked
}

build() {
  cd ormsgpack
  CARGO_NET_OFFLINE=true python -m build --wheel --no-isolation
}

check() {
  cd ormsgpack
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd ormsgpack
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE-APACHE LICENSE-MIT -t "$pkgdir"/usr/share/licenses/$pkgname/
}
