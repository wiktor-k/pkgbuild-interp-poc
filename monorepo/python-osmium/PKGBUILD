# Maintainer: Justin Kromlinger <hashworks@archlinux.org>
# Contributor: Simon Legner <Simon.Legner@gmail.com>

pkgname=python-osmium
pkgver=4.3.2
pkgrel=1
pkgdesc="Python bindings for libosmium, the data processing library for OSM data"
url="https://osmcode.org/pyosmium"
depends=('python' 'libosmium' 'pybind11' 'python-requests' 'python-urllib3' 'bzip2' 'zlib' 'lz4' 'expat' 'glibc')
makedepends=('python-build' 'python-installer' 'python-scikit-build-core' 'cmake' 'protozero')
checkdepends=('python-pytest' 'python-pytest-httpserver' 'python-shapely' 'python-numpy')
replaces=('pyosmium')
provides=('python-pyosmium' 'pyosmium')
license=('BSD-2-Clause')
arch=('x86_64')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/osmcode/pyosmium/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('54e575e4552562e33823e5ca49de06f1b2545f0288fbe97ffd95b50266b523f1')

build() {
    cd "pyosmium-${pkgver}"

    python -m build --wheel --no-isolation
}

check() {
    cd "pyosmium-${pkgver}"
    python -m installer --destdir=check_dir dist/*.whl
    export PYTHONPATH="$(echo check_dir/usr/lib/python3*/site-packages)"
    python -m pytest test
}

package() {
    cd "pyosmium-${pkgver}"

    python -m installer --destdir="${pkgdir}" dist/*.whl

    install -Dm644 LICENSE.TXT "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.TXT"
}
