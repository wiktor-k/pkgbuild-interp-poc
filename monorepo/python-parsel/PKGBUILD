# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-parsel
pkgver=1.12.1
pkgrel=1
pkgdesc="Library to extract data from HTML and XML using XPath and CSS selectors"
arch=('any')
license=('BSD-3-Clause')
url="https://github.com/scrapy/parsel"
depends=('python-cssselect' 'python-jmespath' 'python-lxml' 'python-w3lib')
makedepends=('git' 'python-build' 'python-hatchling' 'python-installer')
checkdepends=('python-pytest' 'python-sybil' 'python-psutil')
source=("git+https://github.com/scrapy/parsel.git#tag=v$pkgver")
sha512sums=('e169fd2bff31ea781a0527d740c7296c13d1dd607760c575a11095d00f53c322f5948b137c94fd64e2f3a0a795db3a027382f282dc0da04490e8a4efd66bfbbe')

build() {
  cd parsel
  python -m build --wheel --no-isolation
}

check() {
  cd parsel
  python -m pytest
}

package() {
  cd parsel
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
