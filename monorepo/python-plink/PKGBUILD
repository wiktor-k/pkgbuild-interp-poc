# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=python-plink
pkgver=2.4.9
pkgrel=1
pkgdesc='Plink is used to draw link projections and create data structures which describe the projections'
url='https://snappy.computop.org/'
depends=(python)
makedepends=(git
             python-build
             python-installer
             python-setuptools
             python-sphinx)
license=(GPL-2.0-or-later)
arch=(any)
source=(git+https://github.com/3-manifolds/Plink#tag=${pkgver}_as_released)
sha256sums=('74469eb185777dde384b92a0f81f587b283754631f60026a5b6a602f1a16fcdf')

build() {
  cd Plink
  python -m build --wheel --no-isolation --skip-dependency-check
}

package() {
  cd Plink
  python -m installer --destdir="$pkgdir" dist/*.whl
}
