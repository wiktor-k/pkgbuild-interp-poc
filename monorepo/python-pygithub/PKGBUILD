# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-pygithub
pkgver=2.10.0
pkgrel=1
pkgdesc="Use the full Github API v3"
arch=('any')
license=('LGPL-3.0-or-later')
url="https://github.com/PyGithub/PyGithub"
depends=('python-pyjwt' 'python-requests' 'python-pynacl' 'python-typing_extensions' 'python-urllib3')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools-scm' 'python-wheel')
checkdepends=('python-pytest' 'python-cryptography' 'python-responses')
source=("git+https://github.com/PyGithub/PyGithub.git#tag=v$pkgver")
sha512sums=('0aef99f5fbc3a6e1e72ff4b001005149ea728f8888a8afc17d05e95a0d38770ca6fbd9ecb3a4912bbd1235a89d7d2eeea2ad5b4532da1d26b3f8def360a3fbb3')

build() {
  cd PyGithub
  python -m build --wheel --no-isolation
}

check() {
  cd PyGithub
  python -m pytest
}

package() {
  cd PyGithub
  python -m installer --destdir="$pkgdir" dist/*.whl
}
