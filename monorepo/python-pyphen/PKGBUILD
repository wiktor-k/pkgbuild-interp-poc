# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=python-pyphen
_name="${pkgname#python-}"
pkgver=0.18.1
pkgrel=1
pkgdesc="Pure Python module to hyphenate text"
arch=(any)
url="https://pyphen.org/"
_url=https://github.com/Kozea/Pyphen
license=(
  GPL-2.0-or-later
  LGPL-2.1-or-later
  MPL-1.1
)
depends=(python)
makedepends=(
  python-build
  python-flit-core
  python-installer
  python-wheel
)
checkdepends=(python-pytest)
source=($pkgname-$pkgver.tar.gz::$_url/archive/refs/tags/$pkgver.tar.gz)
sha512sums=('27d7e1d1a838344b46a90a8fb140c736360a817e74df9e6953b78c18bbcfb47e68ec07a63019b27b3e94a44429e777e059e5139142bbc8c76d107967705446c1')
b2sums=('5b1139a8f6b3666c26261652da4ca2c7bbc4ff64ffa192a069343cbe72fb14376a2667d478f52d1dabd319da796ba29295ef8dd02789c381f5fc9ce69869a286')

build() {
  cd ${_name^}-$pkgver
  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd ${_name^}-$pkgver
  pytest -vv
}

package() {
  cd ${_name^}-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 README.rst -t "$pkgdir/usr/share/doc/$pkgname/"
}
