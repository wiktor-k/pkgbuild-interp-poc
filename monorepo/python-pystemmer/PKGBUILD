# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-pystemmer
pkgver=3.1.0
pkgrel=1
pkgdesc="Snowball stemming algorithms, for information retrieval"
arch=('x86_64')
license=('BSD-3-Clause' 'MIT')
url="http://snowball.tartarus.org"
depends=('python' 'libstemmer')
makedepends=('cython' 'git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("git+https://github.com/snowballstem/pystemmer.git#tag=v${pkgver}")
sha512sums=('7e36cb0aae5b2367530a7561a015da7e8dab29e0e278e6bfce1834d2d7faea501f80f5e86ce5c08fad971f2c15b5d8c05080e22052e7a2f3abd03a7ab0bac0f4')

export PYSTEMMER_SYSTEM_LIBSTEMMER=1

build() {
  cd pystemmer
  python -m build --wheel --no-isolation
}

check() {
  cd pystemmer
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python runtests.py -v
}

package() {
  cd pystemmer
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
