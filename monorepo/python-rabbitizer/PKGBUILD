# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-rabbitizer
pkgver=1.16.2
pkgrel=1
pkgdesc='MIPS instruction decoder API'
arch=(x86_64)
url='https://github.com/Decompollaborate/rabbitizer'
license=(MIT)
depends=(
  glibc
  python
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
source=("$pkgname::git+$url#tag=$pkgver")
sha512sums=('3aaa7981da92369831497fefbb3f4d2f666ae740880433c43e52f05800b180c4ee6fa72f53c07ac1bcb533c8dfbdaa8f2e1e09ceea2adfbceb49c852b7d2495f')
b2sums=('1bcbdcc319ef3e20c77e275bf25a855737e69f6a3a6eb27ce61ee560d1b755b64051dbb905f06be85c8aa20187a477ac1dd801ad0177eb8de8ad454edda01dbb')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
