prepare() {
  cd "$pkgname"

  # prepare git submodule(s)
  git submodule init
  git config submodule.librapidarchive.url "$srcdir/github.com-mxmlnkn-librapidarchive"
  git -c protocol.file.allow=always submodule update --init

  cd librapidarchive
  git submodule init \
    src/external/cxxopts \
    src/external/rpmalloc
  git config submodule.src/external/cxxopts.url "$srcdir/github.com-jarro2783-cxxopts"
  git config submodule.src/external/rpmalloc.url "$srcdir/github.com-mjansson-rpmalloc"
  git -c protocol.file.allow=always submodule update

  # relax version constraints
  patch -p1 -i "$srcdir/remove-version-constraints.patch"

  # prefer fortify3 in makepkg.conf cflags
  patch -p1 -i "$srcdir/remove-cflags-fortify2.patch"
}

build() {
  cd "$pkgname/python/rapidgzip"

  export RAPIDGZIP_BUILD_ISAL=disable
  export RAPIDGZIP_BUILD_ZLIB=system

  python -m build --wheel --no-isolation
}

package() {
  depends+=(
    glibc
    libgcc libgcc_s.so
    libstdc++ libstdc++.so
    zlib libz.so
  )

  cd "$pkgname"

  python -m installer --destdir="$pkgdir" python/rapidgzip/dist/*.whl
  
  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE*
}
