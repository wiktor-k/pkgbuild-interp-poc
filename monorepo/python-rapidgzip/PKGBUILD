pkgname=python-rapidgzip
pkgver=0.16.0
pkgrel=4
pkgdesc='Parallel random access of gzip-compressed files'
arch=(x86_64)
url='https://github.com/mxmlnkn/rapidgzip'
license=('Apache-2.0 OR MIT')
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
  zlib-ng
  cython
)
source=(
  "$pkgname::git+$url#tag=rapidgzip-v$pkgver"
  remove-version-constraints.patch
  remove-cflags-fortify2.patch
  'github.com-mxmlnkn-librapidarchive::git+https://github.com/mxmlnkn/librapidarchive'
  'github.com-jarro2783-cxxopts::git+https://github.com/jarro2783/cxxopts'
  'github.com-mjansson-rpmalloc::git+https://github.com/mjansson/rpmalloc.git'
)
