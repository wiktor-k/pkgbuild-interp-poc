# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ratarmountcore
_pkgbase=ratarmount
pkgver=0.11.1
pkgrel=1
pkgdesc='Random Access To Archived Resources Library'
arch=(any)
url='https://github.com/mxmlnkn/ratarmount'
license=(MIT)
depends=(
  python
  python-indexed-gzip
  python-indexed-zstd
  python-libarchive-c
  python-xz
  python-rapidgzip
  python-rarfile
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
optdepends=(
  # colors
  'python-rich: color coded files in cli'
  # git
  'python-pygit2: git support'
  # fsspec
  'python-fsspec: for remote files'
  'python-aiohttp: for http:// via fsspec'
  'python-requests: for various web backends such as github:// via fsspec'
  'python-s3fs: for s3:// via fsspec'
  'python-smbprotocol: for smb:// via fsspec'
  'python-webdav4: for webdav:// via fsspec'
  # squashfs
  'python-pysquashfsimage: for squashfs images'
  'python-isal: faster decompression of zlib-compressed squashfs images'
  # zip
  'python-fast-zip-decryption: faster zip decryption'
  # 7z
  'python-py7zr: for password-protected 7z archives'
  # ext4
  'python-ext4: for EXT4 images'
  # ssh
  # todo: sshfs
    # sshfs[bcrypt]
    # sshfs[fido2]
    # sshfs[gssapi]
    # sshfs[libnacl]
    # sshfs[python-pkcs11]
    # sshfs[pyOpenSSL]
  # pdf
  # todo: pypdf[image]
)
source=("$_pkgbase::git+$url#tag=core-v$pkgver")
sha512sums=('4c6d1608d369a9edc7c98ef700be63243a5b9e31716157cc5ca7f31d3949f7bbfc409317d6c5b3f3b6020fb6a06b3b6ed1109ad701d6582bfbb6e00dc14d77bc')
b2sums=('03925ef2f127dddb30c5200741fe6b1991278775f52567d61a4a472843425ba54fce6c08a557f11701393bfe9fb8e037c390cd4d937696126f16b3a5fc1511c2')

build() {
  cd "$_pkgbase/core"

  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgbase/core"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
