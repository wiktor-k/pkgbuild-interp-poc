# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-ratelim
pkgver=0.1.6
pkgrel=12
pkgdesc="Makes it easy to respect rate limits"
url="https://github.com/themiurgo/ratelim"
license=('MIT')
arch=('any')
depends=('python-decorator')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("git+https://github.com/themiurgo/ratelim.git#commit=919ceef2afd774864070ae647753daf57538fb9d")
sha512sums=('4fd3bfe67bc2bad38a3051ff86362a487012181278d361c2ca4902f3ba6f31701f4f892026c5c2fa9c8c2871d4a6052b95ad3d7869252667e5b9cb659b451325')

build() {
  cd ratelim
  python -m build --wheel --no-isolation
}

package() {
  cd ratelim
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
