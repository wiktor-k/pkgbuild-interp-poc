# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-xdg-base-dirs
pkgver=6.0.3
pkgrel=1
pkgdesc='Python module for accessing XDG base directory paths'
arch=(any)
url='https://github.com/srstevenson/xdg-base-dirs'
license=(ISC)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-uv-build
)
source=("$pkgname::git+$url#tag=$pkgver")
sha512sums=('ac1adb4dbc1536622e97fa93c091153d71b83e95bd43d11fabdead1aaac2f48290402ea73cecfa7de6c34c397ae94fdba105772cc616e83e918b5c6630d749d3')
b2sums=('10f86e7da200166130355cde24dc0010e68c7fe9da31ae3268942e20c2afad46aa349b215070afce677bdea52b0fb425aaf80f27125977b1e2980fd633d9cbd6')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
