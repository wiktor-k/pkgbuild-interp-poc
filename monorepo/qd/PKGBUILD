pkgname=qd
pkgver=2.3.24
pkgrel=2
pkgdesc='C++/Fortran-90 double-double and quad-double library'
arch=(x86_64)
url='https://www.davidhbailey.com/dhbsoftware/'
license=(BSD-3-Clause)
depends=(glibc
         libgcc
         libgfortran
         libstdc++
         sh)
makedepends=(gcc-fortran
             git
             texlive-latex)
source=(git+https://github.com/BL-highprecision/QD#tag=v$pkgver)
sha256sums=('e89355c0eb883b2a9aa9584ae82fad061d064dfe0177f7e22a23077725c88e55')

prepare() {
  cd QD
  autoreconf -fiv
}

build() {
  cd QD

  export FC=gfortran
  ./configure --prefix=/usr --enable-shared
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

check() {
  cd QD

  make check
}

package() {
  cd QD

  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING "$pkgdir"/usr/share/licenses/$pkgname/COPYING
}
