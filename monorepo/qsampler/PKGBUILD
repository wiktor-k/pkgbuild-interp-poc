pkgname=qsampler
pkgver=1.0.3
pkgrel=1
pkgdesc="A LinuxSampler Qt GUI Interface"
arch=(x86_64)
url="https://qsampler.sourceforge.io/"
license=(GPL-2.0-or-later)
groups=(pro-audio)
depends=(
  glibc
  hicolor-icon-theme
  libgcc
  libstdc++
  linuxsampler
  qt6-base
  qt6-svg
)
makedepends=(
  cmake
  libgig
  liblscp
  qt6-tools
)
source=(https://downloads.sourceforge.net/$pkgname/$pkgname-$pkgver.tar.gz)
sha512sums=('b273563c646398200ddbfc09735b29c5f6c3d33d446ba02c8cd2b2ccb85fa1a0149e6ee6314438b60de7d3dfd7ae7b5bc61c750e831f834b10794d8cb3a3631f')
b2sums=('c06110cbdafdb40579a71aa0ff2d903baf44c29156eba76d68870d10767fd576f09e495f8cdb299970e9930ff05d9f008ca567981ba5c8be775eef94fea5e74a')

build() {
  local cmake_options=(
    -B build
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CONFIG_QT6=ON
    -S $pkgname-$pkgver
    -W no-dev
  )

  cmake "${cmake_options[@]}"
  cmake --build build --verbose
}

package() {
  depends+=(
    libgig libgig.so
    liblscp liblscp.so
  )
  DESTDIR="$pkgdir" cmake --install build
  install -vDm 644 $pkgname-$pkgver/{ChangeLog,README} -t "$pkgdir/usr/share/doc/$pkgname/"
}
