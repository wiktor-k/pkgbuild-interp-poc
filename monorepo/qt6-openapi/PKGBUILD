# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=qt6-openapi
_pkgver=6.12.0
pkgver=${_pkgver/-/}
pkgrel=1
arch=(x86_64)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='OpenAPI Generator for the cpp-qt6-client library'
depends=(glibc
         java-runtime
         libstdc++
         openapi-generator
         qt6-base
         zlib)
makedepends=(cmake
             git
             maven
             ninja)
groups=(qt6)
_pkgfn=${pkgname/6-/}
source=(git+https://code.qt.io/qt/$_pkgfn#tag=v$_pkgver)
sha256sums=('fe20e55a007b2b9646a10d23568c7cd233b2c595f1ca7b45927f2823fd571149')

prepare() {
  cd $_pkgfn
  sed -e 's|1.18.38|1.18.48|' -i src/tools/qtopenapi-generator/pom.xml # Update lombok to fix build
}

build() {
  cmake -B build -S $_pkgfn -G Ninja \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
    -DJava_JAR_PATHS=/usr/share/java/openapi-generator
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-base "$pkgdir"/usr/share/licenses/$pkgname
}
