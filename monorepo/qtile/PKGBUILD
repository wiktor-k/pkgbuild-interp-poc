  'python-psutil: graph, net and memory widget'
  'python-setproctitle: change process name to qtile'
  'python-xdg: launchbar widget'
  'xorg-xwayland: for XWayland support'
)
install=$pkgname.install
source=(
  "git+$_url?signed#tag=v$pkgver"
)
sha512sums=('56e1c1a42452385ff2ace83d4a500e86039f4da3dbf7cbb884d3b836f5d3d00eadac9e76c035abe229d02dc0d64198985047277205ceba70a6396cc3db470e92')
b2sums=('61aba49cd6e4877251b42cb23e5f9f4e52d4c006c01a0e96ca5fc5f9213556038a8182c7b60ee2749cc9c27ae259aca5d43f598c9ce3c5529035a0d7266b6ad0')
validpgpkeys=(
  '3CCAB226289DE0160C61BDB418D18F1BC464DCA3' # Tycho Andersen <tycho@tycho.pizza>
  '35D92E7CC7357A81173EA1C974F9FDD20984FBEC' # Matt Colligan <mcol@posteo.net>
