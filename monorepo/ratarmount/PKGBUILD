# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=ratarmount
pkgver=1.3.0
pkgrel=2
pkgdesc='Random access to archived resources'
arch=(any)
url='https://github.com/mxmlnkn/ratarmount'
license=(MIT)
depends=(
  fuse3
  python
  python-argcomplete
  python-mfusepy
  python-rich
  python-rich-argparse
  python-ratarmountcore
  python-fast-zip-decryption
  python-py7zr
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
optdepends=(
  'python-ext4: for EXT4 images'
  'python-fsspec: for remote files'
  'python-aiohttp: for http:// via fsspec'
  'python-requests: for various web backends such as github:// via fsspec'
  'python-s3fs: for s3:// via fsspec'
  'python-smbprotocol: for smb:// via fsspec'
  'python-webdav4: for webdav:// via fsspec'
)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('32ecbfd5daa2e7db8c50e630cf8754d0518e93d3fe19e24a76d60e2c5c9adc256f3210987496077058b2278ee18b03064c9adccefa5ddc71f09f3f3aedb13baa')
b2sums=('4ac17acb1aa2b29dbbfaf5a0bedb1349851f30fa074ea0d291034d533ef44cd4726e9d948898fb98b3aec3d3e92b90fc042c754032b56dfc041e827670f816f9')


build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
