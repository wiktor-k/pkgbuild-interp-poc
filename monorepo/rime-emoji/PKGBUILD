pkgname=rime-emoji
pkgver=0.0.0.20260325
_commit=d1dbb424124fc50452a179300c7f287dbcc0db64
pkgrel=1
pkgdesc="Emoji support for rime"
arch=('any')
url="https://github.com/rime/rime-emoji"
license=('LGPL-3.0-or-later')
makedepends=('git')
source=("git+https://github.com/rime/rime-emoji.git#commit=$_commit")
sha512sums=('a042398b1fbbb65da7cd9f799c9820d7a17d748a273695d9c3fec2fab98d5026c3c22d22c4c8939800227796c1c0d4bf60d96602fa443c8866f444c2bb413860')

package() {
  cd $pkgname
  install -Dm644 emoji_suggestion.yaml -t "$pkgdir"/usr/share/rime-data/
  install -Dm644 opencc/* -t "$pkgdir"/usr/share/rime-data/opencc/
}
