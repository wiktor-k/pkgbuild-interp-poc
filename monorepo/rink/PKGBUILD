# Maintainer: Daniel M. Capella <polyzen@archlinux.org>

pkgname=rink
pkgver=0.9.0
pkgrel=1
pkgdesc='Unit conversion tool and library written in rust'
arch=(x86_64)
url=https://rinkcalc.app
license=(
  GPL-3.0-or-later
  MPL-2.0
)
depends=(
  curl
  libgcc
  openssl
)
makedepends=(
  asciidoctor
  git
  make
  rust
 )
source=("git+https://github.com/tiffany352/$pkgname-rs.git#tag=v$pkgver?signed")
b2sums=('fcf03e1b399f0cbd7e6692e956f34f437a8b31c0734eec8d7a4507124a0538927db08663313ce120e7098eacc69ab378fbf71b055970095d05a281ec4a6f7358')
validpgpkeys=('BC69595DA4AC1B321854939833F53ED0A9B562C1') # tiffany <tiffany@stormbit.net>

prepare() {
  cd $pkgname-rs
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $pkgname-rs
  make prefix=/usr
}

check() {
  cd $pkgname-rs
  cargo test --locked --offline
}

package() {
  cd $pkgname-rs
  make install prefix=/usr DESTDIR="$pkgdir"/usr
}
