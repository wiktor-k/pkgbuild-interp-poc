# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=rk-expose
pkgver=0.2.0
pkgrel=1
pkgdesc="Expose Linux rootkits"
url='https://codeberg.org/hillu/rk-expose'
arch=('x86_64')
license=('GPL-3.0-or-later')
makedepends=(
  'cargo'
  'musl'
  'rust-musl'
)
source=(${pkgname}-${pkgver}.tar.gz::https://codeberg.org/hillu/${pkgname}/archive/v${pkgver}.tar.gz)
sha256sums=('203e2c61452385d8ec55bf732329247851d7d56298d079e2a64118d6e17949a3')
b2sums=('06d7b5d2478621755b88bd46b6c585468fe551ef2773d659a48a37365b8861affa619130e6cad1c12ead945a4b82c358105f3feb7d5a53fd6536477367219813')

prepare() {
  cd "${pkgname}"
  cargo fetch --locked --target host-tuple
}

_cargo_target() {
  rustc --print host-tuple | sed s/gnu/musl/
}

build() {
  cd "${pkgname}"
  export CARGO_BUILD_TARGET="$(_cargo_target)"
  cargo build --frozen --release
}

check() {
  cd "${pkgname}"
  export CARGO_BUILD_TARGET="$(_cargo_target)"
  cargo test --frozen -- \
    --skip find_existing_procs
  "target/$CARGO_BUILD_TARGET/release/rk-expose" --help
}

package() {
  cd "${pkgname}"
  export CARGO_BUILD_TARGET="$(_cargo_target)"
  install -Dm 755 -t "${pkgdir}/usr/bin" \
    "target/$CARGO_BUILD_TARGET/release/rk-expose"
}

# vim: ts=2 sw=2 et:
