# Maintainer: Levente Polyak <anthraxx[at]archlinux[dot]org>
# Contributor: Bet4 <0xbet4@gmail.com>

_gemname=elftools
pkgname=ruby-${_gemname}
pkgver=2.2.0
pkgrel=1
pkgdesc='ELF parser library implemented in pure Ruby'
url='https://github.com/david942j/rbelftools/'
arch=(any)
license=(MIT)
depends=(
  ruby
  ruby-bindata
)
makedepends=(
  ruby-bundler
  ruby-rake
  ruby-rdoc
)
options=('!emptydirs')
source=(${url}/archive/v${pkgver}/${pkgname}-v${pkgver}.tar.gz)
sha512sums=('a5f5287d757aad8cc692fa7c8cc1213ec3fd8746089faf595881ed22d85c6cb7f7e639463a3050437f724fc643306554da554b21e3d6671eb440eb9d7121a0be')
b2sums=('8e8fc349c715edf9721f816f4e9731f193c92168494b99fa76df56f2a6229fb48efbb1a112de03bed054e2a66c3fc27b0c7abf24b69b2f3c4979258d9a947fb3')

prepare() {
  cd rbelftools-${pkgver}
  sed -r 's|~>|>=|g' -i ${_gemname}.gemspec
}

build() {
  cd rbelftools-${pkgver}
  gem build ${_gemname}.gemspec
}

package() {
  cd rbelftools-${pkgver}
  local _gemdir="$(gem env gemdir)"
  gem install \
    --local \
    --verbose \
    --ignore-dependencies \
    --no-user-install \
    --install-dir "${pkgdir}${_gemdir}" \
    --bindir "${pkgdir}/usr/bin" \
    ${_gemname}-${pkgver}.gem

  install -Dm 644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
  install -Dm 644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"

  cd "${pkgdir}/${_gemdir}"
  rm -rf cache gems/${_gemname}-${pkgver}/{ext,lib/*/*.so,man} \
    extensions/*/*/${_gemname}-${pkgver}/{mkmf.log,gem_make.out}
}

