pkgname=rz-cutter
pkgver=2.4.1
pkgrel=8
pkgdesc='Qt and C++ GUI for rizin reverse engineering framework'
url='https://github.com/rizinorg/cutter'
arch=(x86_64)
license=(GPL-3.0-only)
depends=(
  rizin
  capstone
  qt6-base
  qt6-svg
  qt6-5compat
  python
  pyside6
  graphviz
  libgcc
  libstdc++
  syntax-highlighting
)
makedepends=(
  clang
  cmake
  git
  ninja
  qt6-tools
  shiboken6-generator
)
optdepends=(
  'rz-ghidra: ghidra decompiler plugin'
)
source=(
  "git+https://github.com/rizinorg/cutter#tag=v${pkgver}"
  "git+https://github.com/rizinorg/cutter-translations"
  pyside-6.11.patch
  qt-6.12.patch
)
