# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=sagemath-giac
pkgver=0.1.4
pkgrel=3
pkgdesc='Support for using Giac within SageMath'
arch=(x86_64)
url='https://github.com/sagemath/sagemath-giac'
license=(GPL-3.0-or-later)
depends=(giac
         glibc
         libgcc
         libstdc++
         python
         sagemath)
makedepends=(cython
             git
             meson-python
             python-build
             python-installer)
checkdepends=(python-pytest)
source=(git+https://github.com/sagemath/sagemath-giac#tag=$pkgver)
sha256sums=('4d73d6e7d7d56ec2441b33b3d9e7fbe8ae6a867757755a48bcd2084a23bc4b33')

build() {
  cd $pkgname
  python -m build --wheel --no-isolation --skip-dependency-check
}

check() {
  cd $pkgname
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest -v
}

package() {
  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
}
