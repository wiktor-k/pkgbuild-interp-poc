pkgname=sc3-plugins
pkgver=3.14.1
pkgrel=1
pkgdesc="Extension plugins for the SuperCollider3 audio synthesis server."
arch=(x86_64)
url="https://github.com/supercollider/sc3-plugins"
license=(GPL-2.0-or-later)
groups=(pro-audio)
depends=(
  glibc
  libgcc
  libstdc++
  supercollider
)
makedepends=(
  cmake
  fftw
  stk
)
source=($url/releases/download/Version-$pkgver/$pkgname-$pkgver-Source.tar.bz2{,.asc})
sha512sums=('611b1806ce1831603c95ca470ff32c8497fa5d1b8d6e1389eca20f30b4a16366084dda373a8021b7d2563244270e789253f55e4f5505d30e3ccf2c435d0e85dd'
            'SKIP')
b2sums=('55ef2b7c2de8558e2659cc9066d04f6837e28258f5c04f7cb56ecd7f566e988450fdde753a0a2c7aa8c123484a25353c9b6aafe75e3be3c5428780bda5c57cd9'
        'SKIP')
validpgpkeys=(
    '0B7D1EA4E32B5C3C4275D3C70796CC538BEFF177' # Brian Heim <self@brianlheim.com>
    '2E1C4FC2F6BB58FA157B21B8064B501EB7405F04' # Marcin Paczkowski <marcin.piotr.paczkowski@gmail.com>
)

build() {
  local cmake_options=(
    -B build
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D SC_PATH=/usr/include/SuperCollider/
    -D SUPERNOVA=ON
    -D SYSTEM_STK=ON
    -S $pkgname-$pkgver-Source
    -W no-dev
  )

  cmake "${cmake_options[@]}"
  cmake --build build --verbose
}

package() {
  depends+=(
    fftw libfftw3f.so
    stk libstk-5.0.0.so
  )

  DESTDIR="$pkgdir" cmake --install build
  install -vDm 644 $pkgname-$pkgver-Source/{{DEVELOPING,README}.md,TODO} -t "$pkgdir/usr/share/doc/$pkgname/"
}
