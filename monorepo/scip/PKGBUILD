# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=scip
pkgver=10.1.0
pkgrel=1
pkgdesc='Solving Constraint Integer Programs'
arch=(x86_64)
url='https://www.scipopt.org/'
license=(Apache-2.0)
depends=(bliss
         glibc
         gmp
         libgcc
         libstdc++
         mpfr
         onetbb
         papilo
         readline
         soplex
         zlib)
makedepends=(boost
             cmake
             git)
source=(git+https://github.com/scipopt/scip#tag=v$pkgver)
sha256sums=('b92cf8c499fe4675ab25af9db0c767058ac7653c420e56075209e19b0ee6489a')

prepare() {
  cd $pkgname
  git cherry-pick -n cc917e074cd23a1630cb0eb4b7f3ec6ba2777d80 # Fix build with glibc 2.43
}

build() {
  cmake -B build -S $pkgname \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DAUTOBUILD=ON \
    -DSYM=bliss \
    -DLTO=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
