# Maintainer: Levente Polyak <anthraxx[at]archlinux[dot]org>
#
pkgname=sea-orm-cli
pkgver=2.0.4
pkgrel=1
pkgdesc='An async & dynamic ORM for Rust'
url='https://www.sea-ql.org/SeaORM/'
license=(
  Apache-2.0
  MIT
)
arch=(x86_64)
makedepends=(
  cargo
  git
)
depends=(
  glibc
  libgcc
  openssl
)
options=(!lto)
source=(
  "git+https://github.com/SeaQL/sea-orm.git#tag=${pkgver}"
  Cargo.lock
)
sha256sums=('b5ec04e11f184d88462f7379ea3a8670e964ac7e2a011630a39ba590821f5751'
            '2bdd19d14b424b6b3735f4f48e20cc4f83a35b0c37c96bd47e30c3c74e239a28')

prepare() {
    cd sea-orm/sea-orm-cli
    cp "${srcdir}/Cargo.lock" .
    cargo fetch --locked --target host-tuple
}

build() {
    cd sea-orm/sea-orm-cli
    cargo build --frozen --release
}

check() {
    cd sea-orm/sea-orm-cli
    cargo test --frozen
}

package() {
    cd sea-orm
    install -Dm 755 "sea-orm-cli/target/release/${pkgname}" -t "${pkgdir}/usr/bin/"
    install -Dm 644 LICENSE* -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
