# Maintainer: Fabian Bornschein <fabiscafe@archlinux.org>
# Contibutor: Balló György <ballogyor+arch at gmail dot com>

pkgname=secrets
pkgver=14.0
pkgrel=1
pkgdesc="Password manager for GNOME which makes use of the KeePass v.4 format"
url="https://apps.gnome.org/Secrets"
arch=(any)
license=('GPL-3.0-only')
groups=(gnome-circle)
depends=(
  dconf
  glib2
  graphene
  gtk4
  gtksourceview5
  hicolor-icon-theme
  libadwaita
  python
  python-gobject
  python-pycryptodomex
  python-pyhibp
  python-pykcs11
  python-pykeepass
  python-pyotp
  python-pyusb
  python-requests
  python-validators
  python-yubico
  python-zxcvbn-rs
)
makedepends=(
  git
  gobject-introspection
  meson
)
checkdepends=(python-pytest)
provides=(gnome-passwordsafe)
conflicts=(gnome-passwordsafe)
replaces=(gnome-passwordsafe)
source=("git+https://gitlab.gnome.org/World/secrets.git#tag=${pkgver/[a-z]/.&}")
b2sums=('f3df5d952140b285a618cfd89237167bdf68117c1329bb4cc81e705f313e9022ad2c87464ad24c5a5124610aead8807efef5c53aec55872f37309ca25fd7c133')

prepare() {
  cd secrets
}

build() {
  arch-meson secrets build
  meson compile -C build
}

check() (
  export GSETTINGS_SCHEMA_DIR="$PWD/build/data"
  glib-compile-schemas "$GSETTINGS_SCHEMA_DIR"

  export PYTHONPATH="$PWD/build:$PWD/secrets"

  meson test -C build --print-errorlogs
)

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
