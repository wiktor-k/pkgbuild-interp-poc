pkgname=serialdv
pkgver=1.1.5
pkgrel=1
pkgdesc='C++ interface to encode/decode audio with AMBE3000 based devices in packet mode'
arch=('x86_64')
url='https://github.com/f4exb/serialDV'
license=('GPL-3.0-or-later')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha512sums=('94763760ca2c86ecc82d850025efe8ff87a7662c2da41e348877d9aeb1c1148dbdcba511d7d872a92367ba64754eb15872b9b73771e9636b5e4110b278a2c50d')

build() {
  mkdir -p "$srcdir"/serialDV-$pkgver/build
  cd "$srcdir"/serialDV-$pkgver/build

  cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr

  make
}

package() {
  cd "$srcdir"/serialDV-$pkgver/build

  make DESTDIR="$pkgdir" install
}
