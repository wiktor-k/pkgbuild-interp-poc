# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=sh4d0wup
pkgver=0.11.1
pkgrel=1
pkgdesc="Signing-key abuse and update exploitation framework"
url='https://github.com/kpcyrd/sh4d0wup'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=(
  'gcc'
  'glibc'
  'libgcc' 'libgcc_s.so'
  'openssl' 'libssl.so'
  'pcsclite' 'libpcsclite.so'
  'podman'
  'shared-mime-info'
  'xz' 'liblzma.so'
  'zstd' 'libzstd.so'
)
checkdepends=('sequoia-sq')
makedepends=(
  'cargo'
  'clang'
)
options=(!lto)
source=(https://github.com/kpcyrd/${pkgname}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz)
sha256sums=('92c88eed86e7f6453807db2e5b154859a5952d3ff6be8a2a685879a838f3438f')
b2sums=('f88180c02c084d2698599433dcdb9edf0bbcbf7b20905b0a2dadc15fb89d73a6c924fee5f03c7a2630953d0e6d3fe87c10de0b96b3f52ec82297cd21bcb2421e')

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target host-tuple
}

build() {
  cd ${pkgname}-${pkgver}
  cargo build --frozen --release
}

check() {
  cd ${pkgname}-${pkgver}
  cargo test --frozen
}

package() {
  cd ${pkgname}-${pkgver}
  install -Dm 755 -t "${pkgdir}/usr/bin" \
    target/release/sh4d0wup

  # install completions
  install -d "${pkgdir}/usr/share/bash-completion/completions" \
             "${pkgdir}/usr/share/zsh/site-functions" \
             "${pkgdir}/usr/share/fish/vendor_completions.d"
  "${pkgdir}/usr/bin/${pkgname}" completions bash > "${pkgdir}/usr/share/bash-completion/completions/${pkgname}"
  "${pkgdir}/usr/bin/${pkgname}" completions zsh > "${pkgdir}/usr/share/zsh/site-functions/_${pkgname}"
  "${pkgdir}/usr/bin/${pkgname}" completions fish > "${pkgdir}/usr/share/fish/vendor_completions.d/${pkgname}.fish"
}

# vim: ts=2 sw=2 et:
