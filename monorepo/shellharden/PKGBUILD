# Maintainer: Alexander F. Rødseth <xyproto@archlinux.org>

pkgname=shellharden
pkgver=4.3.2
pkgrel=1
pkgdesc='Bash linter and syntax highlighter'
arch=(x86_64)
url='https://github.com/anordal/shellharden'
license=(MPL-2.0)
makedepends=(git rust)
depends=(glibc libgcc)
source=("git+$url#tag=v$pkgver")
b2sums=('1e9769ff14d8e2c2ef48b8097347604faadb0c574c9df0cb2ae998b261710fe66033f7730e1056d16170bd0bf9f2e00c823de22094afefefc62942f5fd4b710d')

build() {
  cd $pkgname
  cargo build --release
}

package() {
  cd $pkgname
  install -Dm755 target/release/$pkgname "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
