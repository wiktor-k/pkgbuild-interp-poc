# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=shmdata
pkgver=1.3.74
pkgrel=1
pkgdesc="Library to share flows of data frames between processes via shared memory"
arch=(x86_64)
url="https://gitlab.com/sat-mtl/tools/shmdata/"
license=(LGPL-2.1-or-later)
depends=(
  glib2
  glibc
  gstreamer
  libgcc
  libstdc++
)
makedepends=(cmake)
source=(
  "$pkgname-$pkgver.tar.gz::${url}-/archive/$pkgver/$pkgname-$pkgver.tar.gz"
  $pkgname-1.3.74-disable-werror.patch
)
sha512sums=('cea7b10fb1a29123e9974c4a7eea08dff7dbd31bfad6c7ed1fc7872fc3a81f88fdfa2eb75f4096b9011231107d4ba394db9b846dc69c07fc2a89db1c0bdec271'
            '06851ed7fe8d47b6577c24d4f7b98cde4507d4450b650e33c7ec7da28f4db5cc70204079c50ea1ee0c228618d157d30cb38c6e1be3b7acb785c5cd2063eb6371')
b2sums=('ec9b877235db1525e5f75ac5c09a6305e0816f051bd78d4321c78440b14bd2987099b33acafb92983965bb0056fc51927f7f7abf9ea0431b445f6357878c84af'
        'f2f4f3c294007520adf459a1a5f573972dd564110198d53b45be454ca6a82b06e38cfd1e393c0a079c83af258ee3fc5bc00d1405642f42111a1ddb5e68a1048b')

prepare() {
  # -Werror, not even once...
  patch -Np1 -d "$pkgname-$pkgver" -i ../$pkgname-1.3.74-disable-werror.patch
}

build() {
  local cmake_options=(
    -B build
    -S "$pkgname-$pkgver"
    -W no-dev
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
  )

  cmake "${cmake_options[@]}"
  cmake --build build --verbose
}

check() {
  local excluded_tests="check-c-wrapper|check-follower|check-shmdatasrc|check-shmdatasink|check-unix-perms|check-dead-shmdata-management|check-crashing-client"
  local ctest_flags=(
    --test-dir build
    # show the stdout and stderr when the test fails
    --output-on-failure
    # execute tests in parallel
    --parallel "$(nproc)"
    # exclude problematic tests
    --exclude-regex "$excluded_tests"
  )
  ctest "${ctest_flags[@]}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
