# Maintainer: DeepChirp <deepchirp@archlinux.org>
# Contributor: everyx <lunt.luo#gmail.com>

pkgname=sing-geoip-rule-set
_pkgname=sing-geoip
pkgver=20261012
pkgrel=1
pkgdesc="GeoIP rule sets for sing-box"
arch=('any')
url="https://github.com/SagerNet/${_pkgname}"
license=('GPL-3.0-or-later')
makedepends=('go')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz"
        "Country-${pkgver}.mmdb::https://github.com/Dreamacro/maxmind-geoip/releases/download/${pkgver}/Country.mmdb"
        "0001-build-support-local-Country.mmdb-input.patch")
sha256sums=('d2319639169db5d0950f9a61146fb14692178aed41fa1e6c2ec60dd14b9b780a'
            '635078e412c4443a2950c2e3f775ccdc400e0a1fea5ffd32e5489e5401a9e51d'
            'e7ab002eb14ebb1db4f15c4c9ff28364748665bf739205dc116de4440eb95e5d')

prepare() {
    cd "${srcdir}/${_pkgname}-${pkgver}"
    patch -Np1 -i "${srcdir}/0001-build-support-local-Country.mmdb-input.patch"
    export GOPATH="${srcdir}"
    go mod download -modcacherw
}

build() {
    cd "${srcdir}/${_pkgname}-${pkgver}"
    export GOPATH="${srcdir}"
    go run -v . -country-mmdb "${srcdir}/Country-${pkgver}.mmdb"
}

package() {
    cd "${srcdir}/${_pkgname}-${pkgver}"
    install -Dm644 ./rule-set/*.srs -t "${pkgdir}/usr/share/sing-box/rule-set"
}
