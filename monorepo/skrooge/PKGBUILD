pkgname=skrooge
pkgver=26.8.0
pkgrel=3
pkgdesc='Personal finance manager that aims at being powerful and intuitive'
arch=(x86_64)
url="https://skrooge.org/"
license=(GPL-2.0-or-later)
depends=(glibc
         karchive
         kcodecs
         kcolorscheme
         kcompletion
         kconfig
         kconfigwidgets
         kcoreaddons
         kdbusaddons
         ki18n
         kiconthemes
         kio
         knewstuff
         knotifications
         knotifyconfig
         kparts
         ktexttemplate
         kwallet
         kwidgetsaddons
         kxmlgui
         libgcc
         libofx
         libstdc++
         python
         qt6-5compat
         qt6-base
         qt6-declarative
         qt6-svg
         qt6-webengine
         sqlcipher)
makedepends=(extra-cmake-modules
             kdoctools
             krunner
             plasma-activities
             qt6-tools)
source=(https://download.kde.org/stable/$pkgname/$pkgname-$pkgver.tar.xz{,.sig})
validpgpkeys=('103DC6D087B3A4A2ED975D7EF0C8CED3382A5C4D'  #Stephane MANKOWSKI (Perso) <stephane@mankowski.fr>
              'F1955ED9D1C2D10D80B31B3B14EE37CD15C53BDD') 
sha256sums=('2332234f8b67dd95e63ed7caf21042a4d2792729a9a7f1f5cd52c1040550b353'
            'SKIP')

build() {
  cmake -B build -S $pkgname-$pkgver \
    -DSKG_BUILD_TEST=OFF \
    -DQT_MAJOR_VERSION=6
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
