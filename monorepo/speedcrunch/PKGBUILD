pkgname=speedcrunch
pkgver=1.1.0
pkgrel=1
pkgdesc="Simple but powerful calculator using Qt"
arch=(x86_64)
url='https://speedcrunch.org/'
license=(GPL-2.0-only)
depends=(glibc
         libgcc
         libstdc++
         qt6-base
         qt6-tools)
makedepends=(cmake
             git)
source=(git+https://github.com/heldercorreia/speedcrunch#tag=v$pkgver)
sha256sums=('374f319fd23871b7ed3c137925e315ef6214faf0f95f896ccf7ce2d67806450e')

build() {
  cmake -B build -S $pkgname/src \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
