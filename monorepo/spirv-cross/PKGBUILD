# Maintainer: Daniel Bermond <dbermond@archlinux.org>

pkgname=spirv-cross
pkgver=1.4.363.0
pkgrel=1
# for enabling tests and making them to pass (fails if symlinking system glslang and spirv-tools binaries):
# https://github.com/KhronosGroup/SPIRV-Cross/blob/vulkan-sdk-1.4.363.0/CMakeLists.txt#L508
# https://github.com/KhronosGroup/SPIRV-Cross/blob/vulkan-sdk-1.4.363.0/checkout_glslang_spirv_tools.sh#L5-L7
_glslang_commit=a3a83d095e358aae4d63ece088dcca71828e2de0
_spirv_tools_commit=7f586c9b065d76341ba9477f374daf1836a464e5
_spirv_headers_commit=ad9184e76a66b1001c29db9b0a3e87f646c64de0
pkgdesc='Tool and library for parsing and converting SPIR-V to other shader languages'
arch=('x86_64')
url='https://github.com/KhronosGroup/SPIRV-Cross/'
license=('Apache-2.0')
depends=(
    'glibc'
    'libgcc'
    'libstdc++')
makedepends=(
    'cmake'
    'git'
    'python')
source=("git+https://github.com/KhronosGroup/SPIRV-Cross.git#tag=vulkan-sdk-${pkgver}"
        "git+https://github.com/KhronosGroup/glslang.git#commit=${_glslang_commit}"
        "git+https://github.com/KhronosGroup/SPIRV-Tools.git#commit=${_spirv_tools_commit}"
        "git+https://github.com/KhronosGroup/SPIRV-Headers.git#commit=${_spirv_headers_commit}")
sha256sums=('1a7aaa83f76a93e14c4ba8ec027d009739f9e62b4ec25dd3f245d32bc7a11325'
            '9f5498e6a86420087c9b3375a064dd17b1750851478671232c0d8562bb86230d'
            '572cf40196d2a0bb530a5096f5f2bf7df038064f97c058fb4fa95bd206c72b62'
            'e7e30faa53dab14980cc5c1b551f15cc4c98b946030159210e97e12925dbc7a5')

prepare() {
    mkdir -p SPIRV-Cross/external
    
    ln -sf "${srcdir}/glslang"       SPIRV-Cross/external/glslang
    ln -sf "${srcdir}/SPIRV-Tools"   SPIRV-Cross/external/spirv-tools
    ln -sf "${srcdir}/SPIRV-Headers" SPIRV-Tools/external/spirv-headers
}

build() {
    # NOTE: test suite fails when using 'None' build type
    local -a _common_opts=(
        '-GUnix Makefiles'
        '-DCMAKE_BUILD_TYPE:STRING=Release'
        '-Wno-author')
    
    export CFLAGS+=' -ffat-lto-objects'
    export CXXFLAGS+=' -ffat-lto-objects'
    
    # glslang (required for tests)
    cmake -B SPIRV-Cross/external/glslang-build -S glslang \
        "${_common_opts[@]}" \
        -DCMAKE_INSTALL_PREFIX:PATH='output' \
        -DENABLE_OPT:BOOL='OFF' \
        -DGLSLANG_TESTS:BOOL='OFF'
    cmake --build SPIRV-Cross/external/glslang-build --target install
    
    # spirv-tools (required for tests)
    cmake -B SPIRV-Cross/external/spirv-tools-build -S SPIRV-Tools \
        "${_common_opts[@]}" \
        -DCMAKE_INSTALL_PREFIX:PATH='output' \
        -DSPIRV_SKIP_TESTS:BOOL='ON' \
        -DSPIRV_WERROR:BOOL='OFF'
    cmake --build SPIRV-Cross/external/spirv-tools-build --target install
    
    # spirv-cross
    cmake -B build-SPIRV-Cross -S SPIRV-Cross \
        "${_common_opts[@]}" \
        -DCMAKE_INSTALL_PREFIX:PATH='/usr' \
        -DSPIRV_CROSS_FORCE_PIC:BOOL='ON' \
        -DSPIRV_CROSS_SHARED:BOOL='ON'
    cmake --build build-SPIRV-Cross
}

check() {
    # hlsl tests fails to pass with error 'Could not find FXC', as it seems they require fxc.exe from the Windows SDK
    ctest --test-dir build-SPIRV-Cross --output-on-failure --exclude-regex 'spirv-cross-test-hlsl(|-opt)'
}

package() {
    DESTDIR="$pkgdir" cmake --install build-SPIRV-Cross
}
