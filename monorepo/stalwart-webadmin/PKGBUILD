# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-webadmin
_pkgname=stalwart-webui
pkgver=1.0.11
pkgrel=1
pkgdesc='Web UI for Stalwart'
arch=(any)
url='https://github.com/stalwartlabs/webui'
license=(AGPL-3.0-only)
makedepends=(git npm zip)
source=("$_pkgname::git+$url#tag=v$pkgver")
sha512sums=('c15ada49e27f597052dc473461ca1c55f0d536b3529aeb049744bd3adb8584f3ba19becfb675be8bb5c4639ee97c2eeba52093f04d3b631d67e433ea61f3f8f3')
b2sums=('e8db4481b32a812563330ca0a93b763e0a49ca0d88e22cdde91b95334d6dca6d9acb796912d87ae4043f31a8ac790ea42b04a0f2c6ac38b47daf043cc1d5eb2b')

prepare() {
  cd "$_pkgname"

  # install dev dependencies
  npm install --include=dev
}

build() {
  cd "$_pkgname"

  npm run build

  cd dist
  zip -r ../webui.zip .
}

package() {
  cd "$_pkgname"

  install -vDm644 -t "$pkgdir/usr/share/stalwart" webui.zip
}
