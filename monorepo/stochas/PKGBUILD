_name=Stochas
pkgbase=stochas
pkgname=(stochas stochas-{clap,standalone,vst3})
pkgver=1.3.13
pkgrel=3
pkgdesc="A probabilistic polyrhythmic sequencer"
arch=(x86_64)
url="https://surge-synth-team.org/stochas"
license=(GPL-3.0-only)
makedepends=(
  alsa-lib
  cmake
  flac
  freetype2
  gendesk
  git
  glibc
  jack
  juce
  libgcc
  libjpeg-turbo
  libogg
  libpng
  libstdc++
  libvorbis
  libx11
  libxcursor
  libxinerama
  libxrandr
  ttf-liberation
  zlib
)
source=(
