prepare() {
  (
    cd $pkgname
    git submodule init
    git submodule deinit lib/JUCE  # devendor juce
    git config submodule.lib/clap-juce-extensions.url "$srcdir/github.com-free-audio-clap-juce-extensions"
    git -c protocol.file.allow=always submodule update

    cd lib/clap-juce-extensions
    git submodule init
    git config submodule.clap-libs/clap.url "$srcdir/github.com-free-audio-clap"
    git config submodule.clap-libs/clap-helpers.url "$srcdir/github.com-free-audio-clap-helpers"
    git -c protocol.file.allow=always submodule update
  )

  patch -Np1 -d $pkgname -i ../$pkgname-1.3.10-devendor_juce.patch

  local gendesk_args=(
    -n
    --pkgname "org.surge-synth-team.$_name"
    --pkgdesc "$pkgdesc"
    --exec "$_name"
    --name "$_name"
    --icon "org.surge-synth-team.$_name"
    --genericname "Audio Sequencer"
    --categories "AudioVideo;Audio"
  )
  gendesk "${gendesk_args[@]}"
}

build() {
  local cmake_options=(
    -B build
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -S $pkgname
    -W no-dev
  )

  export CFLAGS+=" -DNDEBUG"
  export CXXFLAGS+=" -DNDEBUG"
  cmake "${cmake_options[@]}"
  cmake --build build --verbose
}

package_stochas() {
  depends=(
    stochas-{clap,standalone,vst3}
  )
}

package_stochas-clap() {
  pkgdesc+=" - CLAP plugin"
  groups=(
    clap-plugins
    pro-audio
  )
  depends+=(
    clap-host
    freetype2 libfreetype.so
    glibc
    libgcc libgcc_s.so
    libjpeg-turbo libjpeg.so
    libpng libpng16.so
    libstdc++ libstdc++.so
    ttf-liberation
    zlib libz.so
  )

  install -vDm 755 build/${pkgbase}_artefacts/None/CLAP/$_name.clap -t "$pkgdir/usr/lib/clap/"
}

package_stochas-standalone() {
  pkgdesc+=" - standalone"
  groups=(
    pro-audio
  )
  depends+=(
    alsa-lib libasound.so
    freetype2 libfreetype.so
    glibc
    hicolor-icon-theme
    libgcc libgcc_s.so
    libjpeg-turbo libjpeg.so
    libpng libpng16.so
    libstdc++ libstdc++.so
    ttf-liberation
    zlib libz.so
  )

  install -vDm 755 build/${pkgbase}_artefacts/None/Standalone/$_name -t "$pkgdir/usr/bin/"
  install -vDm 644 ./*.desktop -t "$pkgdir/usr/share/applications/"
  install -vDm 644 $pkgbase/image/app_logo_512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/org.surge-synth-team.$_name.png"
}

package_stochas-vst3() {
  pkgdesc+=" - VST3 plugin"
  groups=(
    pro-audio
    vst3-plugins
  )
  depends+=(
    freetype2 libfreetype.so
    glibc
    libgcc libgcc_s.so
    libjpeg-turbo libjpeg.so
    libpng libpng16.so
    libstdc++ libstdc++.so
    ttf-liberation
    vst3-host
    zlib libz.so
  )

  install -vDm 755 build/${pkgbase}_artefacts/None/VST3/$_name.vst3/Contents/Resources/*.json -t "$pkgdir/usr/lib/vst3/$_name.vst3/Contents/Resources/"
  install -vDm 755 build/${pkgbase}_artefacts/None/VST3/$_name.vst3/Contents/$CARCH-linux/$_name.so -t "$pkgdir/usr/lib/vst3/$_name.vst3/Contents/$CARCH-linux/"
}
