# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=switchboard-plug-sound
pkgver=8.0.3
pkgrel=1
pkgdesc='Switchboard Sound Plug'
arch=(x86_64)
url=https://github.com/elementary/switchboard-plug-sound
license=(LGPL-2.1-only)
groups=(pantheon)
depends=(
  dconf
  glib2
  glibc
  gtk4
  libcanberra
  libadwaita-1.so
  libgee
  libgranite-7.so
  libpulse
  libswitchboard-3.so
)
makedepends=(
  git
  meson
  vala
)
source=(git+https://github.com/elementary/switchboard-plug-sound.git#tag=${pkgver})
b2sums=('f1678ad329997edfaf46dc3acb108f72730a041c911cd2215e081c09fe6cb7cac3cf3006b4baf9de7cccef3a6824f9b905caed6a9fd13042dd9443bab515c86f')

build() {
  arch-meson switchboard-plug-sound build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}

