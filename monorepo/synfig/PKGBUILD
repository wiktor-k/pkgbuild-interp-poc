# Contributor: Sergej Pupykin <pupykin.s+arch@gmail.com>
# Contributor: Franco Iacomella <yaco@gnu.org>

pkgname=synfig
pkgver=1.4.5
pkgrel=8
pkgdesc='Professional vector animation program (CLI renderer only)'
arch=(x86_64)
url='https://www.synfig.org/'
license=(GPL-2.0-or-later)
depends=(
  cairo
  fftw
  fontconfig
  freetype2
  glib2
  glibc
  glibmm
  imagemagick
  imath
  libgcc
  libjpeg-turbo
  libmng
  libpng
  libsigc++
  libstdc++
  libtool
  libxml++2.6
  mlt
  openexr
  pango
  zlib
)
makedepends=(
  boost
  etl
  git
  intltool
)
source=("git+https://github.com/synfig/synfig.git#tag=v$pkgver")
b2sums=(c7347ece20992063ef15f72b22b1e42a129dbf36c53b4188032482239f4d7939376463cf086da7c48c19a61b397ef15984a0bf2ea073848c78eb1bd0248c7250)

prepare() {
  cd synfig/synfig-core
  autoreconf -fiv
}

build() {
  cd synfig/synfig-core
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd synfig/synfig-core
  make DESTDIR="$pkgdir" install
}
