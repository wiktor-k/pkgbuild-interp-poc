pkgname=sysdig
pkgver=0.41.4
pkgrel=3
pkgdesc="Open source system-level exploration and troubleshooting tool"
arch=('x86_64')
url="https://www.sysdig.com/"
license=('Apache-2.0')
depends=(
  'falcosecurity-libs'
  'glibc'
  'jsoncpp'
  'libgcc'
  'libstdc++'
  'luajit'
  'ncurses'
  'scap-dkms'
  'yaml-cpp'
)
makedepends=(
  'cmake'
  'git'
  'nlohmann-json'
  'pandoc'
)
source=(
  "git+https://github.com/draios/sysdig.git#tag=$pkgver"
  "$pkgname-bashcomp-location.patch"
  "$pkgname-skip-bundled-zlib-with-system-libs.patch"
  "$pkgname-falcosecurity-libs-0.23-compatibility.patch"
)
b2sums=('e9ce41d01ca780d84e3cd0199c395ac2b02c836318e3b2a1567fb4c65cf11318e84cc27acd343b89a188342c560dcf4a33894db14b589b898ca637dce918447b'
        'f65349106d40976bf96dc6692e94c48d6a897c8266915939d4c6ac47eea30f231b43c448c97bc419829347a90918560004d3263e482e44f1db4adbc107aa5554'
        'ff8ef3b63ee0a591b24cef1db2ab2209c6cb08c99dfa32c05edcc13f42657596836cc9cb48b08dbd204fcb8875783ec2c776f4fc33d7882091f2caabcef01d4d'
        '8583f68a4361c9e27fce2894e731071d70c1d88aba8d1a4779ae1c91b1c148ce04a036576942d095db983a7c8ecba72c566dc43b5bfdc49f002bb1fceee05290')

prepare() {
  cd $pkgname
  patch -Np1 < ../$pkgname-bashcomp-location.patch
  patch -Np1 < ../$pkgname-skip-bundled-zlib-with-system-libs.patch
  patch -Np1 < ../$pkgname-falcosecurity-libs-0.23-compatibility.patch
}

build() {
  cmake -B build -S $pkgname \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev \
    -DSYSDIG_VERSION=$pkgver \
    -DUSE_BUNDLED_FALCOSECURITY_LIBS=OFF \
    -DUSE_BUNDLED_DEPS=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  cd $pkgname
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" {NOTICES,COPYING}
}
