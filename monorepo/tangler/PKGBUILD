# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=tangler
pkgver=0.4.0
pkgrel=1
pkgdesc="Extracts (tangles) code fragments from Markdown documents"
arch=(x86_64)
url="https://github.com/wiktor-k/tangler/"
license=(Apache-2.0 MIT)
depends=(
  glibc
  libgcc
)
makedepends=(rust)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz)
sha512sums=('79c4ff846d5285b6b6caabc545d7f23e512e9cc9e93df54b2fc20d3b09f90c8b0a64f85fb338926846abb418371df1766eec6131aaf463a59896271b2102ff5b')
b2sums=('48ed27852f5766eb5b4d46d93ec93b2ce6107e19cd9878f7ac6b1a89ebb4c7ece0838e8dbfb7377da411fb8facdf12e92c45aa9dc786beeab22678bad230d8c9')

prepare() {
  cd $pkgname-$pkgver
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $pkgname-$pkgver
  cargo build --frozen --release --all-features
}

check() {
  cd $pkgname-$pkgver
  cargo test --frozen --all-features
}

package() {
  cd $pkgname-$pkgver
  install -vDm 755 target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 LICENSES/MIT.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
