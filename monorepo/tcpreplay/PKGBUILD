pkgname=tcpreplay
pkgver=4.6.1
pkgrel=1
pkgdesc='Gives the ability to replay previously captured traffic in a libpcap format'
url='https://tcpreplay.appneta.com'
arch=('x86_64')
license=('GPL-3.0-only')
depends=(
  'glibc'
  'libdnet'
  'libpcap'
)
makedepends=('tcpdump')
optdepends=('tcpdump: decoding of packets support')
options=('!emptydirs')
source=(https://github.com/appneta/tcpreplay/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz{,.asc})
sha512sums=('ebd18f5c495a85fdf8e6372e5614155695244a2d38b5c03c68a5ac21004ea8bcbf38dec3227f765ddee9fbc1abfbe972569593ae3617c591aefae8ad44de009d'
            'SKIP')
b2sums=('df65f973e29945f202bf21d2d0535520ad8032c8274d0f489e58162edada84f0b25a93cabd6696635d8ba680f98bc3d5bffc34056c8c944d5423f4ef2571acd4'
        'SKIP')
validpgpkeys=('84E4FA215C934A7D97DC76D5E9E2149793BDE17E') # Fred Klassen <tcpreplay@appneta.com>

prepare() {
  cd ${pkgname}-${pkgver}
  autoreconf -fiv
}

build() {
  cd ${pkgname}-${pkgver}
  export CFLAGS="$CFLAGS -std=gnu99"
  ./configure \
    --prefix=/usr \
    --disable-local-libopts \
    --enable-dynamic-link \
    --enable-shared \
    --with-libdnet \
    --with-tcpdump=/usr/bin/tcpdump \
    ac_cv_header_net_bpf_h=n
  make
}

check() {
  cd ${pkgname}-${pkgver}
  make -j1 -C test tcpprep
}

package() {
  cd ${pkgname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}

