# Maintainer: Orhun Parmaksız <orhun@archlinux.org>
# Contributor: Christian Visintin <christian dot visintin at gmail dot com>
# Contributor: Luis Martinez <luis dot martinez at tuta dot io>

pkgname=termscp
pkgver=1.2.1
pkgrel=1
pkgdesc="A feature rich terminal UI file transfer and explorer"
arch=('x86_64')
url="https://github.com/veeso/termscp"
license=('MIT')
depends=(
  'libgcc'
  'zlib'
  'openssl'
  'dbus'
  'smbclient'
)
makedepends=('cargo' 'git')
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha512sums=('a1d5bc20cd3233906b5d81828201b787b11b5553c1b63b752cffd3deb055032b354bfd74b3fbb639b52eeaaa8b1138cbb4c61d69c4b2e2648f746cab96544f66')
options=('!lto')

prepare() {
  cd "$pkgname"
  cargo fetch --target "$(rustc --print host-tuple)" # --locked
}

build() {
  cd "$pkgname"
  # `termscp -v` will show "makepkg" branch without this
  export VERGEN_GIT_BRANCH=main
  export OPENSSL_NO_VENDOR=1
  cargo build --release --frozen
}

check() {
  cd "$pkgname"
  export OPENSSL_NO_VENDOR=1
  cargo test --frozen -- \
    --skip system::environment::tests::test_system_environment_get_config_dir_err \
    --skip system::keys::keyringstorage::tests::test_system_keys_keyringstorage \
    --skip system::environment::tests::test_system_environment_get_config_dir \
    --skip system::keys::keyringstorage::tests::test_system_keys_keyring_storage
}

package() {
  cd "$pkgname"
  install -Dm 755 "target/release/$pkgname" -t "$pkgdir/usr/bin"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# vim: ts=2 sw=2 et:
