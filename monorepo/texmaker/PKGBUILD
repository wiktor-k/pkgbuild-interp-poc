# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Contributor: Federico Cinelli <cinelli@aur.archlinux.org>

pkgname=texmaker
pkgver=6.0.2
pkgrel=1
pkgdesc='Free cross-platform LaTeX editor'
arch=(x86_64)
url='https://www.xm1math.net/texmaker/index.html'
license=(GPL-2.0-or-later)
depends=(glibc
         libstdc++
         qt6-5compat
         qt6-base
         qt6-declarative
         qt6-webengine
         texlive-basic)
makedepends=(cmake
             qt6-tools)
optdepends=('ghostscript: LaTeX to HTML conversion command')
source=(https://www.xm1math.net/$pkgname/$pkgname-$pkgver.tar.bz2
        qt-6.10.patch)
sha256sums=('25ecbb16d156ed1528b31511d37c9da7858a2def328b87f17fc877f57f5139cf'
            'e3ba38dbe6677ab4309eb552deb127d36215c5f0ffe3e702c87262e83e142e10')

prepare() {
  patch -d $pkgname-$pkgver -p1 < qt-6.10.patch
}

build() {
  cmake -B build -S $pkgname-$pkgver \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
