pkgname=tpm2-openssl
pkgver=1.3.0
pkgrel=2
pkgdesc='OpenSSL Provider for Trusted Platform Module 2.0 integration'
arch=(x86_64)
url='https://github.com/tpm2-software/tpm2-openssl'
license=(BSD-3-Clause)
depends=(
  glibc
  tpm2-tss
)
makedepends=(
  autoconf-archive
  git
)
checkdepends=(
  dbus
  swtpm
  tpm2-abrmd
  tpm2-tools
)
optdepends=('tpm2-abrmd: user space resource manager')
source=(
  git+$url.git?signed#tag=$pkgver
  tpm2-openssl_check.sh
)
sha512sums=('0b7b8936f164e5e547d7ae5e19b5e1a4e6dcb07fe9e6e1b5e6ca6e2955317fe4635c864693cd68bbe32e0698a018765d1832d58573aa5f491ae7f2c51da8feae'
            '08818eb11a2e4f53a6af3c7e2069b04ff5a4d135414a0f7e0dd316abffd9870432fe7f9cd02a2de2f8c99d89862933c8f4af5c76c68834849defc802511290be')
b2sums=('757bfc6ce4d62ed122ad76e141d89693cc6dae4ee68641379048a9315b9a3c231dc5957f918fe909bb8458cdc8c3e972d926f9e8b4aaa815d648478d3fec4f71'
        '36434518aecc919c5be4eab1566d9360b459e6c378e0fdcf2af4d6ad59c0f1f5269d679857d2862cb30e0fb5efa5a74f8c103cfe38327c2e2251d6ffd73e8193')
validpgpkeys=(
  'BB0C68611BD255F10FD1EE94B7900BECDB740A3B'  # Petr Gotthard <petr.gotthard@centrum.cz>
  'B7201FE8031B07AF11F5423C6329CFCB6BE6FD76'  # Petr Gotthard <petr.gotthard@centrum.cz>
)

prepare() {
  cd "$pkgname"
  ./bootstrap
}

build() {
  cd "$pkgname"
  ./configure --prefix=/usr
  make
}

check() {
  cd "$pkgname"
  dbus-run-session "$srcdir/tpm2-openssl_check.sh"
}

package() {
  depends+=(
    libtss2-esys.so
    libtss2-rc.so
    libtss2-tctildr.so
  )

  cd "$pkgname"
  make DESTDIR="$pkgdir" install
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
