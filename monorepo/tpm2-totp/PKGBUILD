# Maintainer: David Runge <dvzrv@archlinux.org>
# Contributor: Jonas Witschel <diabonas@archlinux.org>

pkgbase=tpm2-totp
pkgname=(
  tpm2-totp
  dracut-tpm2-totp
  mkinitcpio-tpm2-totp
)
pkgver=0.3.0
pkgrel=3
pkgdesc='Attest the trustworthiness of a device against a human using time-based one-time passwords'
arch=(x86_64)
url='https://github.com/tpm2-software/tpm2-totp'
license=(BSD-3-Clause)
makedepends=(
  autoconf-archive
  doxygen
  dracut
  git
  glibc
  mkinitcpio
  qrencode
  tpm2-tss
)
checkdepends=(
  iproute2
  oath-toolkit
  swtpm
  tpm2-tools
)
source=(git+$url.git?signed#tag=v$pkgver)
sha512sums=('396f56913a4911efddc6e03ec44974f3cc9f352da1843dd35935279e7d9108f38989526c8ac9baa3ca03e0f477c03b02c3c4e9615ca046c99d407f8933aa4ef1')
validpgpkeys=(
  'D6B4D8BAC7E0CC97DCD4AC7272E88B53F7A95D84'  # Andreas Fuchs <andreas.fuchs@sit.fraunhofer.de>
  'FE2E6249201CA54A4FB90D066E80CA1446879D04'  # Jonas Witschel <diabonas@gmx.de>
)

prepare() {
  cd "$pkgbase"
  # NOTE: Set the VERSION file manually, so that configure.ac uses a release version and does not add `-Werror`
  sed '/VERSION/d' -i bootstrap
  printf '%s\n' "$pkgver" > VERSION
  ./bootstrap
}

build() {
  local configure_options=(
    --enable-integration
    --libexecdir=/usr/lib
    --prefix=/usr
    --with-dracutmodulesdir=/usr/lib/dracut/modules.d
    --with-mkinitcpiodir=/usr/lib/initcpio
  )

  cd "$pkgbase"
  ./configure "${configure_options[@]}"
  make
}

check() {
  make -k check -C "$pkgbase"
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_tpm2-totp() {
  depends=(
    bash
    glibc
    qrencode
    tpm2-tss libtss2-esys.so libtss2-mu.so libtss2-tctildr.so
  )

  make DESTDIR="$pkgdir" install -C "$pkgbase"

  (
    cd "$pkgdir"
   _pick dracut-tpm2-totp usr/lib/dracut
   _pick mkinitcpio-tpm2-totp usr/lib/initcpio
  )

  install -vDm 644 "$pkgbase"/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_dracut-tpm2-totp() {
  pkgdesc="Dracut integration to display TOTP during boot using tpm2-totp"
  depends=(
    bash
    dracut
    tpm2-totp
  )

  mv -v "$pkgname"/* "$pkgdir"
  install -vDm 644 "$pkgbase"/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_mkinitcpio-tpm2-totp() {
  pkgdesc="Mkinitcpio integration to display TOTP during boot using tpm2-totp"
  depends=(
    bash
    mkinitcpio
    tpm2-totp
  )

  mv -v "$pkgname"/* "$pkgdir"
  install -vDm 644 "$pkgbase"/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
