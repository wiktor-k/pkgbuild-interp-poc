prepare() {
  mkdir -p build/_deps

  # placate cmake's fetchcontent
  cd build/_deps
  mv "$srcdir/wxWidgets-${_wxwidgets_version}" wxwidgets-src
  mv "$srcdir/wxpdfdoc-${_wxpdfdoc_version}" wxpdfdoc-src
  mv "$srcdir/lobster-${_lobster_version}" lobster-src
  mv "$srcdir/Monocypher-${_monocypher_version}" monocypher-src
  mv "$srcdir/libunibreak-${_unibreak_version}" libunibreak-src
}

build() {
  local cmake_options=(
    -B build
    -S "$pkgname"
    -G Ninja
    -W no-author
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D TREESHEETS_BUNDLE_WXWIDGETS=ON
    -D FETCHCONTENT_FULLY_DISCONNECTED=ON
    -D TREESHEETS_VERSION="v${pkgver}"
  )

  cmake "${cmake_options[@]}"

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$pkgname/ZLIB_LICENSE.txt"
}
