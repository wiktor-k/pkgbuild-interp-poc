pkgname=treesheets
pkgver=2.19.2
pkgrel=1
pkgdesc='A free-form hierarchical data organizer'
arch=(x86_64 aarch64)
url='https://strlen.com/treesheets/'
license=(Zlib)
depends=(
  at-spi2-core
  glibc
  libstdc++
  libgcc
  hicolor-icon-theme
  libx11
  libxkbcommon
  libjpeg-turbo
  libtiff
  libpng
  gspell
  fontconfig
  cairo
  pango
  wayland
  libwebp
  pcre2
  glib2
  expat
  gtk3
  zlib
  gdk-pixbuf2
)
makedepends=(
  git
  cmake
  ninja
  libnotify
  sdl2-compat
)
_wxwidgets_version=3.3.4 # CMakeLists.txt
_lobster_version=2026.8 # cmake/Lobster.cmake
_wxpdfdoc_version=1.4.0 # cmake/WxPdfDoc.cmake
_monocypher_version=4.0.3 # cmake/Monocypher.cmake
_unibreak_version=8.0 # cmake/Unibreak.cmake
source=(
  "$pkgname::git+https://github.com/aardappel/treesheets#tag=v$pkgver"
  "wxwidgets-${_wxwidgets_version}.tar.bz2::https://github.com/wxWidgets/wxWidgets/releases/download/v${_wxwidgets_version}/wxWidgets-${_wxwidgets_version}.tar.bz2"
