pkgname=tvtime
pkgver=1.0.11
pkgrel=7
pkgdesc='High quality television application for use with video capture cards'
arch=(x86_64)
url='https://linuxtv.org/'
license=(GPL-2.0-or-later)
depends=(
  alsa-lib
  freetype2
  glibc
  hicolor-icon-theme
  icu
  libpng
  libstdc++
  libx11
  libxext
  libxinerama
  libxml2
  libxss
  libxv
  libxxf86vm
  zlib
)
makedepends=(
  git
  imagemagick
)
source=(
  "git+https://git.linuxtv.org/tvtime.git?signed#tag=v$pkgver"
  no-termio.patch
  0001-Fix-AppStream-metadata-validation.patch
)
b2sums=(
  ffb1e442d1b39df2f19fe2a07771652e8ea7b4ef1fae84886ddca5075cb5e4c1f5e8c0a412c11c3f92b2009b5506621ed5ff6547b2bd05f2f57a8a4b2065ce85
  d5044f5e041802a717e81839574bc39385b0f6332f565715c90bd33906bc6fbd45edcb611f03da86ef87e9e903a6a44cdc6a82be8ed4a39c3ba818710811d882
  168cc6745fd290642d341c3c1f4105e892aa0aa0afc0b9ec05f025f36814774ba19f465e400331c6a02348916f6788701db24af86edf00fdeb3a58766facf010
)
validpgpkeys=(F909AE68FC11DF09C1755C00085F3EBD8EE4E115) # Mauro Carvalho Chehab <mauro.chehab@linux.intel.com>

prepare() {
  cd $pkgname

  magick docs/tvtime-icon-100x100.png +set date:create +set date:modify -resize 64x64 -alpha on docs/tvtime-icon-64x64.png
  magick docs/tvtime-icon-100x100.png +set date:create +set date:modify -resize 96x96 -alpha on docs/tvtime-icon-96x96.png

  # Fix: "warning: implicit declaration of function 'minor' / 'major'" errors
  git cherry-pick -n bfa96fec44b7db78b43b9b8d20d7ca02616f70ed

  # Don't depend on freetype-config anymore
  git cherry-pick -n 7243b228b3b5ec4ae12b2ddbb61990125e9ce0aa

  # Fix build without termio.h
  git apply -3 ../no-termio.patch

  # Fix AppStream metadata
  git apply -3 ../0001-Fix-AppStream-metadata-validation.patch
  sed -i 's|$(datadir)/appdata|$(datadir)/metainfo|' docs/Makefile.am

  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
  install -Dm644 docs/tvtime-icon-64x64.png "$pkgdir/usr/share/icons/hicolor/64x64/apps/tvtime.png"
  install -Dm644 docs/tvtime-icon-96x96.png "$pkgdir/usr/share/icons/hicolor/96x96/apps/tvtime.png"
  install -Dm644 docs/html/default.tvtime.xml "$pkgdir/usr/share/tvtime/default.tvtime.xml"
}
