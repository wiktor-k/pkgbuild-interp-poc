# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=typesetter
pkgver=0.15.2
pkgrel=2
pkgdesc='A minimalist local-first Typst editor'
arch=(x86_64 aarch64)
url='https://codeberg.org/haydn/typesetter'
license=(GPL-3.0-or-later)
depends=(
  libadwaita
  gtk4
  hicolor-icon-theme
  dconf
  libgcc
  glib2
  glibc
  gtksourceview5
  libspelling
  pango
  gdk-pixbuf2
  openssl
  cairo
  graphene
  zstd
)
makedepends=(
  git
  rust
  blueprint-compiler
  meson
  libvirt
  libvirt-glib
)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('badaad5cefcfe5a2d81a74f952d60c7d18f31c4aab6ff8193b25559d45227bf5d07ddffee130ead8fb74e363381cc253d36012cfce1d3296bc4c9c843d263702')
b2sums=('a0e04e1520f7083bd09e8b1873c3692fbda6e4a1fbb6fb04615eaab2e0a57e735e5902375dd6f41615d3940fb88326b43816ae3bf50a3c3331cd7fa09857ab39')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple

  # use system zstd
  export ZSTD_SYS_USE_PKG_CONFIG=1

  # use system openssl
  export OPENSSL_NO_VENDOR=1
}

build() {
  arch-meson build "$pkgname" --buildtype=release
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
