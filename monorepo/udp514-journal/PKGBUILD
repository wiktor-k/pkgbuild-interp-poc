pkgname=udp514-journal
pkgver=0.3.0
pkgrel=2
pkgdesc='forward syslog from network (udp/514) to systemd-journald'
arch=('x86_64')
url='https://github.com/eworm-de/udp514-journal'
depends=('glibc'
         'systemd-libs' 'libsystemd.so'
         'systemd')
makedepends=('discount'
             'git')
license=('GPL-3.0-or-later')
validpgpkeys=('BD84DE71F493DF6814B0167254EDC91609BC9183') # Christian Hesse <mail@eworm.de>
source=("git+https://github.com/eworm-de/udp514-journal.git?signed#tag=${pkgver}")
sha256sums=('41d62f98b2a6ff6eadbd34d750c0bb19ae9274535b146fc3f76596c60f6b7134')

build() {
	cd ${pkgname}/

	make VERSION="${pkgver}-${pkgrel}"
}

package() {
	cd ${pkgname}/

	make DESTDIR="${pkgdir}" install
}

