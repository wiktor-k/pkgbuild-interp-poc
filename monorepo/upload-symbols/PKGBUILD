# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=upload-symbols
pkgver=0.3.1
pkgrel=1
pkgdesc="Command line tool to upload to the Mozilla Symbols Server"
url="https://github.com/mozilla-services/upload-symbols"
arch=(x86_64)
license=('Apache-2.0 OR MIT')
depends=(
  glibc
  libgcc
)
makedepends=(
  cargo
  git
)
options=(!lto)
source=("git+$url#tag=v$pkgver")
b2sums=('b11b0b6ea94d07a57e0e93ca61bdcc34a7e780aafdf3d2659ee77c8949a57a5426b7c0d9e2b35279780fb708ad0cce39a1d81943be825d041a7b3318bf8691db')

# Use debug
export CARGO_PROFILE_RELEASE_DEBUG=2 CARGO_PROFILE_RELEASE_STRIP=false

# Use LTO
export CARGO_PROFILE_RELEASE_LTO=true CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1

prepare() {
  cd $pkgname
  cargo fetch --locked --target host-tuple
}

build() {
  cd $pkgname
  cargo build --release --frozen
}

package() {
  cd $pkgname
  install -Dt "$pkgdir/usr/bin" target/release/upload-symbols
  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 LICENSE-MIT
}

# vim:set sw=2 sts=-1 et:
