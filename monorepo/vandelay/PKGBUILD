# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=vandelay
pkgver=1.0.12
pkgrel=1
pkgdesc='JMAP importer-exporter & backup tool'
arch=(x86_64)
url='https://github.com/stalwartlabs/vandelay'
license=('Apache-2.0 OR MIT')
depends=(glibc libgcc sqlite)
makedepends=(git rust)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('589433420df353b321f1eb7d9957fab737b7d68961a6dbe832dda231ddf686cebec0515bbbf1ad9cc6f532e1607bf03f3c44dfcdf47892f0f46e1dedb748ac64')
b2sums=('d01eb1a6ad052f169dacebdcafa6a65736c5e786577789af12b72090bfe0475b0b045cbe2573d9f1e91afa606d9fe782e7091c03efbbf621ad992586e7470edd')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  # unbundle sqlite
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1

  # jitterentropy shouldn't be optimized
  export CFLAGS="${CFLAGS/-O2/-O0}"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" "target/release/$pkgname"

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
  cp -vr assets "$pkgdir/usr/share/doc/$pkgname"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSES/*
}
