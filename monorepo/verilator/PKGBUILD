pkgname=verilator
pkgver=5.052
pkgrel=1
pkgdesc='The fastest free Verilog HDL simulator'
url='https://www.veripool.org/verilator/'
arch=('x86_64')
license=('LGPL-3.0-only' 'Artistic-2.0')
depends=('perl' 'python' 'lz4' 'zlib')
optdepends=('systemc')
makedepends=('git' 'help2man' 'systemc')
checkdepends=('python-distro')
source=("git+https://github.com/verilator/verilator.git#tag=v$pkgver")
sha512sums=('172c387455628a528bb668516f519c409bc63c12538be3be9592df7634d5ad9d1456dc73d0a5640b7414a945ff734db8a66827c648929094e88fa379cd043163')

prepare() {
  cd verilator
  autoconf
}

build() {
  cd verilator
  ./configure --prefix=/usr
  make
}

check() {
  cd verilator
  make test
}

package() {
  cd verilator
  make install DESTDIR="$pkgdir"
}
