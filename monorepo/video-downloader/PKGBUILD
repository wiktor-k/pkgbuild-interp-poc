# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=video-downloader
pkgver=0.12.31
pkgrel=2
pkgdesc='GTK application to download videos from websites like YouTube and many others (based on yt-dlp)'
arch=(any)
url='https://github.com/Unrud/video-downloader'
license=(GPL-3.0-or-later)
depends=(
  dconf
  ffmpeg
  gdk-pixbuf2
  glib2
  gtk4
  hicolor-icon-theme
  libadwaita
  python
  python-gobject
  yt-dlp
)
makedepends=(
  git
  meson
)
source=("git+https://github.com/Unrud/video-downloader#tag=v$pkgver")
b2sums=(4cf9aad3fc572489efbf338e6a4384f263382a90cc063336ef45770798929fbcead2f93ca55c8f1bc3df0fe64e5d127016d99075f81df5488206f19a73c86503)

prepare() {
  cd $pkgname
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  python -m compileall -d /usr/share "$pkgdir/usr/share"
  python -O -m compileall -d /usr/share "$pkgdir/usr/share"
}
