# Maintainer: Maxime Gauduin <alucryd@archlinux.org>
# Contributor: Wuxxin <wuxxin@gmail.com>

pkgname=whisper-cpp
pkgver=1.9.5
pkgrel=1
pkgdesc="Port of OpenAI's Whisper model in C/C++"
arch=(x86_64)
url=https://github.com/ggerganov/whisper.cpp
license=(MIT)
depends=(
  ffmpeg
  ggml
  glibc
  libgcc
  libstdc++
)
conflicts=(whisper-cpp)
provides=(whisper-cpp)
replaces=(
  whisper-cpp-rocm
  whisper-cpp-vulkan
)
makedepends=(
  cmake
  git
  ninja
)
source=(git+https://github.com/ggml-org/whisper.cpp.git#tag=v${pkgver})
b2sums=('3cf4a45b6b1544b72cd7c623e206868fc9ee13d2a9608eec4092c896c1755787afbef206c9136d3b41d29c87929b077bdafb39ded96a615699df084b4a3d73b8')

build() {
  cmake -S whisper.cpp -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DWHISPER_COMMON_FFMPEG=ON \
      -DWHISPER_BUILD_EXAMPLES=ON \
      -DWHISPER_BUILD_SERVER=ON \
      -DWHISPER_BUILD_TESTS=OFF \
      -DWHISPER_USE_SYSTEM_GGML=ON
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm 644 whisper.cpp/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}
}
