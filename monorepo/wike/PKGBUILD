# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=wike
pkgver=3.2.1
pkgrel=1
pkgdesc='Wikipedia reader for the GNOME desktop'
arch=(any)
url='https://apps.gnome.org/Wike/'
license=(GPL-3.0-or-later)
groups=(gnome-circle)
depends=(
  dconf
  glib2
  gtk4
  hicolor-icon-theme
  libadwaita
  libsoup3
  pango
  python
  python-gobject
  webkitgtk-6.0
)
makedepends=(
  appstream
  git
  meson
)
source=("git+https://github.com/hugolabe/Wike.git#tag=$pkgver")
b2sums=('ba5ec50ab59dec1ef5e0c93c34bd3c32659648d3551c8701656ff410624044ee3685d81096f8c7bf42ac04d553ceb1fb58a64b46b9b5cbf8aed9008af6c01f08')

prepare() {
  cd Wike
}

build() {
  arch-meson Wike build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  python -m compileall -d /usr/share "$pkgdir/usr/share"
  python -O -m compileall -d /usr/share "$pkgdir/usr/share"
}
