pkgname=wingpanel-indicator-sound
pkgver=8.0.3
pkgrel=2
pkgdesc='Wingpanel Sound Indicator'
arch=(x86_64)
url=https://github.com/elementary/wingpanel-indicator-sound
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  dconf
  gdk-pixbuf2
  glib2
  glibc
  granite7
  gtk4
  libcanberra
  libgee
  libnotify
  libpulse
  wingpanel
)
makedepends=(
  git
  gobject-introspection
  intltool
  meson
  vala
)
source=(wingpanel-indicator-sound::git+https://github.com/elementary/wingpanel-indicator-sound.git#commit=47db6982c74117c6c1a551f2e15ccfd4cda91900)
b2sums=('26ff60837c4c41558f1c51eba61dd099c36f15781c7580092eadc843094ee6ac3b028683152a4ce76df17004ca8113b2c095bdb1bf759fcdb78770e9c8fe8849')

build() {
  arch-meson wingpanel-indicator-sound build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}
