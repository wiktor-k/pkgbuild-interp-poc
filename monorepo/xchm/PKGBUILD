# Maintainer: Balló György <ballogyor+arch at gmail dot com>
# Contributor: Giovanni Scafora <giovanni@archlinux.org>

pkgname=xchm
pkgver=1.40
pkgrel=1
pkgdesc='Viewer for CHM files (GUI front-end to chmlib)'
arch=(x86_64)
url='https://github.com/rzvncj/xCHM'
license=(GPL-2.0-or-later)
depends=(
  chmlib
  glibc
  hicolor-icon-theme
  libgcc
  libstdc++
  wxwidgets-common
  wxwidgets-gtk3
)
makedepends=(git)
source=("git+https://github.com/rzvncj/xCHM.git#tag=$pkgver")
b2sums=(580784a648451f150029fd4613e7b588b09663b38cf6dc907b8cd86c625c14c573f9bbcd26fcf8e1e99b5b4a16acf7531d11c730a2307175ff107de47372fea2)

prepare() {
  cd xCHM
  autoreconf -fiv
}

build() {
  cd xCHM
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd xCHM
  make DESTDIR="$pkgdir" install
}
