# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=xdg-desktop-portal-dde
pkgver=1.1.12
pkgrel=1
pkgdesc='A backend implementation for xdg-desktop-portal on Deepin desktop environment'
arch=('x86_64')
url="https://github.com/linuxdeepin/xdg-desktop-portal-dde"
license=('LGPL-3.0-or-later')
depends=('dtk6core' 'dtk6declarative' 'dtk6widget' 'qt6-base' 'qt6-declarative' 'wayland'
         'glibc' 'libgcc' 'libstdc++' 'libdrm' 'libpipewire' 'mesa' 'xdg-desktop-portal')
makedepends=('git' 'cmake' 'ninja' 'python' 'qt6-tools'
             'treeland-protocols' 'wayland-protocols' 'wlr-protocols')
provides=(xdg-desktop-portal-impl)
groups=('deepin')
source=("git+https://github.com/linuxdeepin/xdg-desktop-portal-dde.git#tag=$pkgver")
sha512sums=('730eaffe4063394e4d698d2b39f2f57c5a63de919b0af95aade94037505b74e33d46949ac3ec3141e7a2fe9cc5196d55240694acef50ca1966fa59d141375ed5')

build() {
  cd xdg-desktop-portal-dde
  cmake . -GNinja -DCMAKE_INSTALL_LIBEXECDIR=lib
  ninja
}

check() {
  cd xdg-desktop-portal-dde
  ctest --output-on-failure
}

package() {
  cd xdg-desktop-portal-dde
  DESTDIR="$pkgdir" ninja install
}
