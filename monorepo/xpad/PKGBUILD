pkgname=xpad
pkgver=6.0.0
pkgrel=1
pkgdesc='Stickies-like notes application'
arch=(x86_64)
url='https://launchpad.net/xpad'
license=(GPL-3.0-or-later)
depends=(
  glib2
  glibc
  gtk3
  gtksourceview4
  hicolor-icon-theme
  libappindicator
  libice
  libsm
  pango
)
source=("https://launchpad.net/$pkgname/trunk/${pkgver%.*}/+download/$pkgname-$pkgver.tar.bz2"{,.asc})
b2sums=(
  593cdc970b984d5f7a83b706a5c08edeab04a6894ee5a2a1542f2bdf5441addd0ea04a689290c13efcfa8e040d84642898bca2a35f3094489a4debd9ccb985d5
  SKIP
)
validpgpkeys=(
  3930646349B9DD3886D9087392BF2FCCA6F2322B
  8450BEE19B722715FFDB18C6683EAA45951FC552
  7FA67C1981CEE3140281AB04108E2CAA625FE5FE
) # Arthur Borsboom <arthurborsboom@gmail.com>

prepare() {
  cd $pkgname-$pkgver

  # Use libappindicator
  sed -i 's/ayatana-appindicator/appindicator/' configure.ac src/xpad-tray.c

  autoreconf -fiv
}

build() {
  cd $pkgname-$pkgver
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd $pkgname-$pkgver
  make DESTDIR="$pkgdir" install
}
