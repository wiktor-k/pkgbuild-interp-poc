pkgname=yq
pkgver=4.4.5
pkgrel=1
pkgdesc="Command-line YAML, XML, TOML processor - jq wrapper for YAML/XML/TOML documents"
arch=('any')
url="https://github.com/kislyuk/yq"
license=(Apache-2.0)
depends=(jq
         python-argcomplete
         python-tomlkit
         python-xmltodict
         python-yaml)
makedepends=(git
             python-{build,installer,wheel}
             python-hatch-vcs
             python-hatchling)
conflicts=(go-yq)
source=("git+https://github.com/kislyuk/yq.git#tag=v$pkgver")
sha256sums=('6141aa8fc3a36e60ed0ec07abef19f8c8c2c9d38876b5a40cf31ed30e0d314b3')
b2sums=('99902e2f1b1b036c440364b9fed2162dba09a21252f22c71fc3eedf5b98002f2d986026c5c3a624b7ca83365ff8ade3cd322ee1b773a5e6f06b8b64f3384e85f')

build() {
  cd $pkgname
  python -m build -wn
}

check() {
  cd $pkgname
  python test/test.py
}

package() {
  cd $pkgname
  python -m installer -d "$pkgdir" dist/*.whl
}
