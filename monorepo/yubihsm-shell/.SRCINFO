pkgname = libyubihsm
	pkgdesc = C library to expose low- and high-level functions to interact with a YubiHSM
	depends = curl
	depends = libcurl.so
	depends = glibc
	depends = openssl
	depends = libcrypto.so
	depends = libusb
	depends = libusb-1.0.so
	depends = zlib
	depends = libz.so
	optdepends = yubihsm-udev-rules: for accessing YubiHSM2 devices over USB using the _yubihsm2 group membership
	provides = libyubihsm.so

pkgname = libykhsmauth
	pkgdesc = C library for using the YubiKey HSM Auth application
	depends = glibc
	depends = pcsclite
	depends = libpcsclite.so
	depends = openssl
	provides = libykhsmauth.so

pkgname = yubihsm-auth
	pkgdesc = Command-line tool to use the YubiKey HSM Auth application
	depends = glibc
	depends = libykhsmauth
	depends = libykhsmauth.so
	depends = openssl
	depends = libcrypto.so

pkgname = yubihsm-pkcs11
	pkgdesc = PKCS#11 module using libyubihsm
	depends = glibc
	depends = libykhsmauth
	depends = libykhsmauth.so
	depends = libyubihsm
	depends = libyubihsm.so
	depends = openssl
	depends = libcrypto.so
	optdepends = yubihsm-udev-rules: for accessing YubiHSM2 devices over USB using the _yubihsm2 group membership

pkgname = yubihsm-shell
	pkgdesc = Interactive and command-line interface to a YubiHSM
	depends = glibc
	depends = libedit
	depends = libedit.so
	depends = libykhsmauth
	depends = libykhsmauth.so
	depends = libyubihsm
	depends = libyubihsm.so
	depends = openssl
	depends = libcrypto.so
	optdepends = yubihsm-udev-rules: for accessing YubiHSM2 devices over USB using the _yubihsm2 group membership

pkgname = yubihsm-wrap
	pkgdesc = Command-line tool to create encrypted objects (wraps) that can be imported in the YubiHSM
	depends = glibc
	depends = libyubihsm
	depends = libyubihsm.so
	depends = openssl
	depends = libcrypto.so
	optdepends = yubihsm-udev-rules: for accessing YubiHSM2 devices over USB using the _yubihsm2 group membership
