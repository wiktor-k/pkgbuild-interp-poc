# Contributor: BrLi <brli at chakralinux dot org>
# Contributor: loqs <bugs-archlinux@entropy-collector.net>

pkgname=zettlr
_pkgname=${pkgname^}
pkgver=4.8.0
pkgrel=1
pkgdesc='A Markdown Editor for the 21st century'
arch=(x86_64)
url=https://www.zettlr.com
_url="https://github.com/$_pkgname/$_pkgname"
license=(GPL-3.0-only)
_electron=electron43
depends=(crimson-font
         "$_electron"
         pandoc-cli
         ttf-inconsolata
         ttf-liberation)
makedepends=(corepack
             gendesk
             git
             jq
             nodejs-lts-jod # grep NODE_VERSION: .github/workflows/build.yml
             node-gyp
             npm)
optdepends=('texlive-latex: For Latex support')
_archive="$_pkgname-$pkgver"
source=("$_url/archive/v$pkgver/$_archive.tar.gz"
        "$pkgname.sh"
        "$pkgname.xml")
sha256sums=('89ef42aadf2e26c4b634a2a78b25b39729db775884119b2abfbaa6358b4584f3'
            'e300f2cac217f98ab5c365dccc7581410bc296f2842d52f7f1520dd6679d20cf'
            'c3ecbb490a1d4fa5bc42f7166cc375e5629a452d25bb1d4facb5541938681292')

prepare() {
	local commit=$(zcat ${source[0]##*/} | git get-tar-commit-id)
	gendesk -q -f -n \
		--pkgname "$pkgname" \
		--pkgdesc "$pkgdesc" \
		--name "$_pkgname" \
		--categories 'Office' \
		--mimetypes 'text/markdown'
	cd "$_archive"
	mkdir bin
	corepack enable --install-directory bin yarn
	COREPACK_ENABLE_DOWNLOAD_PROMPT=0 bin/yarn install
	local _electronVersion="$(cat /usr/lib/$_electron/version)"
	readarray -t _oldElectron <  <(bin/yarn info --cache --json 'electron' | jq -r '.children | .Version,.Cache.Checksum')
	sed -i -e '/get-git-hash/d' -e "/GIT_COMMIT_HASH/s/await getGitHash()/\"$commit\"/" forge.config.js
	sed -i "/${_oldElectron[1]:3}/d" yarn.lock
	sed -i "s/\([\^ :]\)${_oldElectron[0]}/\1$_electronVersion/" package.json yarn.lock
	sed -e "s/@ELECTRON@/$_electron/" "../${source[1]}" > $pkgname.sh
	npm pkg set desktopName="$pkgname"
	bin/yarn install --immutable # postinstall script installs electron-builder deps
}

build() {
	cd "$_archive"
	local NODE_ENV=''
	export ZETTLR_DISABLE_UPDATE_CHECK=1
	export BUNDLE_PANDOC=0
	# electron-forge target differs by arch; derive from $CARCH (x86_64 unchanged).
	local _yarn_target=linux-x64
	[[ "$CARCH" == aarch64 ]] && _yarn_target=linux-arm
	bin/yarn package:$_yarn_target
}

package() {
	install -Dm0644 -t "$pkgdir/usr/share/applications/" "$pkgname.desktop"
	cd "$_archive"
	install -Dm0755 "$pkgname.sh" "$pkgdir/usr/bin/$pkgname"
	local _destdir="usr/lib/$pkgname"
	# electron-forge names the output dir linux-x64 on x86_64, linux-arm64 on aarch64
	local _outarch=x64
	[[ "$CARCH" == aarch64 ]] && _outarch=arm64
	install -Dm0644 -t "$pkgdir/$_destdir/" "out/$_pkgname-linux-$_outarch/resources/app.asar"
	cp -a "out/$_pkgname-linux-$_outarch/resources/app.asar.unpacked" "$pkgdir/$_destdir/"
	for px in 16 24 32 48 64 96 128 256 512 1024; do
		install -Dm0644 "resources/icons/png/${px}x${px}.png" \
			"$pkgdir/usr/share/icons/hicolor/${px}x${px}/apps/$pkgname.png"
	done
	install -Dm0644 -t "$pkgdir/usr/share/mime/packages/" "../${source[2]}"
}
